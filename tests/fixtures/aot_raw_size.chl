/** 公开布局查询为常量，并与原始存储的实际元素步长一致。 */
struct LayoutPair { uint8 first; int64 second; };
struct LayoutNested { LayoutPair pair; int64 values[3]; String label; };
enum LayoutChoice { Empty, Value(int64 value), Pair(LayoutPair value) };

void checkLayout<T>() {
    int64 size = std::lang::rawSize<T>();
    assert(size > 0);
    RawStorage<T> storage = RawStorage<T>::allocate(2);
    unsafe {
        BarePtr<T> first = barePointer<T>(storage.pointer(0));
        BarePtr<T> second = barePointer<T>(storage.pointer(1));
        assert(second.address - first.address == size);
    }
    storage.close();
}

#export("raw_size_int64")
int64 fixedSize() { return std::lang::rawSize<int64>(); }

void main() {
    assert(rawSize<uint8>() == 1 && std::lang::rawSize<int64>() == 8);
    assert(rawSize<int8>() == 8 && rawSize<bool>() == 8 && rawSize<char>() == 1);
    assert(rawSize<float32>() == 8 && rawSize<float64>() == 8);
    assert(rawSize<String>() == 8 && rawSize<List<int64>>() == 8);
    assert(rawSize<LayoutPair>() == 16);
    checkLayout<uint8>(); checkLayout<int64>(); checkLayout<String>();
    checkLayout<LayoutPair>(); checkLayout<LayoutNested>(); checkLayout<LayoutChoice>();
    checkLayout<Option<uint8>>();
    assert(fixedSize() == 8);
    println("rawSize constants and storage strides OK");
}
