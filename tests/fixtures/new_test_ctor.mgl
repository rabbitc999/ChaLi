/* 新语法糖：new T(实参);  ≡ new(实参);（显式写出构造类型 T）。 */
struct Point {
    int64 x;
    int64 y;
    Point(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
    static Point new(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
};

int64 main() {
    Point mut& p = new Point(9, 10);   /* 糖2：new T(args)  ≡ new(args) */
    assert(p.x == 9 && p.y == 10);
    println("new_test_ctor ok: {} {}", p.x, p.y);
    return 0;
}
