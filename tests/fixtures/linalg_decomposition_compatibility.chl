import std::linear_algebra;
import std::core;
void near(float64 actual,float64 expected) {
    float64 difference=actual-expected;
    if(difference<0.0){difference=-difference;}
    assert(difference<0.000001,"matrix reconstruction mismatch");
}
void equalMatrix(std::linear_algebra::Matrix<float64> const& left,std::linear_algebra::Matrix<float64> const& right) {
    assert(left.rows==right.rows && left.cols==right.cols);
    int64 i=0;
    while(i<left.rows){int64 j=0;while(j<left.cols){near(left.at(i,j),right.at(i,j));j=j+1;}i=i+1;}
}
void main(){
    let a=std::linear_algebra::Matrix<float64>::zeros(2,2);
    a.set(0,0,4.0);a.set(0,1,1.0);a.set(1,0,1.0);a.set(1,1,3.0);
    let lu=std::linear_algebra::luDecompose(a);
    let pa=lu.permutation.multiply(a);let product=lu.lower.multiply(lu.upper);equalMatrix(&pa,&product);
    let lur=std::linear_algebra::lurDecompose(a);
    let lpa=lur.permutation.multiply(a);let lproduct=lur.lower.multiply(lur.upper);equalMatrix(&lpa,&lproduct);
    let eigen=std::linear_algebra::symmetricEigen(a);
    let diagonal=std::linear_algebra::Matrix<float64>::zeros(2,2);
    diagonal.set(0,0,eigen.eigenvalues.at(0));diagonal.set(1,1,eigen.eigenvalues.at(1));
    let ev=eigen.eigenvectors.multiply(diagonal);let vt=eigen.eigenvectors.transpose();let reconstructed=ev.multiply(vt);equalMatrix(&a,&reconstructed);
    let svd=std::linear_algebra::svd(a);
    let sigma=std::linear_algebra::Matrix<float64>::zeros(2,2);
    sigma.set(0,0,svd.singularValues.at(0));sigma.set(1,1,svd.singularValues.at(1));
    let us=svd.u.multiply(sigma);let svdResult=us.multiply(svd.vTranspose);equalMatrix(&a,&svdResult);
    let jordan=std::linear_algebra::jordan2(a);
    let ab=a.multiply(jordan.basis);let bj=jordan.basis.multiply(jordan.jordan);equalMatrix(&ab,&bj);
    let diag=std::linear_algebra::diagonalize2(a);
    let adb=a.multiply(diag.basis);let dbj=diag.basis.multiply(diag.jordan);equalMatrix(&adb,&dbj);
    let copy=lu;
    lu.lower.set(0,0,9.0);near(copy.lower.at(0,0),1.0);near(a.at(0,0),4.0);
    let rhs=std::linear_algebra::Vector<float64>::zeros(2);rhs.set(0,9.0);rhs.set(1,7.0);
    let answer=a.solve(rhs);near(answer.at(0),20.0/11.0);near(answer.at(1),19.0/11.0);
    println("six decompositions, reconstruction, solve and independent ownership OK");
}

