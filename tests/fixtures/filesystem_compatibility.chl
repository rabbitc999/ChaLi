import std::io;
import std::datetime;
void main() {
    String root = __ROOT__;
    assert(createDirectories(root).isOk());
    assert(createDirectories(root).isOk());
    assert(createDirectories(root + "/nested/child").isOk());
    assert(listDirectory(root + "/nested/child").unwrap().len() == 0);
    assert(fileInfo(root + "/a.txt").unwrap().size == 1);
    assert(fileInfo(root + "/z.txt").unwrap().size == 3);
    assert(fileInfo(root + "/中文 file.txt").unwrap().size == 7);
    List<String> paths = listDirectory(root).unwrap();
    assert(paths.len() == 5);
    assert(paths[0] == root + "/a.txt");
    assert(paths[1] == root + "/nested");
    assert(paths[2] == root + "/stamp.txt");
    assert(paths[3] == root + "/z.txt");
    assert(paths[4] == root + "/中文 file.txt");
    let copy = paths;
    paths.clear();
    assert(copy.len() == 5 && copy[4] == root + "/中文 file.txt");
    let independent = copy;
    copy[0] = "changed";
    assert(independent[0] == root + "/a.txt");
    FileInfo file = fileInfo(root + "/z.txt").unwrap();
    assert(file.size == 3 && file.isFile && !file.isDirectory);
    FileInfo directory = fileInfo(root + "/nested").unwrap();
    assert(directory.size == 0 && !directory.isFile && directory.isDirectory);
    FileInfo stamp = fileInfo(root + "/stamp.txt").unwrap();
    assert(stamp.modifiedUnixSeconds >= 946684799 && stamp.modifiedUnixSeconds <= 946684801);
    int64 now = std::datetime::__utcNow();
    assert(now > 946684800 && file.modifiedUnixSeconds <= now + 2);
    assert(renamePath(root + "/z.txt", root + "/renamed.txt").isOk());
    assert(fileInfo(root + "/z.txt").isErr());
    assert(fileInfo(root + "/renamed.txt").unwrap().size == 3);
    assert(listDirectory(root + "/missing").isErr());
    assert(listDirectory(root + "/a.txt").isErr());
    assert(createDirectories(root + "/a.txt/child").isErr());
    assert(renamePath(root + "/missing", root + "/other").isErr());
    assert(renamePath(root + "/a.txt", root + "/nested").isErr());
    println("filesystem paths, metadata, copies and errors OK");
}
