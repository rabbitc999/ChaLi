/* 结构体综合用法（验收样例 5）：字段、构造函数、工厂、方法，以及新旧写法混用。 */
struct Point {
    int64 x;
    int64 y;
    Point(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
    static Point new(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
    int64 manhattan() {
        return self.x + self.y;
    }
};

int64 main() {
    Point mut& a = new(3, 4);                 /* 旧：按目标类型构造 */
    Point mut& b = heap Point;                /* 糖1：heap T  ≡ new; */
    b.x = 1;
    b.y = 2;
    Point mut& c = new Point(5, 6);           /* 糖2：new T(args)  ≡ new(args) */
    Point mut& d = heap new Point(7, 8);      /* 糖3：heap new T(args)  ≡ new(args) */
    Point e = Point::new(9, 10);              /* 旧：工厂返回普通值 */
    Point f = new(11, 12);                    /* 旧：构造函数返回值 */

    assert(a.manhattan() == 7);
    assert(b.manhattan() == 3);
    assert(c.manhattan() == 11);
    assert(d.manhattan() == 15);
    assert(e.manhattan() == 19);
    assert(f.manhattan() == 23);

    println("struct_usage ok: {} {} {} {} {} {}", a.x, b.y, c.x, d.y, e.x, f.x);
    return 0;
}
