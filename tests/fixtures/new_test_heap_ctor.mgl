/* 新语法糖：heap new T(实参);  ≡ new(实参);（堆上构造，左值为 T mut& 时即堆构造）。 */
struct Point {
    int64 x;
    int64 y;
    Point(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
    static Point new(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
};

int64 main() {
    Point mut& p = heap new Point(11, 12);   /* 糖3：heap new T(args)  ≡ new(args) */
    assert(p.x == 11 && p.y == 12);
    println("new_test_heap_ctor ok: {} {}", p.x, p.y);
    return 0;
}
