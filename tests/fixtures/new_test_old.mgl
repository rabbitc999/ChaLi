/* 旧写法全部仍合法（验收样例 1）：new(实参) / new; / T::new(实参) 三种原有形式。 */
struct Point {
    int64 x;
    int64 y;
    Point(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
    static Point new(int64 x, int64 y) {
        self.x = x;
        self.y = y;
    }
};

int64 main() {
    Point mut& p = new(3, 4);          /* 旧：按目标类型的构造函数 */
    assert(p.x == 3 && p.y == 4);
    Point mut& q = new;                /* 旧：堆上分配单个对象（不调构造） */
    q.x = 10;
    q.y = 20;
    assert(q.x == 10 && q.y == 20);
    Point r = Point::new(5, 6);        /* 旧：static T new(...) 工厂 */
    assert(r.x == 5 && r.y == 6);
    println("new_test_old ok: {} {} {} {}", p.x, p.y, q.x, q.y);
    return 0;
}
