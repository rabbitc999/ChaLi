module std::binary;

/** 先除后乘验证完整范围，读取失败时调用方尚未推进游标。 */
inline void __checkRange(int64 size, int64 offset, int64 count, int64 width) {
    if (offset < 0 || count < 0) { std::core::__runtimeFail("二进制读取：偏移和长度必须非负"); }
    if (offset > size || (width != 0 && count > (size - offset) / width)) {
        std::core::__runtimeFail("二进制读取：数据不足");
    }
}

/** 按显式字节序组合有效位，不依赖宿主的内存字节序。 */
inline uint64 __readBits(List<uint8> const& bytes, int64 offset, int64 width, bool bigEndian) {
    __checkRange(bytes.len(), offset, 1, width);
    uint64 bits = 0;
    int64 index = 0;
    while (index < width) {
        int64 at = offset + index;
        if (!bigEndian) { at = offset + width - 1 - index; }
        bits = (bits << 8) | (uint64)bytes[at];
        index = index + 1;
    }
    return bits;
}

/** 按目标位宽读取 int8，保留字节序及位模式。 */
inline int8 __readInt8(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (int8)__readBits(bytes, offset, 1, bigEndian);
}

/** 按目标位宽读取 uint8，保留字节序及位模式。 */
inline uint8 __readUint8(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (uint8)__readBits(bytes, offset, 1, bigEndian);
}

/** 按目标位宽读取 int16，保留字节序及位模式。 */
inline int16 __readInt16(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (int16)__readBits(bytes, offset, 2, bigEndian);
}

/** 按目标位宽读取 uint16，保留字节序及位模式。 */
inline uint16 __readUint16(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (uint16)__readBits(bytes, offset, 2, bigEndian);
}

/** 按目标位宽读取 int32，保留字节序及位模式。 */
inline int32 __readInt32(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (int32)__readBits(bytes, offset, 4, bigEndian);
}

/** 按目标位宽读取 uint32，保留字节序及位模式。 */
inline uint32 __readUint32(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (uint32)__readBits(bytes, offset, 4, bigEndian);
}

/** 按目标位宽读取 int64，保留字节序及位模式。 */
inline int64 __readInt64(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (int64)__readBits(bytes, offset, 8, bigEndian);
}

/** 按目标位宽读取 uint64，保留字节序及位模式。 */
inline uint64 __readUint64(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return (uint64)__readBits(bytes, offset, 8, bigEndian);
}

/** 按目标位宽读取 float32，保留字节序及位模式。 */
inline float32 __readFloat32(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return std::core::__bootFloat32FromBits(__readBits(bytes, offset, 4, bigEndian));
}

/** 按目标位宽读取 float64，保留字节序及位模式。 */
inline float64 __readFloat64(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    return std::core::__bootFloat64FromBits(__readBits(bytes, offset, 8, bigEndian));
}

/** 按目标位宽读取 bool，保留字节序及位模式。 */
inline bool __readBool(List<uint8> const& bytes, int64 offset, bool bigEndian) {
    uint64 value = __readBits(bytes, offset, 1, bigEndian);
    if (value > 1) { std::core::__runtimeFail("二进制读取：bool 字节必须为 0 或 1"); }
    return value != 0;
}

/** 复用声明宏生成各基础数值类型的独立数组读取函数。 */
$macro __binaryArray<T>(name:ident, scalar:ident, width:expr) -> item
List<T> name(List<uint8> const& bytes, int64 offset, int64 count, bool bigEndian) {
    __checkRange(bytes.len(), offset, count, width);
    List<T> result;
    int64 index = 0;
    while (index < count) {
        result.push(scalar(bytes, offset + index * width, bigEndian));
        index = index + 1;
    }
    return result;
}
$end_macro

$__binaryArray<int8>(__readInt8Array, __readInt8, 1);
$__binaryArray<uint8>(__readUint8Array, __readUint8, 1);
$__binaryArray<int16>(__readInt16Array, __readInt16, 2);
$__binaryArray<uint16>(__readUint16Array, __readUint16, 2);
$__binaryArray<int32>(__readInt32Array, __readInt32, 4);
$__binaryArray<uint32>(__readUint32Array, __readUint32, 4);
$__binaryArray<int64>(__readInt64Array, __readInt64, 8);
$__binaryArray<uint64>(__readUint64Array, __readUint64, 8);
$__binaryArray<float32>(__readFloat32Array, __readFloat32, 4);
$__binaryArray<float64>(__readFloat64Array, __readFloat64, 8);
$__binaryArray<bool>(__readBoolArray, __readBool, 1);

/** 从定宽字段构造独立原始字节串；首个零字节后的内容属于填充。 */
inline String __readString(List<uint8> const& bytes, int64 offset, int64 length) {
    __checkRange(bytes.len(), offset, length, 1);
    int64 size = 0;
    while (size < length && bytes[offset + size] != 0) { size = size + 1; }
    unsafe {
        int64 buffer = std::core::__bootStringBuffer(size);
        BarePtr<uint8> output = pointerFromAddress<uint8>(std::core::__bootStringOwnedData(buffer));
        int64 index = 0;
        while (index < size) {
            uint8 mut& slot = dereference<uint8>(output + index);
            *slot = bytes[offset + index];
            index = index + 1;
        }
        return std::core::__stringAdopt(buffer);
    }
}

/** 在创建结果前验证全部定宽字段范围，包含零宽字段。 */
inline List<String> __readStrings(List<uint8> const& bytes, int64 offset, int64 count, int64 width) {
    if (width < 0) { std::core::__runtimeFail("二进制读取：偏移和长度必须非负"); }
    __checkRange(bytes.len(), offset, count, width);
    List<String> result;
    int64 index = 0;
    while (index < count) {
        result.push(__readString(bytes, offset + index * width, width));
        index = index + 1;
    }
    return result;
}

/** 从调用方的有效数组借用复制字节，结果独立拥有存储。 */
inline List<uint8> __fromArray(uint8 const& bytes, int64 count) {
    if (count < 0) { std::core::__runtimeFail("二进制读取：数组长度或地址无效"); }
    int64 location = (int64)std::core::address(bytes);
    if (location < 0 || (count > 0 && location == 0) || location > 9223372036854775807 - count) {
        std::core::__runtimeFail("二进制读取：数组长度或地址无效");
    }
    List<uint8> result;
    int64 index = 0;
    while (index < count) {
        result.push(std::core::index(bytes, index));
        index = index + 1;
    }
    return result;
}

/** 二进制流读取器：拥有输入字节的副本，默认小端。 */
struct BinaryReader : Drop {
    List<uint8> bytes;
    int64 offset;
    bool bigEndian;

    void drop() { self.bytes.drop(); }
    /** 从字节列表复制；不依赖原列表的生命周期。 */
    static BinaryReader fromBytes(List<uint8> bytes) {
        BinaryReader reader;
        reader.bytes = bytes.copy();
        reader.offset = 0;
        reader.bigEndian = false;
        return reader;
    }
    /** 从固定数组或指针复制 count 个字节。 */
    static BinaryReader fromArray(uint8 const& bytes, int64 count) {
        BinaryReader reader;
        reader.bytes = __fromArray(bytes, count);
        reader.offset = 0;
        reader.bigEndian = false;
        return reader;
    }
    /** 从运行时数组复制全部字节。 */
    static BinaryReader fromArray(uint8 bytes[]) { return BinaryReader::fromArray(bytes, len(bytes)); }
    int64 position() { return self.offset; }
    int64 remaining() { return self.bytes.len() - self.offset; }
    int64 size() { return self.bytes.len(); }
    void setBigEndian(bool enabled) { self.bigEndian = enabled; }
    /** 绝对定位，失败返回 false 并保留游标。 */
    bool seek(int64 position) {
        if (position < 0 || position > self.bytes.len()) { return false; }
        self.offset = position;
        return true;
    }
    /** 跳过字节，失败返回 false 并保留游标。 */
    bool skip(int64 count) {
        if (count < 0 || count > self.remaining()) { return false; }
        self.offset = self.offset + count;
        return true;
    }
    /** 读取一个 int8，成功后前进 1 字节。 */
    int8 readInt8() {
        int8 value = __readInt8(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 1;
        return value;
    }
    /** 读取 count 个 int8，返回独立列表。 */
    List<int8> readInt8Array(int64 count) {
        List<int8> values = __readInt8Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 1;
        return values;
    }
    /** 读取一个 uint8，成功后前进 1 字节。 */
    uint8 readUint8() {
        uint8 value = __readUint8(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 1;
        return value;
    }
    /** 读取 count 个 uint8，返回独立列表。 */
    List<uint8> readUint8Array(int64 count) {
        List<uint8> values = __readUint8Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 1;
        return values;
    }
    /** 读取一个 int16，成功后前进 2 字节。 */
    int16 readInt16() {
        int16 value = __readInt16(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 2;
        return value;
    }
    /** 读取 count 个 int16，返回独立列表。 */
    List<int16> readInt16Array(int64 count) {
        List<int16> values = __readInt16Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 2;
        return values;
    }
    /** 读取一个 uint16，成功后前进 2 字节。 */
    uint16 readUint16() {
        uint16 value = __readUint16(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 2;
        return value;
    }
    /** 读取 count 个 uint16，返回独立列表。 */
    List<uint16> readUint16Array(int64 count) {
        List<uint16> values = __readUint16Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 2;
        return values;
    }
    /** 读取一个 int32，成功后前进 4 字节。 */
    int32 readInt32() {
        int32 value = __readInt32(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 4;
        return value;
    }
    /** 读取 count 个 int32，返回独立列表。 */
    List<int32> readInt32Array(int64 count) {
        List<int32> values = __readInt32Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 4;
        return values;
    }
    /** 读取一个 uint32，成功后前进 4 字节。 */
    uint32 readUint32() {
        uint32 value = __readUint32(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 4;
        return value;
    }
    /** 读取 count 个 uint32，返回独立列表。 */
    List<uint32> readUint32Array(int64 count) {
        List<uint32> values = __readUint32Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 4;
        return values;
    }
    /** 读取一个 int64，成功后前进 8 字节。 */
    int64 readInt64() {
        int64 value = __readInt64(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 8;
        return value;
    }
    /** 读取 count 个 int64，返回独立列表。 */
    List<int64> readInt64Array(int64 count) {
        List<int64> values = __readInt64Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 8;
        return values;
    }
    /** 读取一个 uint64，成功后前进 8 字节。 */
    uint64 readUint64() {
        uint64 value = __readUint64(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 8;
        return value;
    }
    /** 读取 count 个 uint64，返回独立列表。 */
    List<uint64> readUint64Array(int64 count) {
        List<uint64> values = __readUint64Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 8;
        return values;
    }
    /** 读取一个 float32，成功后前进 4 字节。 */
    float32 readFloat32() {
        float32 value = __readFloat32(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 4;
        return value;
    }
    /** 读取 count 个 float32，返回独立列表。 */
    List<float32> readFloat32Array(int64 count) {
        List<float32> values = __readFloat32Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 4;
        return values;
    }
    /** 读取一个 float64，成功后前进 8 字节。 */
    float64 readFloat64() {
        float64 value = __readFloat64(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 8;
        return value;
    }
    /** 读取 count 个 float64，返回独立列表。 */
    List<float64> readFloat64Array(int64 count) {
        List<float64> values = __readFloat64Array(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 8;
        return values;
    }
    /** 读取一个 bool，成功后前进 1 字节。 */
    bool readBool() {
        bool value = __readBool(&self.bytes, self.offset, self.bigEndian);
        self.offset = self.offset + 1;
        return value;
    }
    /** 读取 count 个 bool，返回独立列表。 */
    List<bool> readBoolArray(int64 count) {
        List<bool> values = __readBoolArray(&self.bytes, self.offset, count, self.bigEndian);
        self.offset = self.offset + count * 1;
        return values;
    }
    /** 读取原始字节，保留零字节。 */
    List<uint8> readBytes(int64 count) { return self.readUint8Array(count); }
    /** 读取 length 字节文本字段，首个零字节终止文本，仍消费整个字段。 */
    String readString(int64 length) {
        String text = __readString(&self.bytes, self.offset, length);
        self.offset = self.offset + length;
        return text;
    }
    /** 读取 count 个定宽字符串，每个字段占 width 字节。 */
    List<String> readStringArray(int64 count, int64 width) {
        List<String> values = __readStrings(&self.bytes, self.offset, count, width);
        self.offset = self.offset + count * width;
        return values;
    }
};
