module std::math;

/* 从编译器的注入正文里搬出来：以前每次编译都会拼进来，现在要 `import std::math;` 才可见。
 * 宿主绑定（sin/cos/… 的桌面默认实现）在 glue/std_math.hpp，键名已改成 std::math::*。 */

/* 编译器提供只读 float64 常数 std::lang::Math::PI 与 std::lang::Math::E。 */
float64 sin(float64 value);
float64 cos(float64 value);
float64 tan(float64 value);
float64 asin(float64 value);
float64 acos(float64 value);
float64 atan(float64 value);
float64 exp(float64 value);
float64 ln(float64 value);
float64 log10(float64 value);
float64 pow(float64 value, float64 exponent);
float64 sqrt(float64 value);
/* 重载只保留类型选择；运算由 std_math.hpp 胶水实现。 */
float64 __absFloat64(float64 value);
float64 abs(float64 value) { return __absFloat64(value); }
float64 floor(float64 value);
float64 ceil(float64 value);
float64 round(float64 value);
float64 trunc(float64 value);
float64 fmod(float64 value, float64 divisor);
bool isNaN(float64 value);
bool isInf(float64 value);

/* int64 实参优先选择 int64 重载。 */
int64 __absInt64(int64 value);
int64 abs(int64 value) { return __absInt64(value); }

int64 __minInt64(int64 left, int64 right);
int64 min(int64 left, int64 right) { return __minInt64(left, right); }

int64 __maxInt64(int64 left, int64 right);
int64 max(int64 left, int64 right) { return __maxInt64(left, right); }

/** 把 `value` 夹进 `[low, high]`；`low > high` 直接停机（多半是写反了）。 */
int64 __clampInt64(int64 value, int64 low, int64 high);
int64 clamp(int64 value, int64 low, int64 high) { return __clampInt64(value, low, high); }

/* float64 重载保留原有比较与 NaN 语义。 */
float64 __minFloat64(float64 left, float64 right);
float64 min(float64 left, float64 right) { return __minFloat64(left, right); }

float64 __maxFloat64(float64 left, float64 right);
float64 max(float64 left, float64 right) { return __maxFloat64(left, right); }

float64 __clampFloat64(float64 value, float64 low, float64 high);
float64 clamp(float64 value, float64 low, float64 high) { return __clampFloat64(value, low, high); }
