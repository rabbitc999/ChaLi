module std::collections;

/* 标准集合模块：import std::collections; 后使用 std::collections::Deque 等类型。 */

/** 两端栈失衡时搬移约一半元素，保持双端操作的摊还常数成本。 */
void __balanceDeque<T>(List<T> mut& source,List<T> mut& destination){
    int64 keep=source.len()/2;List<T> temporary;
    while(source.len()>keep){temporary.push(source.pop());}
    while(source.len()>0){destination.push(source.pop());}
    if(destination.len()==0 && temporary.len()>0){destination.push(temporary.pop());}
    while(temporary.len()>0){source.push(temporary.pop());}
}

/** 两个相反方向的栈组成的双端队列，避免首部删除时整体平移。 */
struct Deque<T>: Iterator<T>, Index<T,int64>, Drop {
    List<T> values;List<T> __front;
    /** 创建空双端队列。 */
    static Deque<T> create() { }
    /** 在队尾接管一个参数值。 */
    void pushBack(T value){self.values.push(move(value));}
    /** 在队首接管一个参数值。 */
    void pushFront(T value){self.__front.push(move(value));}
    /** 弹出队尾，必要时分摊搬移另一端的一半元素。 */
    Option<T> popBack(){if(self.values.len()==0){__balanceDeque(&self.__front,&self.values);}if(self.values.len()==0){return Option<T>::None;}return Option<T>::Value(self.values.pop());}
    /** 弹出队首，必要时分摊搬移另一端的一半元素。 */
    Option<T> popFront(){if(self.__front.len()==0){__balanceDeque(&self.values,&self.__front);}if(self.__front.len()==0){return Option<T>::None;}return Option<T>::Value(self.__front.pop());}
    /** 按队首为零的逻辑下标读取独立值。 */
    T index(int64 key){assert(key>=0 && key<self.len(),"Deque 下标越界");if(key<self.__front.len()){return self.__front.at(self.__front.len()-1-key);}return self.values.at(key-self.__front.len());}
    /** 按队首到队尾迭代。 */
    Option<T> iterator(int64 index){if(index<0 || index>=self.len()){return Option<T>::None;}return Option<T>::Value(self.index(index));}
    /** 返回元素数。 */
    int64 len(){return self.__front.len()+self.values.len();}
    /** 判断是否为空。 */
    bool isEmpty(){return self.len()==0;}
    /** 清除两端的有效元素。 */
    void clear(){self.__front.clear();self.values.clear();}
    /** 释放两个拥有数组。 */
    void drop(){self.__front.drop();self.values.drop();}
};

/** 两栈队列；每个元素至多在队尾到队首之间搬移一次。 */
struct Queue<T>: Iterator<T>, Drop {
    List<T> values;List<T> __front;
    /** 创建空队列。 */
    static Queue<T> create() { }
    /** 在队尾追加一个值。 */
    void push(T value){self.values.push(move(value));}
    /** 队首栈为空时反转队尾栈的元素顺序。 */
    void __prepare(){if(self.__front.len()==0){while(self.values.len()>0){self.__front.push(self.values.pop());}}}
    /** 弹出队首，空队列返回 None。 */
    Option<T> pop(){self.__prepare();if(self.__front.len()==0){return Option<T>::None;}return Option<T>::Value(self.__front.pop());}
    /** 读取队首的独立值。 */
    Option<T> peek(){if(self.__front.len()>0){return Option<T>::Value(self.__front.at(self.__front.len()-1));}if(self.values.len()>0){return Option<T>::Value(self.values.at(0));}return Option<T>::None;}
    /** 按先进先出顺序迭代。 */
    Option<T> iterator(int64 index){if(index<0 || index>=self.len()){return Option<T>::None;}if(index<self.__front.len()){return Option<T>::Value(self.__front.at(self.__front.len()-1-index));}return Option<T>::Value(self.values.at(index-self.__front.len()));}
    /** 返回有效元素数。 */
    int64 len(){return self.__front.len()+self.values.len();}
    /** 判断是否为空。 */
    bool isEmpty(){return self.len()==0;}
    /** 清空队列。 */
    void clear(){self.__front.clear();self.values.clear();}
    /** 释放两个拥有数组。 */
    void drop(){self.__front.drop();self.values.drop();}
};

/** ChaLi 后进先出栈，迭代顺序为栈顶到栈底。 */
struct Stack<T>: Iterator<T>, Drop {
    List<T> values;
    /** 创建空栈。 */
    static Stack<T> create() { }
    /** 接管参数值并追加到栈顶。 */
    void push(T value){self.values.push(move(value));}
    /** 弹出栈顶，空栈返回 None。 */
    Option<T> pop(){if(self.values.len()==0){return Option<T>::None;}return Option<T>::Value(self.values.pop());}
    /** 读取栈顶的独立副本。 */
    Option<T> peek(){if(self.values.len()==0){return Option<T>::None;}return Option<T>::Value(self.values.at(self.values.len()-1));}
    /** 从栈顶开始迭代。 */
    Option<T> iterator(int64 index){if(index<0 || index>=self.values.len()){return Option<T>::None;}return Option<T>::Value(self.values.at(self.values.len()-1-index));}
    /** 返回元素数。 */
    int64 len(){return self.values.len();}
    /** 判断是否为空。 */
    bool isEmpty(){return self.values.len()==0;}
    /** 清空所有有效元素。 */
    void clear(){self.values.clear();}
    /** 释放拥有的数组。 */
    void drop(){self.values.drop();}
};

/** 容量固定的 FIFO 缓冲，满时拒绝写入，循环消费不平移整个数组。 */
struct RingBuffer<T>: Iterator<T>, Drop {
    Deque<T> values;int64 capacity;
    /** 创建非零容量缓冲。 */
    static RingBuffer<T> withCapacity(int64 capacity){assert(capacity>0);RingBuffer<T> result;result.capacity=capacity;return result;}
    /** 未满时在队尾插入，满时返回 false。 */
    bool push(T value){if(self.values.len()>=self.capacity){return false;}self.values.pushBack(move(value));return true;}
    /** 从队首弹出值。 */
    Option<T> pop(){return self.values.popFront();}
    /** 按先进先出顺序迭代。 */
    Option<T> iterator(int64 index){return self.values.iterator(index);}
    /** 返回有效元素数。 */
    int64 len(){return self.values.len();}
    /** 返回剩余可写数量。 */
    int64 available(){return self.capacity-self.values.len();}
    /** 释放队列存储。 */
    void drop(){self.values.drop();}
};

struct FixedVector<T>: Iterator<T>, Index<T, int64>, Drop {
    std::lang::List<T> values;
    int64 capacity;

    static FixedVector<T> withCapacity(int64 capacity) {
        std::lang::assert(capacity >= 0);
        FixedVector<T> result;
        std::lang::List<T> values;
        result.values = values.copy();
        result.capacity = capacity;
        return result;
    }

    bool push(T value) {
        if (self.values.len() >= self.capacity) { return false; }
        self.values.push(value);
        return true;
    }
    Option<T> pop() {
        if (self.values.len() == 0) { return Option<T>::None; }
        return Option<T>::Value(self.values.pop());
    }
    T index(int64 key) { return self.values.at(key); }
    Option<T> iterator(int64 index) {
        if (index < self.values.len()) { return Option<T>::Value(self.values.at(index)); }
        return Option<T>::None;
    }
    int64 len() { return self.values.len(); }
    int64 capacityValue() { return self.capacity; }
    void drop() { self.values.drop(); }
};

/** 单线程拥有型消息队列；线程同步通道仍由 std::concurrency 提供。 */
struct Channel<T>: Iterator<T>, Drop {
    Queue<T> pending;
    /** 创建空消息队列。 */
    static Channel<T> create() { }
    /** 向队尾发送一个值。 */
    void send(T value){self.pending.push(move(value));}
    /** 取得队首消息，空时返回 None。 */
    Option<T> receive(){return self.pending.pop();}
    /** 按消息顺序迭代。 */
    Option<T> iterator(int64 index){return self.pending.iterator(index);}
    /** 返回消息数。 */
    int64 len(){return self.pending.len();}
    /** 判断队列是否为空。 */
    bool isEmpty(){return self.pending.isEmpty();}
    /** 释放消息队列。 */
    void drop(){self.pending.drop();}
};
