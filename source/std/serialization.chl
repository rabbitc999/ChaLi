module std::serialization;
import std::json;
import std::reflect;

String __transcode(String input, bool tomlOutput);
/** 按固定小端编码魔数、版本、类型身份和精确字节长度。 */
inline List<uint8> __pack(String text, uint64 typeId) {
    List<uint8> bytes;
    bytes.push((uint8)77); bytes.push((uint8)71); bytes.push((uint8)83); bytes.push((uint8)1);
    int64 shift=0;
    while(shift<64) { bytes.push((uint8)(typeId >> shift)); shift=shift+8; }
    uint64 length=(uint64)text.length(); shift=0;
    while(shift<64) { bytes.push((uint8)(length >> shift)); shift=shift+8; }
    int64 index=0;
    while(index<text.length()) { bytes.push(text.byteAt(index).unwrap()); index++; }
    return bytes;
}
/** 校验顺序保持魔数／版本、类型、长度、零字节，再创建独立文本。 */
inline String __unpack(List<uint8> bytes, uint64 typeId) {
    if(bytes.len()<20 || bytes[0]!=77 || bytes[1]!=71 || bytes[2]!=83 || bytes[3]!=1) {
        return "0无效序列化魔数或版本";
    }
    uint64 actual=0; uint64 length=0; int64 index=0;
    while(index<8) {
        actual=actual | ((uint64)bytes[4+index] << (8*index));
        length=length | ((uint64)bytes[12+index] << (8*index));
        index++;
    }
    if(actual!=typeId) { return "0序列化类型不匹配"; }
    if(length!=(uint64)(bytes.len()-20)) { return "0序列化长度不匹配"; }
    index=20;
    while(index<bytes.len()) {
        if(bytes[index]==0) { return "0序列化载荷包含零字节"; }
        index++;
    }
    unsafe {
        int64 buffer=std::lang::__bootStringBuffer(bytes.len()-19);
        BarePtr<uint8> output=pointerFromAddress<uint8>(std::lang::__bootStringOwnedData(buffer));
        uint8 mut& first=dereference<uint8>(output); *first=(uint8)49;
        index=20;
        while(index<bytes.len()) {
            uint8 mut& slot=dereference<uint8>(output+index-19); *slot=bytes[index]; index++;
        }
        return std::lang::__stringAdopt(buffer);
    }
}

/** 将反射值编码为带稳定类型标识和版本的独立字节流。 */
Result<List<uint8>,std::lang::Error> serialize<T>(T const& value) {
    let encoded = std::json::serialize<T>(value);
    if (encoded.isErr()) { return Result<List<uint8>,std::lang::Error>::Err(MessageError::from(encoded.error())); }
    return Result<List<uint8>,std::lang::Error>::Ok(__pack(encoded.unwrap(), std::reflect::getTypeId<T>()));
}
/** 严格验证类型、版本和长度后恢复独立拥有的值。 */
Result<T,std::lang::Error> deserialize<T>(List<uint8> bytes) {
    String unpacked = __unpack(bytes, std::reflect::getTypeId<T>());
    if (!unpacked.startsWith("1")) { return Result<T,std::lang::Error>::Err(MessageError::from(unpacked.removePrefix("0"))); }
    return std::json::deserialize<T>(unpacked.removePrefix("1"));
}
