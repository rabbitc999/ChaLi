Option<int32> toInt32(float64 value) {
    int64 converted = __tryToInt32(value);
    if (converted == 2147483648) { return Option<int32>::None; }
    return Option<int32>::Value((int32)converted);
}
/** 向零截断为 int32；非有限数或截断后越界返回 None。 */
