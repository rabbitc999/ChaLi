unsafe float64 __listStorageReadF(int64 source,int64 index,int64 text,int64 layout);
unsafe float64 __listStorageCloneF(float64 value,int64 text,int64 layout);
/** 使用同一值键判等，计数不构造元素副本。 */
inline unsafe int64 __bootListCountF(int64 source,float64 value,int64 text,int64 layout) {
