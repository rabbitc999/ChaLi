/** 在语言内执行精确分隔、ASCII 空白、行及严格 UTF-8 字符分割。 */
inline unsafe List<String> __stringSplit(int64 text,int64 separator,int64 operation,bool keepEmpty) {
    List<String> result; int64 n=__bootStringLength(text); int64 width=__bootStringLength(separator);
    int64 a=0; int64 b=0; int64 at=0; int64 begin=0;
    unsafe { a=__stringStorageData(text); b=__stringStorageData(separator); }
    unsafe {
        if (operation==3 || (operation==0 && width==0)) {
            while (at<n) {
                int64 next=__bootStringNext(a,n,at); result.push(__stringAdopt(__bootStringSliceBytes(a,at,next))); at=next;
            }
            return result;
        }
        while (at<n) {
            int64 step=0;
            if (operation==0 && width<=n-at && __bootStringEqualRange(a,at,b,width)) { step=width; }
            if (operation==1 && __bootStringSpace(__bootStringByte(a,at))) { step=1; }
            if (operation==2) {
                int64 value=__bootStringByte(a,at);
                if (value==13 || value==10) {
                    step=1; if (value==13 && at+1<n && __bootStringByte(a,at+1)==10) { step=2; }
                }
            }
            if (step==0) { at=at+1; continue; }
            if (at>begin || (operation!=1 && keepEmpty)) { result.push(__stringAdopt(__bootStringSliceBytes(a,begin,at))); }
            at=at+step; begin=at;
        }
        if (begin<n || (operation!=1 && keepEmpty)) { result.push(__stringAdopt(__bootStringSliceBytes(a,begin,n))); }
    }
    return result;
}
/** 预计算所有片段长度，一次分配并直接写入最终存储。 */
inline unsafe String __stringJoinParts(int64 separator,List<String> const& items) {
    int64 count=items.len(); int64 width=__bootStringLength(separator); int64 total=0; int64 i=0;
    List<int64> lengths;
    while (i<count) {
        String item=items[i]; int64 length=item.length();
        if (!(length<=9223372036854775806-total)) { panic("String：连接结果过长"); } total=total+length;
        if (i>0) { if (!(width<=9223372036854775806-total)) { panic("String：连接结果过长"); } total=total+width; }
        lengths.push(length); i=i+1;
    }
    unsafe {
        int64 result=__bootStringBuffer(total); int64 at=0; i=0;
        while (i<count) {
            if (i>0) { __bootStringCopyBytes(__bootStringOwnedData(result)+at,__stringStorageData(separator),width); at=at+width; }
            String item=items[i];
            __bootStringCopyBytes(__bootStringOwnedData(result)+at,__stringStorageData(item.opcode),lengths[i]); at=at+lengths[i]; i=i+1;
        }
        return __stringAdopt(result);
    }
}



