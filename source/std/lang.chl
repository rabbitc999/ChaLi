module std::lang;

/** 查询 T 在当前 ChaLi 值存储中的字节数；不访问对象，也不返回动态分配占用。
 * uint8 与 char 使用一个字节，其余普通值槽为八字节；聚合按语言布局计算，不等于宿主 C ABI 的 sizeof。
 * 无需 unsafe；不支持 void、直接数组或宿主别名，数组可放入具名结构体后查询。
 */
int64 rawSize<T>() {
    unsafe { return __rawSize(T); }
}

/** 读取字符串存储中的一个字节；调用者已证明地址位于有效范围。 */
unsafe int64 __bootStringByte(int64 address, int64 index) {
    uint8 mut& value = (uint8 mut&)(address + index);
    return (int64)*value;
}
/** 按 ASCII 固定规则识别空白，不依赖宿主区域设置。 */
inline bool __bootStringSpace(int64 value) { return value == 32 || (value >= 9 && value <= 13); }
/** 将字节位置限制到闭区间 [0,length]。 */
inline int64 __bootStringClamp(int64 index, int64 length) {
    if (index < 0) { return 0; }
    if (index > length) { return length; }
    return index;
}
/** 比较两个已验证字节范围，不创建中间字符串。 */
inline unsafe bool __bootStringEqualRange(int64 left, int64 start, int64 right, int64 width) {
    int64 i = 0;
    while (i < width) {
        if (__bootStringByte(left,start+i) != __bootStringByte(right,i)) { return false; }
        i = i + 1;
    }
    return true;
}
/** KMP 搜索；原始存储只保存前缀表，最长线性扫描输入及模式。 */
inline unsafe int64 __bootStringFind(int64 text,int64 length,int64 needle,int64 width,int64 start) {
    if (width == 0) { return start; }
    if (width > length-start) { return 0-1; }
    RawStorage<int64> table = RawStorage<int64>::allocate(width);
    int64 prefix = barePointer<int64>(table.pointer(0)).address;
    int64 stride = __rawSize(int64);
    int64 mut& zero = (int64 mut&)prefix; *zero = 0;
    int64 i=1; int64 matched=0;
    while (i<width) {
        int64 next=__bootStringByte(needle,i);
        while (matched>0 && next!=__bootStringByte(needle,matched)) {
            int64 mut& previous=(int64 mut&)(prefix+(matched-1)*stride); matched=*previous;
        }
        if (next==__bootStringByte(needle,matched)) { matched=matched+1; }
        int64 mut& entry=(int64 mut&)(prefix+i*stride); *entry=matched; i=i+1;
    }
    i=start; matched=0;
    while (i<length) {
        int64 next=__bootStringByte(text,i);
        while (matched>0 && next!=__bootStringByte(needle,matched)) {
            int64 mut& previous=(int64 mut&)(prefix+(matched-1)*stride); matched=*previous;
        }
        if (next==__bootStringByte(needle,matched)) { matched=matched+1; }
        if (matched==width) { return i-width+1; }
        i=i+1;
    }
    return 0-1;
}
/** 严格解码一个 UTF-8 码点，返回下一字节位置。 */
inline unsafe int64 __bootStringNext(int64 text,int64 length,int64 at) {
    int64 first=__bootStringByte(text,at); at=at+1;
    if (first<128) { return at; }
    int64 remaining=0; int64 code=0; int64 minimum=0;
    if (first>=194 && first<=223) { remaining=1; code=first&31; minimum=128; }
    else { if (first>=224 && first<=239) { remaining=2; code=first&15; minimum=2048; }
    else { if (first>=240 && first<=244) { remaining=3; code=first&7; minimum=65536; }
    else { if (!(false)) { panic("String：非法 UTF-8 起始字节"); } } } }
    if (!(remaining<=length-at)) { panic("String：不完整的 UTF-8 字符"); }
    while (remaining>0) {
        int64 next=__bootStringByte(text,at); at=at+1;
        if (!((next&192)==128)) { panic("String：非法 UTF-8 延续字节"); }
        code=code*64+(next&63); remaining=remaining-1;
    }
    if (!(code>=minimum && code<=1114111 && (code<55296 || code>57343))) { panic("String：非法 Unicode 码点"); }
    return at;
}
/** 字符串查询在语言内执行；仅裸地址读取使用不安全内存原语。 */
inline unsafe int64 __stringQuery(int64 text,int64 needle,int64 operation,int64 from) {
    int64 length=__bootStringLength(text); int64 width=__bootStringLength(needle);
    int64 address=0; int64 pattern=0;
    unsafe { address=__stringStorageData(text); pattern=__stringStorageData(needle); }
    int64 start=__bootStringClamp(from,length);
    unsafe {
        if (operation==0 || operation==2) {
            if (operation==2) { start=0; }
            int64 found=__bootStringFind(address,length,pattern,width,start);
            if (operation==2) { if (found>=0) { return 1; } return 0; }
            return found;
        }
        if (operation==1) {
            if (from<0) { start=length; }
            if (width>length) { return 0-1; }
            if (start>length-width) { start=length-width; }
            while (start>=0) {
                if (__bootStringEqualRange(address,start,pattern,width)) { return start; }
                start=start-1;
            }
            return 0-1;
        }
        if (operation==3 || operation==4) {
            if (width>length) { return 0; }
            start=0; if (operation==4) { start=length-width; }
            if (__bootStringEqualRange(address,start,pattern,width)) { return 1; } return 0;
        }
        if (operation==5) {
            if (width==0) { return length+1; }
            int64 count=0;
            while (start<=length-width) {
                int64 found=__bootStringFind(address,length,pattern,width,start);
                if (found<0) { break; } count=count+1; start=found+width;
            }
            return count;
        }
        if (operation==6) {
            int64 i=0;
            while (i<length && i<width) {
                int64 left=__bootStringByte(address,i); int64 right=__bootStringByte(pattern,i);
                if (left<right) { return 0-1; } if (left>right) { return 1; } i=i+1;
            }
            if (length<width) { return 0-1; } if (length>width) { return 1; } return 0;
        }
        if (operation>=7 && operation<=11) {
            if (length==0 && operation>=8 && operation<=10) { return 0; }
            int64 i=0;
            while (i<length) {
                int64 value=__bootStringByte(address,i);
                bool digit=value>=48 && value<=57;
                bool alpha=(value>=65 && value<=90) || (value>=97 && value<=122);
                if (operation==7 && !__bootStringSpace(value)) { return 0; }
                if (operation==8 && !digit) { return 0; }
                if (operation==9 && !alpha) { return 0; }
                if (operation==10 && !digit && !alpha) { return 0; }
                if (operation==11 && value>=128) { return 0; } i=i+1;
            }
            return 1;
        }
        if (operation==12) {
            if (!(from>=0 && from<length)) { panic("String：字节下标越界"); }
            return __bootStringByte(address,from);
        }
        if (operation==13) {
            int64 at=0; int64 count=0;
            while (at<length) { at=__bootStringNext(address,length,at); count=count+1; }
            return count;
        }
    }
    if (!(false)) { panic("String：查询操作编号无效"); } return 0;
}

/** 编译器私有存储原语，分别直接降低为分配、清理及地址接管。 */
