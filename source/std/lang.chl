    while(i<size){if(__listStorageEqualF(handle,i,value,text,layout)!=0){return i;}i=i+1;}return 0-1;
}

/** 哈希容器仅暴露槽位和单值封送；所有探测与增长策略在语言内实现。 */
unsafe int64 __mapStorageState(int64 handle,int64 operation,int64 index,int64 value);
unsafe int64 __mapStorageCommit(int64 handle,int64 index,int64 hash);
unsafe int64 __mapStorageErase(int64 handle,int64 index);
unsafe int64 __mapStorageEmptyLike(int64 handle);
unsafe int64 __mapStorageCloneAppend(int64 destination,int64 source,int64 index);

/** 将哈希位模式映射到槽数组，负哈希仍按无符号位模式取模。 */
inline int64 __bootMapHome(int64 hash,int64 capacity) { return (int64)((uint64)hash%(uint64)capacity); }
/** 读取一个有效标志与密集位置编码，零代表无值。 */
inline unsafe int64 __bootMapSlot(int64 handle,int64 index) { return __mapStorageState(handle,3,index,0); }
/** 按缓存 HashKey 放置一个已初始化项，不执行键比较或用户回调。 */
inline unsafe void __bootMapPlace(int64 handle,int64 entry,int64 hash) {
    int64 capacity=__mapStorageState(handle,1,0,0); int64 slot=__bootMapHome(hash,capacity);
    while (__bootMapSlot(handle,slot)!=0) { slot=(slot+1)%capacity; }
    __mapStorageState(handle,4,slot,entry+1);
}
/** 重建槽位数组，值与键保持原存储，不产生用户元素副本。 */
inline unsafe void __bootMapRehash(int64 handle,int64 capacity) {
    __mapStorageState(handle,5,0,capacity); int64 size=__mapStorageState(handle,0,0,0); int64 i=0;
    while (i<size) { __bootMapPlace(handle,i,__mapStorageState(handle,7,i,0)); i=i+1; }
    __mapStorageState(handle,6,0,0);
}
/** 宿主修改后按需恢复语言索引，无 Hash 的 Equal 契约仍使用线性查询。 */
inline unsafe void __bootMapEnsure(int64 handle) {
    if (__mapStorageState(handle,2,0,0)!=0) { return; }
    if (__mapStorageState(handle,8,0,0)==0) { __mapStorageState(handle,5,0,0); __mapStorageState(handle,6,0,0); return; }
    int64 size=__mapStorageState(handle,0,0,0); int64 capacity=__mapStorageState(handle,1,0,0);
    int64 maximum=__mapStorageState(handle,9,0,0); int64 minimum=16;if(minimum>maximum){minimum=maximum;}
    assert(size<=maximum/2,"Map/Set 索引容量超出上限");
    int64 required=size*2;if(required==0){required=1;}
    capacity=__bootBufferCapacity(0,required,capacity,minimum,maximum);
    __bootMapRehash(handle,capacity);
}
/** 插入前按相同几何策略预留密集槽及索引，索引装载因子不超过一半。 */
inline unsafe void __bootMapGrow(int64 handle) {
    int64 size=__mapStorageState(handle,0,0,0); int64 dense=__mapStorageState(handle,10,0,0);
    if(size==dense){
        int64 maximum=__mapStorageState(handle,11,0,0);int64 minimum=8;if(minimum>maximum){minimum=maximum;}
        __mapStorageState(handle,12,0,__bootBufferCapacity(size,1,dense,minimum,maximum));
    }
    if (__mapStorageState(handle,8,0,0)==0) { return; }
    int64 capacity=__mapStorageState(handle,1,0,0);
    if(size>=capacity/2){
        int64 maximum=__mapStorageState(handle,9,0,0);int64 minimum=16;if(minimum>maximum){minimum=maximum;}
        assert(size<maximum/2,"Map/Set 索引容量超出上限");
        __bootMapRehash(handle,__bootBufferCapacity(0,(size+1)*2,capacity,minimum,maximum));
    }
}
/** 已知槽号时定位其索引位置，不重复调用用户 Equal。 */
inline unsafe int64 __bootMapLocate(int64 handle,int64 entry,int64 hash) {
    int64 capacity=__mapStorageState(handle,1,0,0); int64 at=__bootMapHome(hash,capacity);
    while (__bootMapSlot(handle,at)!=entry+1) { at=(at+1)%capacity; }
    return at;
}
/** 删除保留容量，密集槽以末项补洞，开放寻址索引使用后移修复。 */
inline unsafe void __bootMapErase(int64 handle,int64 entry,int64 hash) {
    int64 size=__mapStorageState(handle,0,0,0);
    int64 capacity=__mapStorageState(handle,1,0,0);
    if (capacity==0) { __mapStorageErase(handle,entry); __mapStorageState(handle,6,0,0); return; }
    int64 hole=__bootMapLocate(handle,entry,hash);
    if (entry!=size-1) {
        int64 last=__bootMapLocate(handle,size-1,__mapStorageState(handle,7,size-1,0));
        __mapStorageState(handle,4,last,entry+1);
    }
    __mapStorageState(handle,4,hole,0); __mapStorageErase(handle,entry);
    int64 at=(hole+1)%capacity;
    while (__bootMapSlot(handle,at)!=0) {
        int64 value=__bootMapSlot(handle,at);
        int64 home=__bootMapHome(__mapStorageState(handle,7,value-1,0),capacity);
        if ((at-home+capacity)%capacity>=(hole-home+capacity)%capacity) {
            __mapStorageState(handle,4,hole,value); __mapStorageState(handle,4,at,0); hole=at;
        }
        at=(at+1)%capacity;
    }
    __mapStorageState(handle,6,0,0);
}
/** 清理拥有值并保留槽数组供后续插入复用。 */
inline unsafe int64 __bootMapClear(int64 handle) {
    int64 size=__mapStorageState(handle,0,0,0);
    while (size>0) { __mapStorageErase(handle,size-1); size=size-1; }
    int64 capacity=__mapStorageState(handle,1,0,0);
    __mapStorageState(handle,5,0,capacity); __mapStorageState(handle,6,0,0); return 0;
}
/** 按槽复制独立值及键协议，随后重建索引，不执行 Hash/Equal 用户回调。 */
inline unsafe int64 __bootMapCopy(int64 source) {
    int64 result=__mapStorageEmptyLike(source); int64 size=__mapStorageState(source,0,0,0); int64 i=0;
    if(size>0){
        int64 maximum=__mapStorageState(result,11,0,0);int64 minimum=8;if(minimum>maximum){minimum=maximum;}
        __mapStorageState(result,12,0,__bootBufferCapacity(0,size,0,minimum,maximum));
    }
    while (i<size) { __mapStorageCloneAppend(result,source,i); i=i+1; }
    __bootMapEnsure(result); return result;
}

