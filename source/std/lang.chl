/** 标准库错误的统一接口；诊断文本保留具体失败原因。 */
interface Error {
    /** 返回可直接显示给用户的错误说明。 */
    String toString();
};

/** 只有文本诊断时使用的标准错误对象，消息按值独立拥有。 */
struct MessageError : Error {
    /** 原始诊断文本，不丢弃模块提供的细节。 */
    String message;
    /** 返回原始诊断文本。 */
    String toString() { return self.message; }
    /** 从诊断文本构造拥有独立消息的错误。 */
    static MessageError from(String text) {
        MessageError error;
        error.message = text;
        return error;
    }
};

