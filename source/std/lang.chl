}
/** 按原始顺序累加，保留浮点舍入次序。 */
inline unsafe float64 __bootListSumF(int64 source,int64 floating) {
    float64 total=0; int64 i=0; int64 size=__listStorageLength(source);
    while (i<size) { total=total+__listStorageReadF(source,i,0,0); i=i+1; }
