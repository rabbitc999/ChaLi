/** 缩短逻辑字节长度并保留当前缓冲区，不进行 UTF-8 重编码。 */
inline unsafe void __bootStringTruncate(int64 address,int64 length) {
    if(length<0){panic("String：截短长度不能为负数");}
    if(__stringStorageKind(address)==0){panic("String：修改需要拥有型缓冲区");}
    int64 mut& size=(int64 mut&)(address+8);if(length>=*size){return;}
    uint8 mut& zero=(uint8 mut&)(__bootStringOwnedData(address)+length);*zero=0u;*size=length;
}
/** 切片操作的负一终点表示余下全部，其余负下标拒绝。 */
inline unsafe int64 __bootStringSlice(int64 source,int64 begin,int64 end) {
    int64 length=__bootStringLength(source);
    if (end==0-1) { end=length; }
    if (!(begin>=0 && end>=0)) { panic("切片端点不能为负数（String 的切片按字节算）"); }
    begin=__bootStringClamp(begin,length); end=__bootStringClamp(end,length);
    if (end<begin) { end=begin; }
    return __bootStringSliceBytes(__stringStorageData(source),begin,end);
}
/** 复制已限制范围内的内容字节，返回带长度头的字符串值。 */
inline unsafe int64 __bootStringSliceBytes(int64 source,int64 begin,int64 end) {
    int64 result=__bootStringBuffer(end-begin); __bootStringCopyBytes(__bootStringOwnedData(result),source+begin,end-begin); return result;
}
/** 无临时文本的字节字典序比较。 */
inline unsafe int64 __bootStringCompare(int64 left,int64 right) {
    int64 a=__bootStringLength(left); int64 b=__bootStringLength(right); int64 i=0;
    left=__stringStorageData(left); right=__stringStorageData(right);
    while (i<a && i<b) {
        int64 x=__bootStringByte(left,i); int64 y=__bootStringByte(right,i);
        if (x<y) { return 0-1; } if (x>y) { return 1; } i=i+1;
    }
    if (a<b) { return 0-1; } if (a>b) { return 1; } return 0;
}
/** 为字符串运算符提供首个匹配的字节位置。 */
inline unsafe int64 __bootStringPosition(int64 text,int64 needle) {
    return __bootStringFind(__stringStorageData(text),__bootStringLength(text),__stringStorageData(needle),__bootStringLength(needle),0);
}
/** 普通下标保留严格范围与 UTF-8 起点检查。 */
inline unsafe int64 __bootStringAt(int64 source,int64 index) {
    int64 length=__bootStringLength(source);
    if (!(index>=0 && index<length)) { panic("字符串下标越界"); }
    int64 value=__bootStringByte(__stringStorageData(source),index);
    if ((value&192)==128) { panic("字符串下标落在多字节字符中间（String 按字节算）"); }
    return value;
}
/** 写入一个原始字节，保持现有可变字符串的字节语义。 */
inline unsafe int64 __bootStringSet(int64 source,int64 index,int64 value) {
    int64 length=__bootStringLength(source);
    if (!(index>=0 && index<length)) { panic("字符串下标越界"); }
    uint8 mut& target=(uint8 mut&)(__stringStorageData(source)+index);
    *target=(uint8)(value&255); return 0;
}
/** 字节引用保留现有下标范围；不额外限制为 UTF-8 码点起点。 */
inline unsafe int64 __bootStringReference(int64 source,int64 index) {
    int64 length=__bootStringLength(source);
    if (!(index>=0 && index<length)) { panic("字符串下标越界"); }
    return __stringStorageData(source)+index;
}
/** 按十进制生成有符号整数，避免最小负数取负溢出。 */
unsafe int64 __bootStringFromInt(int64 value) {
    bool negative=value<0; uint64 magnitude=(uint64)value;
    if (negative) { magnitude=(uint64)(0-(value+1))+1u; }
    uint64 rest=magnitude; int64 length=1;
    while (rest>=10u) { length=length+1; rest=rest/10u; }
    if (negative) { length=length+1; }
    int64 result=__bootStringBuffer(length); int64 at=length;
    while (at>0) {
        at=at-1;
        uint8 mut& digit=(uint8 mut&)(__bootStringOwnedData(result)+at);
        *digit=(uint8)(48u+magnitude%10u); magnitude=magnitude/10u;
        if (magnitude==0u) { break; }
    }
    if (negative) { uint8 mut& sign=(uint8 mut&)__bootStringOwnedData(result); *sign=45u; }
    return result;
}

/** 检查拼接长度后相加，避免溢出先于分配。 */
inline int64 __bootStringAddLength(int64 left,int64 right) { if (!(left>=0 && right>=0 && right<=9223372036854775806-left)) { panic("String：连接结果过长"); } return left+right; }
/** 在一个结果缓冲区中组合三个字节片段。 */
inline unsafe int64 __bootStringCompose(int64 a,int64 an,int64 b,int64 bn,int64 c,int64 cn) {
    if (!(an>=0 && bn>=0 && cn>=0 && an<=9223372036854775806-bn)) { panic("String：结果过长"); }
    int64 total=an+bn; if (!(cn<=9223372036854775806-total)) { panic("String：结果过长"); }
