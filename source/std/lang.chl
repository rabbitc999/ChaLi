}

/** 只复制最终选中的值，等值时保留首个参数。 */
inline unsafe float64 __bootListMinF(int64 source,float64 first,int64 text,int64 layout) {
    int64 best=-1; int64 i=0; int64 size=__listStorageLength(source);
    while (i<size) { int64 relation=0;
        if (best<0) { relation=__listStorageCompareF(source,i,first,text,layout); }
        else { relation=__listStorageCompareIndex(source,i,best); }
        if (relation<0) { best=i; } i=i+1;
    }
    if (best<0) { return __listStorageCloneF(first,text,layout); }
