/** 取得命中项的独立值，缺失键由单槽读取边界报告。 */
inline unsafe int64 __bootMapGetFI(int64 handle,float64 key,int64 keyText,int64 keyLayout,int64 valueText,int64 valueLayout) {
    int64 hash=__mapStorageHashF(handle,key,keyText,keyLayout);
    int64 entry=__bootMapFindF(handle,key,keyText,keyLayout,hash);
    return __mapStorageReadI(handle,entry,valueText,valueLayout);
}

unsafe float64 __mapStorageReadF(int64 handle,int64 entry,int64 text,int64 layout);
unsafe int64 __mapStoragePrepareIF(int64 handle,int64 key,int64 keyText,int64 keyLayout,float64 value,int64 valueText,int64 valueLayout);
/** 写入先复制值，再执行键协议；提交后只更新索引槽。 */
inline unsafe int64 __bootMapPutIF(int64 handle,int64 key,int64 keyText,int64 keyLayout,float64 value,int64 valueText,int64 valueLayout) {
    __mapStoragePrepareIF(handle,key,keyText,keyLayout,value,valueText,valueLayout);
    int64 hash=__mapStorageHashI(handle,key,keyText,keyLayout);
    int64 entry=__bootMapFindI(handle,key,keyText,keyLayout,hash); bool fresh=entry<0;
    if (fresh) { __bootMapGrow(handle); }
    entry=__mapStorageCommit(handle,entry,hash);
    if (fresh && __mapStorageState(handle,1,0,0)>0) { __bootMapPlace(handle,entry,hash); }
    __mapStorageState(handle,6,0,0); return 0;
}
/** 取得命中项的独立值，缺失键由单槽读取边界报告。 */
inline unsafe float64 __bootMapGetIF(int64 handle,int64 key,int64 keyText,int64 keyLayout,int64 valueText,int64 valueLayout) {
    int64 hash=__mapStorageHashI(handle,key,keyText,keyLayout);
    int64 entry=__bootMapFindI(handle,key,keyText,keyLayout,hash);
    return __mapStorageReadF(handle,entry,valueText,valueLayout);
}
unsafe int64 __mapStoragePrepareFF(int64 handle,float64 key,int64 keyText,int64 keyLayout,float64 value,int64 valueText,int64 valueLayout);
/** 写入先复制值，再执行键协议；提交后只更新索引槽。 */
inline unsafe int64 __bootMapPutFF(int64 handle,float64 key,int64 keyText,int64 keyLayout,float64 value,int64 valueText,int64 valueLayout) {
    __mapStoragePrepareFF(handle,key,keyText,keyLayout,value,valueText,valueLayout);
    int64 hash=__mapStorageHashF(handle,key,keyText,keyLayout);
    int64 entry=__bootMapFindF(handle,key,keyText,keyLayout,hash); bool fresh=entry<0;
    if (fresh) { __bootMapGrow(handle); }
    entry=__mapStorageCommit(handle,entry,hash);
    if (fresh && __mapStorageState(handle,1,0,0)>0) { __bootMapPlace(handle,entry,hash); }
    __mapStorageState(handle,6,0,0); return 0;
}
/** 取得命中项的独立值，缺失键由单槽读取边界报告。 */
inline unsafe float64 __bootMapGetFF(int64 handle,float64 key,int64 keyText,int64 keyLayout,int64 valueText,int64 valueLayout) {
    int64 hash=__mapStorageHashF(handle,key,keyText,keyLayout);
    int64 entry=__bootMapFindF(handle,key,keyText,keyLayout,hash);
    return __mapStorageReadF(handle,entry,valueText,valueLayout);
}

unsafe int64 __setStorageCancel(int64 handle);

/** 保留向零截断及独立失败哨兵，不在失败路径执行浮点到整数转换。 */
inline int64 __tryToInt32(float64 value) {
    if (value> -2147483649.0 && value<2147483648.0) { return (int64)value; }
    return 2147483648;
}
/** 有限且可表示时才执行整数转换，诊断保留原接口含义。 */
inline int64 __toInt64(float64 value) {
    if (!(value>= -9223372036854775808.0 && value<9223372036854775808.0)) {
        panic("std::lang::toInt64：浮点值不是有限数或超出 int64 范围");
    }
    return (int64)value;
}
/** 语言浮点槽使用 binary64；通过不安全引用取得同一槽的原始位。 */
uint64 __bootFloat64Bits(float64 value) {
    unsafe { BarePtr<float64> source=pointerFromAddress<float64>((int64)&value); BarePtr<uint64> raw=source.castTo<uint64>(); uint64 mut& bits=dereference<uint64>(raw); return *bits; }
}
/** 取得 binary64 原始位代表的浮点值，不进行整数数值转换。 */
float64 __bootFloat64FromBits(uint64 bits) {
    unsafe { BarePtr<uint64> source=pointerFromAddress<uint64>((int64)&bits); BarePtr<float64> raw=source.castTo<float64>(); float64 mut& value=dereference<float64>(raw); return *value; }
}
/** binary32 值已精确归一化到语言浮点槽，恢复其指数与尾数。 */
uint64 __bootFloat32Bits(float32 value) {
    uint64 raw=__bootFloat64Bits((float64)value);
    uint64 sign=(raw>>63)<<31; uint64 exponent=(raw>>52)&2047u;
    uint64 fraction=raw&4503599627370495u;
    if (exponent==2047u) {
        uint64 payload=fraction>>29;
        if (fraction!=0u && payload==0u) { payload=4194304u; }
        return sign|2139095040u|payload;
    }
    if (exponent==0u) { return sign; }
    if (exponent>896u) { return sign|((exponent-896u)<<23)|(fraction>>29); }
    return sign|((fraction|4503599627370496u)>>(926u-exponent));
}
/** 精确构造可由 binary32 表示的 binary64 槽，再恢复 binary32 类型。 */
float32 __bootFloat32FromBits(uint64 bits) {
    uint64 sign=((bits>>31)&1u)<<63;
    uint64 exponent=(bits>>23)&255u; uint64 fraction=bits&8388607u; uint64 raw=sign;
    if (exponent==255u) { raw=raw|9218868437227405312u|(fraction<<29); }
    elif (exponent>0u) { raw=raw|((exponent+896u)<<52)|(fraction<<29); }
    elif (fraction>0u) {
        uint64 leading=0u; uint64 top=fraction;
        while (top>1u) { top=top>>1; leading=leading+1u; }
        raw=raw|((leading+874u)<<52)|((fraction-(1u<<leading))<<(52u-leading));
    }
    return (float32)__bootFloat64FromBits(raw);
}
/** 按指定字节宽度翻转有效位，用于显式大端格式。 */
inline uint64 __bootSwapBytes(uint64 bits,int64 count) {
    uint64 result=0u; int64 i=0;
    while (i<count) { result=(result<<8)|(bits&255u); bits=bits>>8; i=i+1; }
    return result;
}

/** 按指定字节序编码 IEEE 754，不依赖宿主胶水。 */
inline List<uint8> __float32ToBytes(float32 value,bool bigEndian) {
    List<uint8> result; uint64 bits=__bootFloat32Bits(value);
    if (bigEndian) { bits=__bootSwapBytes(bits,4); }
    int64 i=0; while (i<4) { result.push((uint8)(bits&255u)); bits=bits>>8; i=i+1; }
    return result;
}
/** 列表入口在读取前校验完整输入长度。 */
inline float32 __bytesToFloat32(List<uint8> bytes,bool bigEndian) {
    if (bytes.len()<4) { panic("IEEE 754 转换：字节不足"); }
    uint64 bits=0u; int64 i=0;
    while (i<4) { bits=bits|((uint64)bytes[i]<<(i*8)); i=i+1; }
    if (bigEndian) { bits=__bootSwapBytes(bits,4); }
    return __bootFloat32FromBits(bits);
}
/** 整段检查后复制输入字节，避免越界时部分读取。 */
inline float32 __arrayToFloat32(uint8 const& bytes,bool bigEndian) {
    uint64 bits=0u; unsafe { BarePtr<uint64> target=pointerFromAddress<uint64>((int64)&bits); BarePtr<uint8> source=pointerFromAddress<uint8>((int64)address(bytes)); memcpy<uint8,uint8>(target.castTo<uint8>(),source,4); }
    if (bigEndian) { bits=__bootSwapBytes(bits,4); }
    return __bootFloat32FromBits(bits);
}
/** 整段检查后一次写入，失败时不留下部分编码结果。 */
inline bool __float32ToArray(float32 value,uint8 mut& bytes,bool bigEndian) {
    uint64 bits=__bootFloat32Bits(value);
    if (bigEndian) { bits=__bootSwapBytes(bits,4); }
    unsafe { BarePtr<uint64> source=pointerFromAddress<uint64>((int64)&bits); BarePtr<uint8> target=pointerFromAddress<uint8>((int64)address(bytes)); memcpy<uint8,uint8>(target,source.castTo<uint8>(),4); } return true;
}

/** 按指定字节序编码 IEEE 754，不依赖宿主胶水。 */
inline List<uint8> __float64ToBytes(float64 value,bool bigEndian) {
    List<uint8> result; uint64 bits=__bootFloat64Bits(value);
    if (bigEndian) { bits=__bootSwapBytes(bits,8); }
    int64 i=0; while (i<8) { result.push((uint8)(bits&255u)); bits=bits>>8; i=i+1; }
    return result;
}
/** 列表入口在读取前校验完整输入长度。 */
inline float64 __bytesToFloat64(List<uint8> bytes,bool bigEndian) {
    if (bytes.len()<8) { panic("IEEE 754 转换：字节不足"); }
    uint64 bits=0u; int64 i=0;
    while (i<8) { bits=bits|((uint64)bytes[i]<<(i*8)); i=i+1; }
    if (bigEndian) { bits=__bootSwapBytes(bits,8); }
    return __bootFloat64FromBits(bits);
}
/** 整段检查后复制输入字节，避免越界时部分读取。 */
inline float64 __arrayToFloat64(uint8 const& bytes,bool bigEndian) {
    uint64 bits=0u; unsafe { BarePtr<uint64> target=pointerFromAddress<uint64>((int64)&bits); BarePtr<uint8> source=pointerFromAddress<uint8>((int64)address(bytes)); memcpy<uint8,uint8>(target.castTo<uint8>(),source,8); }
    if (bigEndian) { bits=__bootSwapBytes(bits,8); }
    return __bootFloat64FromBits(bits);
}
/** 整段检查后一次写入，失败时不留下部分编码结果。 */
inline bool __float64ToArray(float64 value,uint8 mut& bytes,bool bigEndian) {
    uint64 bits=__bootFloat64Bits(value);
    if (bigEndian) { bits=__bootSwapBytes(bits,8); }
    unsafe { BarePtr<uint64> source=pointerFromAddress<uint64>((int64)&bits); BarePtr<uint8> target=pointerFromAddress<uint8>((int64)address(bytes)); memcpy<uint8,uint8>(target,source.castTo<uint8>(),8); } return true;
}

/** 标准算法调用期间固定源容器寿命，正常和失败退出均清理。 */
Any __algorithmLease<T>(List<T> source);

/** 逐项调用语言函数值，结果与输入各自拥有值；租约保护整个回调序列。 */
List<R> __bootAlgorithmMap<T,R>(List<T> source,R fn(T) callback) {
    Any lease=__algorithmLease<T>(source);
    List<R> result; int64 i=0; int64 size=source.len();
    while (i<size) { result.push(callback(source[i])); i=i+1; }
    return result;
}
/** 保留谓词命中的独立值，不改变输入表。 */
List<T> __bootAlgorithmFilter<T>(List<T> source,bool fn(T) callback) {
    Any lease=__algorithmLease<T>(source);
    List<T> result; int64 i=0; int64 size=source.len();
    while (i<size) { if (callback(source[i])) { result.push(source[i]); } i=i+1; }
    return result;
}
/** 短路判断所有元素；空表返回 true。 */
bool __bootAlgorithmAll<T>(List<T> source,bool fn(T) callback) {
    Any lease=__algorithmLease<T>(source); int64 i=0; int64 size=source.len();
    while (i<size) { if (!callback(source[i])) { return false; } i=i+1; }
    return true;
}
/** 短路判断至少一个元素；空表返回 false。 */
bool __bootAlgorithmAny<T>(List<T> source,bool fn(T) callback) {
    Any lease=__algorithmLease<T>(source); int64 i=0; int64 size=source.len();
    while (i<size) { if (callback(source[i])) { return true; } i=i+1; }
    return false;
}
/** 从独立初值顺序归约，正常与提前退出均清理租约和中间拥有值。 */
T __bootAlgorithmFold<T>(List<T> source,T initial,T fn(T,T) callback) {
    Any lease=__algorithmLease<T>(source); int64 i=0; int64 size=source.len();
    while (i<size) { initial=callback(initial,source[i]); i=i+1; }
    return initial;
}
/** 以首个元素为初值；空表拒绝，单元素也返回独立拥有值。 */
T __bootAlgorithmReduce<T>(List<T> source,T fn(T,T) callback) {
    Any lease=__algorithmLease<T>(source); int64 size=source.len();
    if (size==0) { panic("std::lang::algorithms::reduce 不能作用在空表上（要给初值就用 fold）"); }
    T result=source[0]; int64 i=1;
    while (i<size) { result=callback(result,source[i]); i=i+1; }
    return result;
}
/** 谓词计数使用相同的全程租约与调用顺序。 */
int64 __bootAlgorithmCountIf<T>(List<T> source,bool fn(T) callback) {
    Any lease=__algorithmLease<T>(source); int64 i=0; int64 count=0; int64 size=source.len();
    while (i<size) { if (callback(source[i])) { count=count+1; } i=i+1; }
    return count;
}

/** 单槽比较保留宿主值键的排序规则，遍历与选择由语言实现。 */
unsafe int64 __listStorageCompareIndex(int64 source,int64 left,int64 right);

unsafe int64 __listStorageCompareI(int64 source,int64 index,int64 value,int64 text,int64 layout);
unsafe int64 __listStorageReadI(int64 source,int64 index,int64 text,int64 layout);
unsafe int64 __listStorageCloneI(int64 value,int64 text,int64 layout);
/** 使用同一值键判等，计数不构造元素副本。 */
inline unsafe int64 __bootListCountI(int64 source,int64 value,int64 text,int64 layout) {
    int64 size=__listStorageLength(source); int64 i=0; int64 count=0;
    while (i<size) { if (__listStorageEqualI(source,i,value,text,layout)!=0) { count=count+1; } i=i+1; }
    return count;
}
/** lower_bound 保留相等元素的首个位置。 */
inline unsafe int64 __bootListBinarySearchI(int64 source,int64 value,int64 text,int64 layout) {
    int64 low=0; int64 high=__listStorageLength(source); int64 size=high;
    while (low<high) { int64 middle=low+(high-low)/2;
        if (__listStorageCompareI(source,middle,value,text,layout)<0) { low=middle+1; } else { high=middle; }
    }
    if (low==size) { return -1; }
    if (__listStorageEqualI(source,low,value,text,layout)!=0) { return low; }
    return -1;
}
/** 按原始顺序累加，保留浮点舍入次序。 */
inline unsafe int64 __bootListSumI(int64 source,int64 floating) {
    int64 total=0; int64 i=0; int64 size=__listStorageLength(source);
    while (i<size) { total=total+__listStorageReadI(source,i,0,0); i=i+1; }
    return total;
}

/** 只复制最终选中的值，等值时保留首个参数。 */
inline unsafe int64 __bootListMinI(int64 source,int64 first,int64 text,int64 layout) {
    int64 best=-1; int64 i=0; int64 size=__listStorageLength(source);
    while (i<size) { int64 relation=0;
        if (best<0) { relation=__listStorageCompareI(source,i,first,text,layout); }
        else { relation=__listStorageCompareIndex(source,i,best); }
        if (relation<0) { best=i; } i=i+1;
    }
    if (best<0) { return __listStorageCloneI(first,text,layout); }
    return __listStorageReadI(source,best,text,layout);
}

/** 只复制最终选中的值，等值时保留首个参数。 */
inline unsafe int64 __bootListMaxI(int64 source,int64 first,int64 text,int64 layout) {
    int64 best=-1; int64 i=0; int64 size=__listStorageLength(source);
    while (i<size) { int64 relation=0;
        if (best<0) { relation=__listStorageCompareI(source,i,first,text,layout); }
        else { relation=__listStorageCompareIndex(source,i,best); }
        if (relation>0) { best=i; } i=i+1;
    }
    if (best<0) { return __listStorageCloneI(first,text,layout); }
    return __listStorageReadI(source,best,text,layout);
}

/** 验证边界顺序后返回独立拥有值。 */
inline unsafe int64 __bootListClampI(int64 source,int64 value,int64 text,int64 layout) {
    if (__listStorageLength(source)!=2) { panic("std::lang::algorithms::clamp 的边界胶水需要 low/high 两项"); }
    if (__listStorageCompareIndex(source,1,0)<0) { panic("std::lang::algorithms::clamp 要求 low <= high"); }
    if (__listStorageCompareI(source,0,value,text,layout)>0) { return __listStorageReadI(source,0,text,layout); }
    if (__listStorageCompareI(source,1,value,text,layout)<0) { return __listStorageReadI(source,1,text,layout); }
    return __listStorageCloneI(value,text,layout);
}

