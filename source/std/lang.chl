}
/** 默认小端固定数组解码。 */
Option<float64> bytesToFloat64(uint8 const& bytes, int64 count) { return bytesToFloat64(bytes, count, false); }
/** 从运行时数组读取，自动获取长度。 */
Option<float64> bytesToFloat64(uint8 bytes[], bool bigEndian) { return bytesToFloat64(bytes, std::lang::len(bytes), bigEndian); }
/** 默认小端运行时数组解码。 */
Option<float64> bytesToFloat64(uint8 bytes[]) { return bytesToFloat64(bytes, std::lang::len(bytes), false); }
/** 写入数组前 8 项；容量不足返回 false，数组保持不变。 */
bool float64ToBytes(float64 value, uint8 mut& bytes, int64 count, bool bigEndian) {
    if (count < 8) { return false; }
    return __float64ToArray(value, bytes, bigEndian);
}
/** 默认小端固定数组编码。 */
bool float64ToBytes(float64 value, uint8 mut& bytes, int64 count) { return float64ToBytes(value, bytes, count, false); }
/** 编码到运行时数组的可变引用，自动获取容量；调用时传入 &array。 */
bool float64ToBytes(float64 value, uint8[] mut& bytes, bool bigEndian) {
    if (std::lang::len(bytes) < 8) { return false; }
    return float64ToBytes(value, &bytes[0], std::lang::len(bytes), bigEndian);
}
/** 默认小端运行时数组编码；调用时传入 &array。 */
bool float64ToBytes(float64 value, uint8[] mut& bytes) { return float64ToBytes(value, bytes, false); }

/* ChaLi 标准库前导模块。这里放可由 ChaLi 自身表达的类型；算法由编译器签名接入 VM 胶水。 */

/*
 * 中止统一使用 std::lang::panic，编译器与运行时通过 `__std_panic` 执行停机。
 * 断言使用下面的标准库函数，它们在条件失败时调用 `std::lang::panic`。
 * 带消息的重载让标准库自己的前置检查
 * 也能给出人话（例如 range 的步长）。
 *
 * 带 `int64 line` 的重载给文件末尾的系统宏 `$assert(...)` 用：宏把调用点的 `$line`
 * 传进来，失败时就地报出**源码行号**，不必每处自己写文案。
 */
void assert(bool condition) {
    if (!condition) { std::lang::panic("assert(x) 的 x 为假"); }
}

void assert(bool condition, std::lang::String message) {
    if (!condition) { std::lang::panic(message); }
}

void assert(bool condition, int64 line) {
    if (!condition) { std::lang::panic(std::lang::format("断言失败：源码第 {} 行", line)); }
}

void assert(bool condition, std::lang::String message, int64 line) {
    if (!condition) { std::lang::panic(std::lang::format("{}（源码第 {} 行）", message, line)); }
}

/** 成功继续求值，失败携带传播载荷退出当前函数。 */
enum TryBranch<T, R> { Continue(T value), Break(R residual); };
/** Result 的错误载荷，保留错误与缺失两类传播的区别。 */
struct ErrorResidual<E> { E error; };
/** Option 的无值传播载荷。 */
enum NoneResidual { None; };
/** 只读拆分传播值。 */
interface Try<T, R> { TryBranch<T, R> branch(); };
/** 移动拥有值后拆分传播值。 */
interface TryMove<T, R> { TryBranch<T, R> intoBranch(); };
/** 编译期静态接收协议，F 必须是实现类型自身。 */
interface FromResidual<F, R> { static F fromResidual(R residual); };

enum Option<T> : Try<T, NoneResidual>, TryMove<T, NoneResidual>, FromResidual<Option<T>, NoneResidual> {
    Value(T value), None;

    TryBranch<T, NoneResidual> branch() {
        match (self) {
            Option<T>::Value(value) => { return TryBranch<T, NoneResidual>::Continue(value); }
            Option<T>::None => { return TryBranch<T, NoneResidual>::Break(NoneResidual::None); }
        }
    }
    TryBranch<T, NoneResidual> intoBranch() {
        if (self.isValue()) { return TryBranch<T, NoneResidual>::Continue(self.take()); }
        return TryBranch<T, NoneResidual>::Break(NoneResidual::None);
    }
    static Option<T> fromResidual(NoneResidual residual) { return Option<T>::None; }
    bool isValue() {
        bool result = false;
        match (self) {
            Option<T>::Value(value) => { result = true; }
            Option<T>::None => { result = false; }
        }
        return result;
    }

    bool isNone() { return !self.isValue(); }

    /** 转移整个结果并取出成功载荷；源结果随后不可使用。 */
    T take() {
        return {
            match (move self) {
                Option<T>::Value(value) => { yield value; }
                Option<T>::None => { std::lang::panic("called take() without a value"); }
            }
            loop { std::lang::panic("called take() without a value"); };
        };
    }

    T unwrap() {
        T result;
        match (self) {
            Option<T>::Value(value) => { result = value; }
            Option<T>::None => { std::lang::panic("called Option.unwrap() on None"); }
        }
        return result;
    }

    T unwrapOr(T fallback) {
        T result = fallback;
        match (self) {
            Option<T>::Value(value) => { result = value; }
            Option<T>::None => { }
        }
        return result;
    }

    T expect(std::lang::String message) {
        T result;
        match (self) {
            Option<T>::Value(value) => { result = value; }
            Option<T>::None => { std::lang::panic(message); }
        }
        return result;
    }

    Option<T> transform(T fn(T) mapper) {
        Option<T> result = Option<T>::None;
        match (self) {
            Option<T>::Value(value) => { result = Option<T>::Value(mapper(value)); }
            Option<T>::None => { }
        }
        return result;
    }

    Option<T> andThen(Option<T> fn(T) mapper) {
        Option<T> result = Option<T>::None;
        match (self) {
            Option<T>::Value(value) => { result = mapper(value); }
            Option<T>::None => { }
        }
        return result;
    }
};

/**
 * @brief 读映射里键对应的值：有就给出 `Value`，没有就给出 `None`（不像下标那样报错）。
 */
Option<V> __mapGetOptionImpl<K,V>(std::lang::Map<K,V> const& source, K key) {
    if (source.has(key)==0) { return Option<V>::None; }
    return Option<V>::Value(source[key]);
}

enum Result<T, E> : Try<T, ErrorResidual<E>>, TryMove<T, ErrorResidual<E>>, FromResidual<Result<T, E>, ErrorResidual<E>> {
    Ok(T value), Err(E error);

    TryBranch<T, ErrorResidual<E>> branch() {
        match (self) {
            Result<T,E>::Ok(value) => { return TryBranch<T,ErrorResidual<E>>::Continue(value); }
            Result<T,E>::Err(error) => {
                ErrorResidual<E> residual;
                residual.error = error;
                return TryBranch<T,ErrorResidual<E>>::Break(residual);
            }
        }
    }
    TryBranch<T, ErrorResidual<E>> intoBranch() {
        if (self.isOk()) { return TryBranch<T, ErrorResidual<E>>::Continue(self.take()); }
        ErrorResidual<E> residual;
        residual.error = self.takeError();
        return TryBranch<T, ErrorResidual<E>>::Break(move residual);
    }
    static Result<T,E> fromResidual(ErrorResidual<E> residual) { return Result<T,E>::Err(move residual.error); }
    Option<T> ok() {
        match (self) {
            Result<T,E>::Ok(value) => { return Option<T>::Value(value); }
            Result<T,E>::Err(error) => { return Option<T>::None; }
        }
    }
    bool isOk() {
        bool result = false;
        match (self) {
            Result<T, E>::Ok(value) => { result = true; }
            Result<T, E>::Err(error) => { result = false; }
        }
        return result;
    }

    bool isErr() { return !self.isOk(); }

    /** 转移整个结果并取出成功载荷；源结果随后不可使用。 */
    T take() {
        return {
            match (move self) {
                Result<T, E>::Ok(value) => { yield value; }
                Result<T, E>::Err(error) => { std::lang::panic("called take() without a value"); }
            }
            loop { std::lang::panic("called take() without a value"); };
        };
    }

    T unwrap() {
        T result;
        match (self) {
            Result<T, E>::Ok(value) => { result = value; }
            Result<T, E>::Err(error) => { std::lang::panic("called Result.unwrap() on Err"); }
        }
        return result;
    }

    T unwrapOr(T fallback) {
        T result = fallback;
        match (self) {
            Result<T, E>::Ok(value) => { result = value; }
            Result<T, E>::Err(error) => { }
        }
        return result;
    }

    T expect(std::lang::String message) {
        T result;
        match (self) {
            Result<T, E>::Ok(value) => { result = value; }
            Result<T, E>::Err(error) => { std::lang::panic(message); }
        }
        return result;
    }

    /** 转移整个结果并取出错误载荷；源结果随后不可使用。 */
    E takeError() {
        return {
            match (move self) {
                Result<T, E>::Ok(value) => { std::lang::panic("called takeError() on Ok"); }
                Result<T, E>::Err(error) => { yield error; }
            }
            loop { std::lang::panic("called takeError() on Ok"); };
        };
    }

    E error() {
        E result;
        match (self) {
            Result<T, E>::Ok(value) => { std::lang::panic("called Result.error() on Ok"); }
            Result<T, E>::Err(error) => { result = error; }
        }
        return result;
    }

    Result<T, E> transform(T fn(T) mapper) {
        Result<T, E> result;
        match (self) {
            Result<T, E>::Ok(value) => { result = Result<T, E>::Ok(mapper(value)); }
            Result<T, E>::Err(error) => { result = Result<T, E>::Err(error); }
        }
        return result;
    }

    Result<T, E> andThen(Result<T, E> fn(T) mapper) {
        Result<T, E> result;
        match (self) {
            Result<T, E>::Ok(value) => { result = mapper(value); }
            Result<T, E>::Err(error) => { result = Result<T, E>::Err(error); }
        }
        return result;
    }
};

/**
 * @brief 自定义区间的有状态前进协议。
 * @note nextValue 从接收者的游标状态产生下一项并推进状态；到达终点后返回 None。
 */
interface NextValue<T> {
    /**
     * @brief 取得下一项，由实现判断边界并维护游标状态。
     * @param end 区间终点。
     * @param inclusive 是否包含终点。
     * @return 下一项，或表示遍历结束的 None。
     */
    Option<T> nextValue(T end, bool inclusive);
};

struct __ValueRange<T : NextValue<T>> : Iterator<T> {
    T cursor;
    T end;
    bool inclusive;

    /**
     * @brief 委托游标对象取得下一项。
     * @param index 外层迭代位置；游标对象自行保存前进状态。
     * @return 游标产生的下一项或 None。
     */
    Option<T> iterator(int64 index) {
        return self.cursor.nextValue(self.end, self.inclusive);
    }
};

/**
 * @brief 创建不包含终点的自定义类型区间。
 * @param start 独立保存的起始游标值。
 * @param end 交给前进协议判断的终点。
 * @return 拥有游标状态的区间值。
 */
__ValueRange<T> __customRange<T : NextValue<T>>(T start, T end) {
    __ValueRange<T> result;
    result.cursor = start;
    result.end = end;
    result.inclusive = false;
    return result;
}

/**
 * @brief 创建包含终点的自定义类型区间。
 * @param start 独立保存的起始游标值。
 * @param end 交给前进协议判断的终点。
 * @return 拥有游标状态的区间值。
 */
__ValueRange<T> __customRangeEq<T : NextValue<T>>(T start, T end) {
    __ValueRange<T> result;
    result.cursor = start;
    result.end = end;
    result.inclusive = true;
    return result;
}

struct Pair<K, V> {
    K first;
    V second;

    /**
     * @brief 从两个值复制构造键值对。
     * @param first 键或第一项。
     * @param second 值或第二项。
     * @return 拥有独立字段值的 Pair。
     */
    static Pair<K, V> create(K first, V second) {
        self.first = first;
        self.second = second;
    }

    /**
     * @brief 从二元组复制构造键值对。
     * @param value 提供 first 与 second 的两个值。
     * @return 拥有独立字段值的 Pair。
     */
    static Pair<K, V> create((K, V) value) {
        self.first = value.0;
        self.second = value.1;
    }

    /**
     * @brief 将键值对的两个字段复制为二元组。
     * @return 按 first、second 顺序保存独立值的二元组。
     */
    (K, V) toTuple() {
        return (self.first, self.second);
    }
};

/*
 * 系统断言宏：`$assert(condition)` / `$assert(condition, message)` 把**调用点**的行号
 * 喂给上面带 `int64 line` 的重载。`$line` 在宏展开的位置取值，所以拿到的是调用处那一
 * 行；限定名 `std::lang::assert` 不会被这个同名宏吃掉（`.name` / `::name` 不当宏调用）。
 *
 * 宏体保存完整语句；调用处也写分号，与其他语句宏保持一致。
 * 定义放在文件末尾：它上面那几行是 `assert` 函数自己的**定义**，不能被动到。
 */
$macro assert(condition)
std::lang::assert(condition, $line);
$end_macro

$macro assert(condition, message)
std::lang::assert(condition, message, $line);
$end_macro

/** @brief 判断盒子是否保存精确的 T 类型，不比较公开整数编号。 */
bool isType<T>(Any const& value) { return value.__isTypeTag(__typeTag(T)); }
/** @brief 类型匹配时复制拥有值；不匹配或空盒子返回 None。 */
Option<T> tryGet<T>(Any const& value) {
    if (!isType<T>(&value)) { return Option<T>::None; }
    T result = value.getValue();
    return Option<T>::Value(result);
}
/** @brief 安全借用只读值或兼容接口，引用不得超过盒子的寿命。 */
Option<T const&> tryGetReference<T>(Any const& value) {
    Option<T const&> result = value.getOptional();
    return result;
}
/** @brief 安全借用可写值或兼容接口，要求盒子可写。 */
Option<T mut&> tryGetMut<T>(Any mut& value) {
    Option<T mut&> result = value.getOptional();
    return result;
}

/** 按原始字节生成列表，不把字节位置解释为字符边界。 */
inline unsafe List<uint8> __stringBytes(int64 text) {
    List<uint8> result; int64 size=__bootStringLength(text);
    unsafe {
        int64 address=__stringStorageData(text); int64 i=0;
        while (i<size) { result.push((uint8)__bootStringByte(address,i)); i=i+1; }
    }
    return result;
}
/** 返回字符串的完整 UTF-8 字节副本，不执行字符边界索引。 */
List<uint8> stringBytes(String text) { unsafe { return __stringBytes(text.opcode); } }





/** 内部泛型方法标记，仅保留调用点显式给出的错误类型。 */
interface __chaliMapErr<F> {};
interface __chaliOkOr<E> {};
interface __chaliOkOrElse<E> {};
/** 裸指针 castTo<U>() 调用点的显式类型标记。 */
interface __chaliCastTo<U> {};
/** 显式映射失败载荷；成功分支不调用 mapper。 */
Result<T,F> __mapErrImpl<T,E,F>(Result<T,E> value, F fn(E) mapper) {
    match(value) {
        Result<T,E>::Ok(item) => { return Result<T,F>::Ok(item); }
        Result<T,E>::Err(error) => { return Result<T,F>::Err(mapper(error)); }
    }
}
/** 将缺失转换为指定错误，error 参数按普通调用规则求值。 */
Result<T,E> __okOrImpl<T,E>(Option<T> value, E error) {
    match(value) {
        Option<T>::Value(item) => { return Result<T,E>::Ok(item); }
        Option<T>::None => { return Result<T,E>::Err(error); }
    }
}
/** 只在缺失时调用错误工厂。 */
Result<T,E> __okOrElseImpl<T,E>(Option<T> value, E fn() factory) {
    match(value) {
        Option<T>::Value(item) => { return Result<T,E>::Ok(item); }
        Option<T>::None => { return Result<T,E>::Err(factory()); }
    }
}

/** 原始存储操作入口；仅 unsafe 函数／块可调用。 */
unsafe int64 __rawStorage(int64 operation, uint64 handle, int64 index, int64 value, int64 alignment, int64 typeTag);

/** 有元素类型及分配身份的原始指针；复制指针不复制元素，也不延长存储寿命。 */
struct RawPtr<T> {
    /** 对应原始存储的分配身份，不延长存储寿命。 */
    uint64 storage;
    /** 从零开始的槽位下标；解引用时检查有效范围与初始化状态。 */
    int64 index;
};

/** 只保存地址的裸指针；不记录运行时元素类型或初始化状态，也不拥有分配。 */
struct BarePtr<T>: Add<BarePtr<T>, int64>, RightAdd<BarePtr<T>, int64>, Subtract<BarePtr<T>, int64>, Subtract<int64, BarePtr<T>> {
    /** 运行时逻辑字节地址；不是可传给宿主 C 函数的机器地址。 */
    int64 address;

    /** 实现 p + elements；按静态元素大小偏移，不访问内存或检测运行时类型。 */
    BarePtr<T> leftAdd(int64 elements) {
        BarePtr<T> result;
        unsafe { result.address = self.address + elements * __rawSize(T); }
        return result;
    }
    /** 实现 elements + p，与 p + elements 相同。 */
    BarePtr<T> rightAdd(int64 elements) { return self.leftAdd(elements); }
    /** 实现 p - elements；按静态元素大小反向偏移。 */
    BarePtr<T> leftSub(int64 elements) {
        BarePtr<T> result;
        unsafe { result.address = self.address - elements * __rawSize(T); }
        return result;
    }
    /** 实现 p - other，返回完整元素距离；调用者保证属于同一分配。 */
    int64 leftSub(BarePtr<T> other) {
        int64 bytes = self.address - other.address;
        unsafe {
            std::lang::assert(bytes % __rawSize(T) == 0);
            return bytes / __rawSize(T);
        }
    }
};

/** 取得原始分配中的裸地址，允许未初始化及尾后位置，不检测元素类型。 */
unsafe BarePtr<T> barePointer<T>(RawPtr<T> pointer) {
    BarePtr<T> result;
    result.address = __rawStorage(6, pointer.storage, pointer.index, 0, 0, 0);
    return result;
}

/** 将数值字节地址解释为裸指针，不验证类型、初始化状态或可解引用性。 */
unsafe BarePtr<T> pointerFromAddress<T>(int64 address) {
    BarePtr<T> result;
    result.address = address;
    return result;
}

/** BarePtr.castTo<U>() 的语言实现：地址、分配身份和有效期保持不变。
 * 转换不检查元素类型、大小或初始化状态；解引用由调用者保证对齐及完整范围。 */
unsafe BarePtr<U> __pointerCast<T,U>(BarePtr<T> pointer) {
    BarePtr<U> result;
    result.address=pointer.address;
    return result;
}

/** 将裸地址解释为可变引用；调用者负责布局、对齐、初始化和所有权正确性。 */
unsafe T mut& dereference<T>(BarePtr<T> pointer) { return (T mut&)pointer.address; }

/** 按字节复制完整范围；不检测类型或处理资源所有权，非零范围必须有效且不重叠。
 * @param destination 目标逻辑地址。
 * @param source 源逻辑地址；可与目标使用不同静态元素类型。
 * @param bytes 复制的字节数，必须非负；零长度允许空指针。
 */
unsafe void memcpy<T,U>(BarePtr<T> destination, BarePtr<U> source, int64 bytes) {
    __rawStorage(7, (uint64)destination.address, source.address, bytes, 0, 0);
}

/** 按字节填充完整范围；不检测类型或清理旧值，调用者负责资源与初始化状态。
 * @param destination 目标逻辑地址。
 * @param value 重复写入的单个字节。
 * @param bytes 填充的字节数，必须非负；零长度允许空指针。
 */
unsafe void memset<T>(BarePtr<T> destination, uint8 value, int64 bytes) {
    __rawStorage(8, (uint64)destination.address, (int64)value, bytes, 0, 0);
}

/** 在原始槽位就地接管一个完整值，目标必须未初始化。 */
unsafe void initAt<T>(RawPtr<T> pointer, T value) {
    int64 address = __rawStorage(1, pointer.storage, pointer.index, 0, 0, __typeTag(T));
    T mut& target = (T mut&)address;
    *target = move(value);
    __rawStorage(2, pointer.storage, pointer.index, 1, 0, __typeTag(T));
}

/** 从已初始化槽位取得独立副本；需要调用方保证指针与存储寿命有效。 */
unsafe T readAt<T>(RawPtr<T> pointer) {
    int64 address = __rawStorage(1, pointer.storage, pointer.index, 1, 0, __typeTag(T));
    T mut& source = (T mut&)address;
    return *source;
}

/** 借出已初始化元素；调用方必须保证引用不超过原始存储的有效寿命。 */
unsafe T mut& borrowAt<T>(RawPtr<T> pointer) {
    return (T mut&)__rawStorage(1, pointer.storage, pointer.index, 1, 0, __typeTag(T));
}

/** 移出已初始化槽位；成功后原槽位不再持有元素。 */
unsafe T takeAt<T>(RawPtr<T> pointer) {
    int64 address = __rawStorage(1, pointer.storage, pointer.index, 1, 0, __typeTag(T));
    T mut& source = (T mut&)address;
    T result = move(source);
    __rawStorage(2, pointer.storage, pointer.index, 0, 0, __typeTag(T));
    return move(result);
}

/** 清理恰好一个已初始化元素，保留原始容量。 */
unsafe void dropAt<T>(RawPtr<T> pointer) {
    T discarded = takeAt(pointer);
}

/** 验证移动范围后逐元素转移所有权，目标范围必须全部未初始化且不重叠。 */
unsafe void relocateNonOverlapping<T>(RawPtr<T> destination, RawPtr<T> source, int64 count) {
    std::lang::assert(count >= 0);
    if (count == 0) { return; }
    int64 sourceCapacity = __rawStorage(4, source.storage, 0, 0, 0, __typeTag(T));
    int64 destinationCapacity = __rawStorage(4, destination.storage, 0, 0, 0, __typeTag(T));
    std::lang::assert(source.index >= 0 && source.index <= sourceCapacity && count <= sourceCapacity - source.index);
    std::lang::assert(destination.index >= 0 && destination.index <= destinationCapacity && count <= destinationCapacity - destination.index);
    std::lang::assert(source.storage != destination.storage || destination.index >= source.index + count || source.index >= destination.index + count);
    int64 i = 0;
    while (i < count) {
        __rawStorage(1, source.storage, source.index + i, 1, 0, __typeTag(T));
        __rawStorage(1, destination.storage, destination.index + i, 0, 0, __typeTag(T));
        i = i + 1;
    }
    i = 0;
    while (i < count) {
        RawPtr<T> from;
        from.storage = source.storage;
        from.index = source.index + i;
        RawPtr<T> to;
        to.storage = destination.storage;
        to.index = destination.index + i;
        initAt(to, takeAt(from));
        i = i + 1;
    }
}

/** 独占原始容量；备用槽位不默认构造 T，关闭时仅清理已初始化元素。 */
struct RawStorage<T>: Closeable {
    /** 当前独占的原始存储句柄，零表示尚未分配或已经关闭。 */
    uint64 handle;

    static RawStorage<T> allocate(int64 capacity) {
        unsafe {
            RawStorage<T> result;
            result.handle = (uint64)__rawStorage(0, 0u, capacity, __rawSize(T), __rawAlign(T), __typeTag(T));
            return move(result);
        }
    }

    int64 capacity() {
        if (self.handle == 0u) { return 0; }
        unsafe { return __rawStorage(4, self.handle, 0, 0, 0, __typeTag(T)); }
    }

    RawPtr<T> pointer(int64 index) {
        std::lang::assert(self.handle != 0u && index >= 0 && index <= self.capacity());
        RawPtr<T> result;
        result.storage = self.handle;
        result.index = index;
        return result;
    }

    bool isInitialized(int64 index) {
        unsafe { return __rawStorage(3, self.handle, index, 0, 0, __typeTag(T)) != 0; }
    }

    void close() {
        if (self.handle == 0u) { return; }
        unsafe {
            int64 capacity = __rawStorage(4, self.handle, 0, 0, 0, __typeTag(T));
            if (__rawStorage(9, self.handle, 0, 0, 0, __typeTag(T)) != 0) {
                int64 i = 0;
                while (i < capacity) {
                    if (__rawStorage(3, self.handle, i, 0, 0, __typeTag(T)) != 0) { dropAt(self.pointer(i)); }
                    i = i + 1;
                }
            }
            __rawStorage(5, self.handle, 0, 0, 0, __typeTag(T));
            self.handle = 0u;
        }
    }
};

/** 自举集合的原始槽访问边界；算法在下方 ChaLi 函数中执行。 */
unsafe int64 __listStorageGuard(int64 handle,int64 operation,int64 index);
unsafe int64 __listStorageCapacity(int64 handle);
unsafe int64 __listStorageReserve(int64 handle,int64 capacity);
unsafe int64 __listStorageSwap(int64 handle,int64 left,int64 right);
unsafe int64 __listStorageDiscard(int64 handle);
unsafe int64 __listStorageCloneAppend(int64 destination,int64 source,int64 index);
unsafe int64 __listStorageNew();
unsafe int64 __listStorageLength(int64 handle);

/** 计算有界几何增长容量；先验证 len+need，接近上限时不让倍增溢出。
 * 空间足够时原样返回 cap，否则一次满足本次需求；不分配或清理元素。
 */
int64 __bootBufferCapacity(int64 length,int64 need,int64 capacity,int64 minimum,int64 maximum) {
    if(!(length>=0 && need>=0 && capacity>=length && minimum>=0 && maximum>=minimum && capacity<=maximum)){panic("缓冲区容量参数无效");}
    if(need>maximum-length){panic("缓冲区容量超出上限");}
    int64 required=length+need;
    if(required<=capacity){return capacity;}
    int64 grown=maximum;
    if(capacity<=maximum/2){grown=capacity*2;}
    if(grown<required){grown=required;}
    if(grown<minimum){grown=minimum;}
    return grown;
}
unsafe int64 __listStorageMaxCapacity(int64 handle);
/** 按本次需求和分配器上限预留槽，不初始化尚未加入的用户元素。 */
unsafe void __bootListReserve(int64 handle,int64 requested){
    int64 capacity=__listStorageCapacity(handle);
    if(requested<=capacity){return;}
    int64 maximum=__listStorageMaxCapacity(handle);
    int64 minimum=8;if(minimum>maximum){minimum=maximum;}
    __listStorageReserve(handle,__bootBufferCapacity(0,requested,capacity,minimum,maximum));
}
/** 按逻辑下标向左移动元素，清理末尾并保留容量。 */
inline unsafe int64 __bootListRemove(int64 handle,int64 index){
    int64 size=__listStorageGuard(handle,2,index);int64 i=index;
    while(i+1<size){__listStorageSwap(handle,i,i+1);i=i+1;}
    __listStorageDiscard(handle);return 0;
}
/** 清理有效槽位，保留已分配容量。 */
inline unsafe int64 __bootListClear(int64 handle){
    int64 size=__listStorageGuard(handle,4,0);
    while(size>0){__listStorageDiscard(handle);size=size-1;}return 0;
}
/** 按槽复制独立拥有值，存储内核负责单个值的所有权封送。 */
inline unsafe int64 __bootListCopy(int64 source){
    int64 result=__listStorageNew();int64 size=__listStorageLength(source);__bootListReserve(result,size);
    int64 i=0;while(i<size){__listStorageCloneAppend(result,source,i);i=i+1;}return result;
}

unsafe int64 __listStorageAppendI(int64 handle,int64 value,int64 text,int64 layout);
unsafe int64 __listStorageTakeI(int64 handle,int64 text,int64 layout);
unsafe int64 __listStorageEqualI(int64 handle,int64 index,int64 value,int64 text,int64 layout);
/** 在语言中选择增长策略并追加一个值。 */
unsafe int64 __bootListPushI(int64 handle,int64 value,int64 text,int64 layout){
    int64 size=__listStorageGuard(handle,0,0);__bootListReserve(handle,size+1);
    return __listStorageAppendI(handle,value,text,layout);
}
/** 先构造新槽，再以相邻槽交换将其移入目标位置。 */
inline unsafe int64 __bootListInsertI(int64 handle,int64 index,int64 value,int64 text,int64 layout){
    int64 size=__listStorageGuard(handle,1,index);__bootListReserve(handle,size+1);
    __listStorageAppendI(handle,value,text,layout);
    int64 i=size;while(i>index){__listStorageSwap(handle,i,i-1);i=i-1;}return 0;
}
/** 移出末尾槽；空表在结构验证处报告错误。 */
inline unsafe int64 __bootListPopI(int64 handle,int64 text,int64 layout){
    __listStorageGuard(handle,3,0);return __listStorageTakeI(handle,text,layout);
}
/** 遍历有效槽，返回首个相同值的下标。 */
unsafe int64 __bootListFindI(int64 handle,int64 value,int64 text,int64 layout){
    int64 size=__listStorageLength(handle);int64 i=0;
    while(i<size){if(__listStorageEqualI(handle,i,value,text,layout)!=0){return i;}i=i+1;}return 0-1;
}

