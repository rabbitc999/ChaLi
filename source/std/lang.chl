    __bootMapGrow(handle); int64 entry=__setStorageAppendI(handle,key,text,layout,hash);
    if (__mapStorageState(handle,1,0,0)>0) { __bootMapPlace(handle,entry,hash); }
    __mapStorageState(handle,6,0,0); return 0;
}

