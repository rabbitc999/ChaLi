unsafe int64 __stringStorageLength(int64 address);
unsafe int64 __stringStorageData(int64 address);
unsafe int64 __stringStorageCapacity(int64 address);
unsafe int64 __stringStorageKind(int64 address);
unsafe int64 __bufferMaxBytes();
unsafe int64 __stringRelease(int64 address);
unsafe String __stringAdopt(int64 address);
/** 读取字符串存储的长度元数据，字面量由存储边界识别。 */
inline unsafe int64 __bootStringLength(int64 address) {
    return __stringStorageLength(address);
}
/** 直接消费 byteAt 的 Value，不物化 Option；越界沿用 unwrap 的 None 诊断。 */
inline unsafe uint8 __bootStringByteAtUnwrap(int64 address,int64 index) {
    if(index<0 || index>=__bootStringLength(address)){
        panic("called Option.unwrap() on None");
    }
    return (uint8)__bootStringByte(__stringStorageData(address),index);
}
/** 读取自举构造的容量描述符中的数据地址，不经过宿主分派。 */
unsafe int64 __bootStringOwnedData(int64 address) {
    int64 mut& data=(int64 mut&)(address+24);return *data;
}
/** 构造稳定容量描述符；十六字节以内的初始缓冲区与描述符共块。 */
unsafe int64 __bootStringBuffer(int64 length) {
    if(length<0){panic("String：结果过长");}
    int64 maximum=__bufferMaxBytes();if(maximum<49){panic("String：分配上限不足");}maximum=maximum-1;
    int64 requested=length;if(requested==0){requested=1;}
    int64 capacity=__bootBufferCapacity(0,requested,0,16,maximum);
    int64 bytes=32;if(capacity<=16){bytes=49;}
    int64 result=__stringAllocate(bytes);int64 data=result+32;
    if(capacity>16){data=__stringAllocate(capacity+1);}
    int64 mut& marker=(int64 mut&)result;*marker=0-1;
    int64 mut& size=(int64 mut&)(result+8);*size=length;
    int64 mut& cap=(int64 mut&)(result+16);*cap=capacity;
    int64 mut& buffer=(int64 mut&)(result+24);*buffer=data;
    uint8 mut& zero=(uint8 mut&)(data+length);*zero=0u;
    return result;
}
/** 将裸地址直接交给 LLVM 字节复制原语，不构造临时指针包装。 */
inline unsafe void __bootStringCopyBytes(int64 destination,int64 source,int64 length) {
    if (length>0) { memcpy(destination,source,length); }
}
/** 构造独立空字符串。 */
unsafe int64 __bootStringNew() { return __bootStringBuffer(0); }
/** 一次分配取得独立副本。 */
inline unsafe int64 __bootStringCopy(int64 source) {
    int64 length=__bootStringLength(source); int64 result=__bootStringBuffer(length);
    __bootStringCopyBytes(__bootStringOwnedData(result),__stringStorageData(source),length); return result;
}
/** 归还拥有的字符串存储。 */
unsafe int64 __bootStringDrop(int64 address) {
    if(__stringStorageKind(address)!=0){
        int64 data=__bootStringOwnedData(address);
        if(data!=address+32){__stringRelease(data);}
    }
    return __stringRelease(address);
}
/** 为原值预留容量，只在扩容时回收旧的外置块，不复制拥有者。 */
inline unsafe void __bootStringReserve(int64 address,int64 requested) {
    if(requested<0){panic("String：容量不能为负数");}
    if(__stringStorageKind(address)==0){panic("String：修改需要拥有型缓冲区");}
    int64 mut& cap=(int64 mut&)(address+16);int64 capacity=*cap;
    if(requested<=capacity){return;}
    int64 mut& size=(int64 mut&)(address+8);int64 length=*size;
    int64 maximum=__bufferMaxBytes()-1;
    int64 grown=__bootBufferCapacity(length,requested-length,capacity,16,maximum);
    int64 data=__stringAllocate(grown+1);int64 old=__bootStringOwnedData(address);
    __bootStringCopyBytes(data,old,length);uint8 mut& zero=(uint8 mut&)(data+length);*zero=0u;
    if(old!=address+32){__stringRelease(old);}
    int64 mut& pointer=(int64 mut&)(address+24);*pointer=data;*cap=grown;
}
/** 原地追加字节，先扩容再重新取得源地址，允许向自身追加。 */
inline unsafe void __bootStringAppend(int64 address,int64 source) {
    int64 length=__bootStringLength(address);int64 need=__bootStringLength(source);
    int64 required=__bootStringAddLength(length,need);
    __bootStringReserve(address,required);
    int64 data=__bootStringOwnedData(address);
    __bootStringCopyBytes(data+length,__stringStorageData(source),need);
    uint8 mut& zero=(uint8 mut&)(data+required);*zero=0u;
    int64 mut& size=(int64 mut&)(address+8);*size=required;
