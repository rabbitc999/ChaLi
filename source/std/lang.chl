    return result;
}
/** 变换直接写入独立结果区，不经宿主字符串算法。 */
inline unsafe String __stringTransform(int64 text,int64 first,int64 second,int64 operation,int64 offset,int64 count) {
    int64 n=__bootStringLength(text); int64 firstLength=__bootStringLength(first); int64 sn=__bootStringLength(second);
    int64 a=0; int64 b=0; int64 c=0;
