/** 验证边界顺序后返回独立拥有值。 */
inline unsafe float64 __bootListClampF(int64 source,float64 value,int64 text,int64 layout) {
    if (__listStorageLength(source)!=2) { panic("std::lang::algorithms::clamp 的边界胶水需要 low/high 两项"); }
    if (__listStorageCompareIndex(source,1,0)<0) { panic("std::lang::algorithms::clamp 要求 low <= high"); }
    if (__listStorageCompareF(source,0,value,text,layout)>0) { return __listStorageReadF(source,0,text,layout); }
    if (__listStorageCompareF(source,1,value,text,layout)<0) { return __listStorageReadF(source,1,text,layout); }
    return __listStorageCloneF(value,text,layout);
}

/** 编译器按元素类型实例化后降低为单槽比较和交换。 */
int64 __algorithmCompareIndices<T>(List<T> source,int64 left,int64 right);
void __algorithmSwap<T>(List<T> mut& values,int64 left,int64 right);

/** 合并两段索引；比较只读取原值，相等时先取左段以保持稳定。 */
void __bootAlgorithmMerge<T>(List<T> source,int64 const& input,int64 mut& output,int64 count,int64 width) {
    int64 left=0;
    while (left<count) {
        int64 middle=count; if (width<count-left) { middle=left+width; }
        int64 end=count; if (width<count-middle) { end=middle+width; }
        int64 first=left; int64 second=middle; int64 at=left;
        while (first<middle && second<end) {
            if (__algorithmCompareIndices<T>(source,input[second],input[first])<0) { output[at]=input[second]; second=second+1; }
            else { output[at]=input[first]; first=first+1; }
            at=at+1;
        }
        while (first<middle) { output[at]=input[first]; first=first+1; at=at+1; }
        while (second<end) { output[at]=input[second]; second=second+1; at=at+1; }
        left=end;
    }
}
/** 按原位置到目标位置的置换交换槽位，不复制用户元素。 */
void __bootAlgorithmPermute<T>(List<T> mut& values,int64 mut& positions,int64 count) {
    int64 i=0;
    while (i<count) {
        while (positions[i]!=i) {
            int64 target=positions[i]; __algorithmSwap<T>(values,i,target);
            int64 previous=positions[target]; positions[target]=positions[i]; positions[i]=previous;
        }
        i=i+1;
    }
}
/** 稳定排序只复制一次输入值，辅助区仅存两组整数索引。 */
List<T> __bootAlgorithmSort<T>(List<T> source) {
    List<T> result=source; int64 size=result.len();
    if (size<2) { return result; }
    int64 order[]=new[size]; int64 scratch[]=new[size]; int64 i=0;
    while (i<size) { order[i]=i; i=i+1; }
    bool inScratch=false; int64 width=1;
    while (width<size) {
        if (inScratch) { __bootAlgorithmMerge<T>(result,&scratch[0],&order[0],size,width); }
        else { __bootAlgorithmMerge<T>(result,&order[0],&scratch[0],size,width); }
        inScratch=!inScratch; if (width>size/2) { break; } width=width*2;
    }
    i=0;
    if (inScratch) {
        while (i<size) { order[scratch[i]]=i; i=i+1; }
        __bootAlgorithmPermute<T>(&result,&order[0],size);
    }
    else {
        while (i<size) { scratch[order[i]]=i; i=i+1; }
        __bootAlgorithmPermute<T>(&result,&scratch[0],size);
    }
    return result;
}
