    while (i<size) { if (__listStorageEqualF(source,i,value,text,layout)!=0) { count=count+1; } i=i+1; }
    return count;
}
/** lower_bound 保留相等元素的首个位置。 */
inline unsafe int64 __bootListBinarySearchF(int64 source,float64 value,int64 text,int64 layout) {
    int64 low=0; int64 high=__listStorageLength(source); int64 size=high;
