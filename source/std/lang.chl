unsafe int64 __setStorageAppendI(int64 handle,int64 key,int64 text,int64 layout,int64 hash);
/** 先比较缓存 HashKey，再调用精确键比较；空槽终止探测。 */
inline unsafe int64 __bootMapFindI(int64 handle,int64 key,int64 text,int64 layout,int64 hash) {
    __bootMapEnsure(handle); int64 capacity=__mapStorageState(handle,1,0,0);
    if (capacity==0) {
        int64 size=__mapStorageState(handle,0,0,0); int64 i=0;
        while (i<size) { if (__mapStorageMatchI(handle,i,key,text,layout)!=0) { return i; } i=i+1; }
        return 0-1;
    }
    int64 slot=__bootMapHome(hash,capacity); int64 visited=0;
    while (visited<capacity) {
        int64 entry=__bootMapSlot(handle,slot); if (entry==0) { return 0-1; } entry=entry-1;
        if (__mapStorageState(handle,7,entry,0)==hash && __mapStorageMatchI(handle,entry,key,text,layout)!=0) { return entry; }
        slot=(slot+1)%capacity; visited=visited+1;
    }
    return 0-1;
}
/** 查询只产生一个 Hash 值，不构造 Option 或中间键值容器。 */
inline unsafe int64 __bootMapHasI(int64 handle,int64 key,int64 text,int64 layout) {
    int64 hash=__mapStorageHashI(handle,key,text,layout);
    if (__bootMapFindI(handle,key,text,layout,hash)>=0) { return 1; } return 0;
}
/** 查找后移除一个项，命中时返回一。 */
inline unsafe int64 __bootMapRemoveI(int64 handle,int64 key,int64 text,int64 layout) {
    int64 hash=__mapStorageHashI(handle,key,text,layout);
    int64 entry=__bootMapFindI(handle,key,text,layout,hash);
    if (entry<0) { return 0; } __bootMapErase(handle,entry,hash); return 1;
}
/** Set 使用自己的槽数组，重复插入不复制用户元素。 */
