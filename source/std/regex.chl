module std::regex;

/* 从 core.chl 原样迁出：符号名不变，只换了模块归属（现在必须 `import std::regex;` 才能用）。 */
/* 复制共享不可变编译模式；匹配状态属于每次调用，最后一个值释放时回收模式。 */
enum RegexError : Error {
    Invalid;

    /** 返回具体错误原因，并保留载荷中的位置或宿主诊断。 */
    String toString() {
        match (self) {
            RegexError::Invalid => { return "正则表达式无效"; }
        }
    }
};

Regex __regexCompileHandle(std::core::String pattern);
bool __regexFullMatch(int64 handle, std::core::String text);
bool __regexContains(int64 handle, std::core::String text);
int64 __regexFindByteIndex(int64 handle, std::core::String text);
std::core::String __regexCapture(int64 handle, std::core::String text, int64 group);
std::core::String __regexReplaceFirst(int64 handle, std::core::String text, std::core::String replacement);
std::core::String __regexReplaceAll(int64 handle, std::core::String text, std::core::String replacement);

int64 __regexNew();
int64 __regexCopy(int64 handle);
void __regexDrop(int64 handle);
bool __regexValid(int64 handle);

opcode Regex {
    new = std::regex::__regexNew;
    copy = std::regex::__regexCopy;
    drop = std::regex::__regexDrop;

    static Result<Regex, std::core::Error> compile(std::core::String pattern) {
        Regex value = __regexCompileHandle(pattern);
        if (!__regexValid(value.opcode)) { return Result<Regex, std::core::Error>::Err(RegexError::Invalid); }
        return Result<Regex, std::core::Error>::Ok(move value);
    }

    bool fullMatch(std::core::String text) { return __regexFullMatch(self.opcode, text); }
    bool contains(std::core::String text) { return __regexContains(self.opcode, text); }
    Option<int64> find(std::core::String text) {
        int64 index = __regexFindByteIndex(self.opcode, text);
        if (index < 0) { return Option<int64>::None; }
        return Option<int64>::Value(index);
    }
    std::core::String capture(std::core::String text, int64 group) {
        return __regexCapture(self.opcode, text, group);
    }
    std::core::String replaceFirst(std::core::String text, std::core::String replacement) {
        return __regexReplaceFirst(self.opcode, text, replacement);
    }
    std::core::String replaceAll(std::core::String text, std::core::String replacement) {
        return __regexReplaceAll(self.opcode, text, replacement);
    }
};
