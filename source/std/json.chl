module std::json;

import std::reflect;
import std::parse;

/** 结构化 JSON 编码协议；配套的成员宏可生成静态解码入口。 */
interface Json {
    /** 将当前值编码为 JSON；失败返回统一 Error，具体字段格式由实现决定。 */
    Result<String,Error> toJson();
};

/** 实现 JSON 协议的结构体字段名称与忽略规则；空名称沿用字段名。 */
@annotation Field(name:String="",skip:bool=false)

/** 为具体类型 T 生成实例编码方法和静态解码方法。两个名称由调用者指定，编解码使用反射并返回 Result。 */
$macro Json<T>(encode:ident, decode:ident) -> member
$implement std::json::Json;
Result<String,Error> encode() {
    return serialize<T>(&self);
}
static Result<T,Error> decode(String text) {
    return deserialize<T>(text);
}
$end_macro

/** 将已暴露给反射的值编码为 JSON，数字和字段类型保持精确。 */
Result<String,Error> serialize<T>(T const& value) {
    requireReflection();
    let result = std::reflect::__serializeJson<T>(value);
    if (result.isErr()) { return Result<String,Error>::Err(result.error()); }
    return Result<String,Error>::Ok(result.unwrap());
}
/** 按具体类型验证并恢复拥有独立存储的值。 */
Result<T,Error> deserialize<T>(String text) {
    requireReflection();
    let result = std::reflect::__deserializeJson<T>(text);
    if (result.isErr()) { return Result<T,Error>::Err(result.error()); }
    return Result<T,Error>::Ok(result.take());
}

__JsonValueStorage __parse(String text);
bool __valid(int64 document);
String __takeError(int64 document);
bool __close(int64 document);
int64 __kind(int64 document, int64 node);
int64 __size(int64 document, int64 node);
int64 __int(int64 document, int64 node);
float64 __float(int64 document, int64 node);
bool __bool(int64 document, int64 node);
bool __textAvailable(int64 document, int64 node);
String __string(int64 document, int64 node);
List<uint8> __bytes(int64 document, int64 node);
String __dateTime(int64 document, int64 node);
String __dump(int64 document, int64 node);
__JsonValueStorage __find(int64 document, int64 node, String key);
__JsonValueStorage __findBytes(int64 document, int64 node, List<uint8> key);
__JsonValueStorage __at(int64 document, int64 node, int64 index);
bool __keyAvailable(int64 document, int64 node, int64 index);
String __key(int64 document, int64 node, int64 index);
List<uint8> __keyBytes(int64 document, int64 node, int64 index);

int64 __valueNew();
int64 __valueCopy(int64 handle);
void __valueDrop(int64 handle);
opcode __JsonValueStorage {
    new = std::json::__valueNew;
    copy = std::json::__valueCopy;
    drop = std::json::__valueDrop;
};

/** 拥有独立子树的值；复制深复制，关闭只影响当前值。 */
struct JsonValue : Iterator<JsonValue> {
    __JsonValueStorage __storage;
    /** 检查当前值是否有效。 */
    bool isValid() { return __valid(self.__storage.opcode); }
    /** 关闭当前值；副本与已提取的子值继续有效，重复关闭返回 false。 */
    bool close() { return __close(self.__storage.opcode); }
    int64 kind() { return __kind(self.__storage.opcode, 0); }
    bool isNull() { return self.kind() == 0; }
    bool isBool() { return self.kind() == 1; }
    bool isInt() { return self.kind() == 2; }
    bool isFloat() { return self.kind() == 3; }
    bool isString() { return self.kind() == 4; }
    bool isArray() { return self.kind() == 5; }
    bool isObject() { return self.kind() == 6; }
    bool isTable() { return self.isObject(); }
    bool isDateTime() { return self.kind() == 7; }
    /** 数组元素数或对象成员数，标量为零。 */
    int64 len() { return __size(self.__storage.opcode, 0); }
    Option<int64> asInt() {
        if (!self.isInt()) { return Option<int64>::None; }
        return Option<int64>::Value(__int(self.__storage.opcode, 0));
    }
    Option<float64> asFloat64() {
        if (!self.isInt() && !self.isFloat()) { return Option<float64>::None; }
        return Option<float64>::Value(__float(self.__storage.opcode, 0));
    }
    Option<bool> asBool() {
        if (!self.isBool()) { return Option<bool>::None; }
        return Option<bool>::Value(__bool(self.__storage.opcode, 0));
    }
    /** 非字符串或含零字节时返回 None；含零字节的文本使用 asBytes。 */
    Option<String> asString() {
        if (!__textAvailable(self.__storage.opcode, 0)) { return Option<String>::None; }
        String result = __string(self.__storage.opcode, 0);
        return Option<String>::Value(result);
    }
    Option<List<uint8>> asBytes() {
        if (!self.isString()) { return Option<List<uint8>>::None; }
        List<uint8> result = __bytes(self.__storage.opcode, 0);
        return Option<List<uint8>>::Value(result);
    }
    Option<String> asDateTime() {
        if (!self.isDateTime()) { return Option<String>::None; }
        String result = __dateTime(self.__storage.opcode, 0);
        return Option<String>::Value(result);
    }
    Option<JsonValue> find(String key) {
        __JsonValueStorage child = __find(self.__storage.opcode, 0, key);
        if (!__valid(child.opcode)) { return Option<JsonValue>::None; }
        JsonValue value; value.__storage = move child;
        return Option<JsonValue>::Value(move value);
    }
    /** 允许包含零字节的 UTF-8 键名。 */
    Option<JsonValue> findBytes(List<uint8> key) {
        __JsonValueStorage child = __findBytes(self.__storage.opcode, 0, key);
        if (!__valid(child.opcode)) { return Option<JsonValue>::None; }
        JsonValue value; value.__storage = move child;
        return Option<JsonValue>::Value(move value);
    }
    /** 数组按索引读取；对象按插入顺序读取成员值。 */
    Option<JsonValue> at(int64 index) {
        __JsonValueStorage child = __at(self.__storage.opcode, 0, index);
        if (!__valid(child.opcode)) { return Option<JsonValue>::None; }
        JsonValue value; value.__storage = move child;
        return Option<JsonValue>::Value(move value);
    }
    Option<JsonValue> iterator(int64 index) { return self.at(index); }
    /** 对象成员的键名；越界或键中含零字节时返回 None。 */
    Option<String> keyAt(int64 index) {
        if (!__keyAvailable(self.__storage.opcode, 0, index)) { return Option<String>::None; }
        String result = __key(self.__storage.opcode, 0, index);
        return Option<String>::Value(result);
    }
    Option<List<uint8>> keyBytesAt(int64 index) {
        if (!self.isObject() || index < 0 || index >= self.len()) { return Option<List<uint8>>::None; }
        List<uint8> result = __keyBytes(self.__storage.opcode, 0, index);
        return Option<List<uint8>>::Value(result);
    }
    String dump() { return __dump(self.__storage.opcode, 0); }
};

/** 解析文本；失败返回包含行列信息的诊断。 */
Result<JsonValue, Error> parse(String text) {
    __JsonValueStorage handle = __parse(text);
    if (!__valid(handle.opcode)) { String message = __takeError(handle.opcode); return Result<JsonValue, Error>::Err(MessageError::from(message)); }
    JsonValue value; value.__storage = move handle;
    return Result<JsonValue, Error>::Ok(move value);
}
