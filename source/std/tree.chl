module std::tree;

/** 独立节点快照；空孩子和空根使用 -1，节点槽号保持稳定。 */
struct TreeSnapshot { List<int64> keys; List<int64> lefts; List<int64> rights; List<int64> live; int64 root; int64 count; };
/** 首孩子、次兄弟表示的独立通用树快照。 */
struct GeneralTreeSnapshot { List<int64> values; List<int64> firstChild; List<int64> nextSibling; List<int64> live; int64 root; int64 count; };

/** ChaLi 二叉节点存储；内部节点号为槽号加一，零为空节点。 */
struct __BinaryNodes {
    List<int64> keys; List<int64> left; List<int64> right; List<int64> parent;
    List<int64> color; List<int64> live; List<int64> free;
    int64 root; int64 count;
    /** 分配或复用节点槽。 */
    int64 allocate(int64 key) {
        int64 i = self.keys.len();
        if (self.free.len() > 0) { i = self.free.pop(); }
        else { self.keys.push(0); self.left.push(0); self.right.push(0); self.parent.push(0); self.color.push(0); self.live.push(0); }
        self.keys[i] = key; self.left[i] = 0; self.right[i] = 0; self.parent[i] = 0;
        self.color[i] = 1; self.live[i] = 1; self.count = self.count + 1;
        return i + 1;
    }
    /** 回收已摘除节点槽。 */
    void release(int64 node) { self.live[node-1] = 0; self.free.push(node-1); self.count = self.count - 1; }
    /** 判断节点号是否有效。 */
    bool valid(int64 node) { return node > 0 && node <= self.keys.len() && self.live[node-1] != 0; }
    /** 读取颜色，空节点恒为黑色。 */
    bool red(int64 node) { return node != 0 && self.color[node-1] != 0; }
    /** 设置有效节点颜色。 */
    void paint(int64 node, bool red) { if(node != 0) { if(red) { self.color[node-1]=1; } else { self.color[node-1]=0; } } }
    /** 查找键，未命中返回零。 */
    int64 find(int64 key) {
        int64 node=self.root;
        while(node!=0) { int64 value=self.keys[node-1]; if(key==value){return node;} if(key<value){node=self.left[node-1];}else{node=self.right[node-1];} }
        return 0;
    }
    /** 返回子树最左节点。 */
    int64 minimum(int64 node) { while(node!=0 && self.left[node-1]!=0){node=self.left[node-1];} return node; }
    /** 返回子树最右节点。 */
    int64 maximum(int64 node) { while(node!=0 && self.right[node-1]!=0){node=self.right[node-1];} return node; }
    /** 用子树 replacement 替换 node，不改变 replacement 的孩子。 */
    void transplant(int64 node,int64 replacement) {
        int64 parent=self.parent[node-1];
        if(parent==0){self.root=replacement;} elif(node==self.left[parent-1]){self.left[parent-1]=replacement;} else{self.right[parent-1]=replacement;}
        if(replacement!=0){self.parent[replacement-1]=parent;}
    }
    /** 左旋，维持根和父子连接。 */
    void rotateLeft(int64 x) {
        int64 y=self.right[x-1]; int64 child=self.left[y-1];
        self.right[x-1]=child; if(child!=0){self.parent[child-1]=x;}
        self.transplant(x,y); self.left[y-1]=x; self.parent[x-1]=y;
    }
    /** 右旋，维持根和父子连接。 */
    void rotateRight(int64 x) {
        int64 y=self.left[x-1]; int64 child=self.right[y-1];
        self.left[x-1]=child; if(child!=0){self.parent[child-1]=x;}
        self.transplant(x,y); self.right[y-1]=x; self.parent[x-1]=y;
    }
    /** 非递归遍历；mode 为零中序、一先序、二后序。 */
    List<int64> walk(int64 mode) {
        List<int64> result; List<int64> pending; List<int64> phases;
        if(self.root!=0){pending.push(self.root);phases.push(0);}
        while(pending.len()>0){
            int64 node=pending.pop(); int64 phase=phases.pop();
            if(phase==1){result.push(self.keys[node-1]);}
            else {
                int64 left=self.left[node-1];int64 right=self.right[node-1];
                if(mode==1){result.push(self.keys[node-1]);if(right!=0){pending.push(right);phases.push(0);}if(left!=0){pending.push(left);phases.push(0);}}
                elif(mode==0){if(right!=0){pending.push(right);phases.push(0);}pending.push(node);phases.push(1);if(left!=0){pending.push(left);phases.push(0);}}
                else{pending.push(node);phases.push(1);if(right!=0){pending.push(right);phases.push(0);}if(left!=0){pending.push(left);phases.push(0);}}
            }
        }
        return result;
    }
    /** 用显式深度栈计算树高。 */
    int64 height() {
        int64 result=0;List<int64> pending;List<int64> depths;
        if(self.root!=0){pending.push(self.root);depths.push(1);}
        while(pending.len()>0){int64 node=pending.pop();int64 depth=depths.pop();if(depth>result){result=depth;}
            if(self.left[node-1]!=0){pending.push(self.left[node-1]);depths.push(depth+1);}
            if(self.right[node-1]!=0){pending.push(self.right[node-1]);depths.push(depth+1);}}
        return result;
    }
    /** 导出公开的零基槽快照。 */
    TreeSnapshot snapshot() {
        TreeSnapshot result;result.keys=self.keys;result.live=self.live;result.root=self.root-1;result.count=self.count;
        int64 i=0;while(i<self.keys.len()){result.lefts.push(self.left[i]-1);result.rights.push(self.right[i]-1);i=i+1;}return result;
    }
    /** 清空节点及回收表。 */
    void clear(){self.keys.clear();self.left.clear();self.right.clear();self.parent.clear();self.color.clear();self.live.clear();self.free.clear();self.root=0;self.count=0;}
};

/** ChaLi 二叉搜索树；普通赋值独立复制节点存储。 */
struct BinarySearchTree: Copy<BinarySearchTree> {
    __BinaryNodes __nodes;
    /** 创建空树。 */
    static BinarySearchTree create() { }
    /** 取得独立副本。 */
    BinarySearchTree copy(){return self;}
    /** 返回有效节点数。 */
    int64 len(){return self.__nodes.count;}
    /** 清空节点。 */
    void clear(){self.__nodes.clear();}
    /** 插入唯一键，重复时返回 false。 */
    bool insert(int64 key){
        int64 parent=0;int64 node=self.__nodes.root;
        while(node!=0){parent=node;if(key==self.__nodes.keys[node-1]){return false;}if(key<self.__nodes.keys[node-1]){node=self.__nodes.left[node-1];}else{node=self.__nodes.right[node-1];}}
        node=self.__nodes.allocate(key);self.__nodes.parent[node-1]=parent;
        if(parent==0){self.__nodes.root=node;}elif(key<self.__nodes.keys[parent-1]){self.__nodes.left[parent-1]=node;}else{self.__nodes.right[parent-1]=node;}return true;
    }
    /** 摘除键；两个孩子时用中序后继替换。 */
    bool remove(int64 key){
        int64 node=self.__nodes.find(key);if(node==0){return false;}
        if(self.__nodes.left[node-1]!=0 && self.__nodes.right[node-1]!=0){int64 next=self.__nodes.minimum(self.__nodes.right[node-1]);self.__nodes.keys[node-1]=self.__nodes.keys[next-1];node=next;}
        int64 child=self.__nodes.left[node-1];if(child==0){child=self.__nodes.right[node-1];}
        self.__nodes.transplant(node,child);self.__nodes.release(node);return true;
    }
    /** 判断是否存在键。 */
    bool contains(int64 key){return self.__nodes.find(key)!=0;}
    /** 返回最小键，空树返回 None。 */
    Option<int64> min(){if(self.__nodes.root==0){return Option<int64>::None;}return Option<int64>::Value(self.__nodes.keys[self.__nodes.minimum(self.__nodes.root)-1]);}
    /** 返回最大键，空树返回 None。 */
    Option<int64> max(){if(self.__nodes.root==0){return Option<int64>::None;}return Option<int64>::Value(self.__nodes.keys[self.__nodes.maximum(self.__nodes.root)-1]);}
    /** 返回最大路径节点数。 */
    int64 height(){return self.__nodes.height();}
    /** 返回独立中序键列表。 */
    List<int64> inorder(){return self.__nodes.walk(0);}
    /** 返回独立先序键列表。 */
    List<int64> preorder(){return self.__nodes.walk(1);}
    /** 返回独立后序键列表。 */
    List<int64> postorder(){return self.__nodes.walk(2);}
    /** 返回独立节点快照。 */
    TreeSnapshot snapshot(){return self.__nodes.snapshot();}
};

/** ChaLi 红黑树；所有旋转、颜色和双黑修复均在语言内执行。 */
struct RedBlackTree: Copy<RedBlackTree> {
    __BinaryNodes __nodes;
    /** 创建空红黑树。 */
    static RedBlackTree create() { }
    /** 取得独立副本。 */
    RedBlackTree copy(){return self;}
    /** 返回键数量。 */
    int64 len(){return self.__nodes.count;}
    /** 判断键是否存在。 */
    bool contains(int64 key){return self.__nodes.find(key)!=0;}
    /** 清空所有节点。 */
    void clear(){self.__nodes.clear();}
    /** 返回树高。 */
    int64 height(){return self.__nodes.height();}
    /** 返回独立升序键列表。 */
    List<int64> inorder(){return self.__nodes.walk(0);}
    /** 返回最小键，空树返回 None。 */
    Option<int64> min(){if(self.__nodes.root==0){return Option<int64>::None;}return Option<int64>::Value(self.__nodes.keys[self.__nodes.minimum(self.__nodes.root)-1]);}
    /** 返回最大键，空树返回 None。 */
    Option<int64> max(){if(self.__nodes.root==0){return Option<int64>::None;}return Option<int64>::Value(self.__nodes.keys[self.__nodes.maximum(self.__nodes.root)-1]);}
    /** 插入键并修复连续红节点。 */
    bool insert(int64 key){
        int64 parent=0;int64 node=self.__nodes.root;
        while(node!=0){parent=node;if(key==self.__nodes.keys[node-1]){return false;}if(key<self.__nodes.keys[node-1]){node=self.__nodes.left[node-1];}else{node=self.__nodes.right[node-1];}}
        node=self.__nodes.allocate(key);self.__nodes.parent[node-1]=parent;
        if(parent==0){self.__nodes.root=node;}elif(key<self.__nodes.keys[parent-1]){self.__nodes.left[parent-1]=node;}else{self.__nodes.right[parent-1]=node;}
        while(node!=self.__nodes.root && self.__nodes.red(self.__nodes.parent[node-1])){
            parent=self.__nodes.parent[node-1];int64 grand=self.__nodes.parent[parent-1];
            if(parent==self.__nodes.left[grand-1]){
                int64 uncle=self.__nodes.right[grand-1];
                if(self.__nodes.red(uncle)){self.__nodes.paint(parent,false);self.__nodes.paint(uncle,false);self.__nodes.paint(grand,true);node=grand;}
                else{if(node==self.__nodes.right[parent-1]){node=parent;self.__nodes.rotateLeft(node);parent=self.__nodes.parent[node-1];grand=self.__nodes.parent[parent-1];}self.__nodes.paint(parent,false);self.__nodes.paint(grand,true);self.__nodes.rotateRight(grand);}
            }else{
                int64 uncle=self.__nodes.left[grand-1];
                if(self.__nodes.red(uncle)){self.__nodes.paint(parent,false);self.__nodes.paint(uncle,false);self.__nodes.paint(grand,true);node=grand;}
                else{if(node==self.__nodes.left[parent-1]){node=parent;self.__nodes.rotateRight(node);parent=self.__nodes.parent[node-1];grand=self.__nodes.parent[parent-1];}self.__nodes.paint(parent,false);self.__nodes.paint(grand,true);self.__nodes.rotateLeft(grand);}
            }
        }
        self.__nodes.paint(self.__nodes.root,false);return true;
    }
    /** 修复删除黑节点后产生的额外黑色；nil 的父节点显式传入。 */
    void __repair(int64 node,int64 parent){
        while(node!=self.__nodes.root && !self.__nodes.red(node)){
            if(node==self.__nodes.left[parent-1]){
                int64 sibling=self.__nodes.right[parent-1];
                if(self.__nodes.red(sibling)){self.__nodes.paint(sibling,false);self.__nodes.paint(parent,true);self.__nodes.rotateLeft(parent);sibling=self.__nodes.right[parent-1];}
                if(sibling==0){node=parent;parent=self.__nodes.parent[node-1];}
                elif(!self.__nodes.red(self.__nodes.left[sibling-1]) && !self.__nodes.red(self.__nodes.right[sibling-1])){self.__nodes.paint(sibling,true);node=parent;parent=self.__nodes.parent[node-1];}
                else{
                    if(!self.__nodes.red(self.__nodes.right[sibling-1])){self.__nodes.paint(self.__nodes.left[sibling-1],false);self.__nodes.paint(sibling,true);self.__nodes.rotateRight(sibling);sibling=self.__nodes.right[parent-1];}
                    self.__nodes.paint(sibling,self.__nodes.red(parent));self.__nodes.paint(parent,false);self.__nodes.paint(self.__nodes.right[sibling-1],false);self.__nodes.rotateLeft(parent);node=self.__nodes.root;parent=0;
                }
            }else{
                int64 sibling=self.__nodes.left[parent-1];
                if(self.__nodes.red(sibling)){self.__nodes.paint(sibling,false);self.__nodes.paint(parent,true);self.__nodes.rotateRight(parent);sibling=self.__nodes.left[parent-1];}
                if(sibling==0){node=parent;parent=self.__nodes.parent[node-1];}
                elif(!self.__nodes.red(self.__nodes.right[sibling-1]) && !self.__nodes.red(self.__nodes.left[sibling-1])){self.__nodes.paint(sibling,true);node=parent;parent=self.__nodes.parent[node-1];}
                else{
                    if(!self.__nodes.red(self.__nodes.left[sibling-1])){self.__nodes.paint(self.__nodes.right[sibling-1],false);self.__nodes.paint(sibling,true);self.__nodes.rotateLeft(sibling);sibling=self.__nodes.left[parent-1];}
                    self.__nodes.paint(sibling,self.__nodes.red(parent));self.__nodes.paint(parent,false);self.__nodes.paint(self.__nodes.left[sibling-1],false);self.__nodes.rotateRight(parent);node=self.__nodes.root;parent=0;
                }
            }
        }
        self.__nodes.paint(node,false);
    }
    /** 删除键，保留中序后继的颜色并修复黑高。 */
    bool remove(int64 key){
        int64 z=self.__nodes.find(key);if(z==0){return false;}
        int64 y=z;bool red=self.__nodes.red(y);int64 x=0;int64 parent=0;
        if(self.__nodes.left[z-1]==0){x=self.__nodes.right[z-1];parent=self.__nodes.parent[z-1];self.__nodes.transplant(z,x);}
        elif(self.__nodes.right[z-1]==0){x=self.__nodes.left[z-1];parent=self.__nodes.parent[z-1];self.__nodes.transplant(z,x);}
        else{
            y=self.__nodes.minimum(self.__nodes.right[z-1]);red=self.__nodes.red(y);x=self.__nodes.right[y-1];
            if(self.__nodes.parent[y-1]==z){parent=y;if(x!=0){self.__nodes.parent[x-1]=y;}}
            else{parent=self.__nodes.parent[y-1];self.__nodes.transplant(y,x);self.__nodes.right[y-1]=self.__nodes.right[z-1];self.__nodes.parent[self.__nodes.right[y-1]-1]=y;}
            self.__nodes.transplant(z,y);self.__nodes.left[y-1]=self.__nodes.left[z-1];self.__nodes.parent[self.__nodes.left[y-1]-1]=y;self.__nodes.paint(y,self.__nodes.red(z));
        }
        if(!red){self.__repair(x,parent);}self.__nodes.release(z);return true;
    }
    /** 验证连通节点、父指针、严格顺序、根颜色、红孩子及所有 nil 路径黑高。 */
    bool validate(){
        if(self.__nodes.root==0){return self.__nodes.count==0;}
        if(!self.__nodes.valid(self.__nodes.root) || self.__nodes.red(self.__nodes.root) || self.__nodes.parent[self.__nodes.root-1]!=0){return false;}
        Set<int64> seen;List<int64> nodes;List<int64> depths;nodes.push(self.__nodes.root);depths.push(0);int64 blackHeight=0-1;
        while(nodes.len()>0){int64 node=nodes.pop();int64 depth=depths.pop();
            if(node==0){if(blackHeight<0){blackHeight=depth;}elif(depth!=blackHeight){return false;}}
            else{
                if(!self.__nodes.valid(node) || seen.has(node)!=0){return false;}seen.add(node);
                int64 left=self.__nodes.left[node-1];int64 right=self.__nodes.right[node-1];
                if(left!=0 && (!self.__nodes.valid(left) || self.__nodes.parent[left-1]!=node)){return false;}
                if(right!=0 && (!self.__nodes.valid(right) || self.__nodes.parent[right-1]!=node)){return false;}
                if(self.__nodes.red(node)){if(self.__nodes.red(left) || self.__nodes.red(right)){return false;}}else{depth=depth+1;}
                nodes.push(left);depths.push(depth);nodes.push(right);depths.push(depth);
            }
        }
        if(seen.len()!=self.__nodes.count){return false;}
        List<int64> ordered=self.inorder();int64 i=1;while(i<ordered.len()){if(ordered[i-1]>=ordered[i]){return false;}i=i+1;}
        return true;
    }
};

/** ChaLi 最小二叉堆，插入与弹出沿单条路径调整。 */
struct MinHeap: Copy<MinHeap> {
    List<int64> __values;
    /** 创建空堆。 */
    static MinHeap create() { }
    /** 取得独立副本。 */
    MinHeap copy(){return self;}
    /** 返回元素数量。 */
    int64 len(){return self.__values.len();}
    /** 判断是否为空。 */
    bool isEmpty(){return self.__values.len()==0;}
    /** 清空元素。 */
    void clear(){self.__values.clear();}
    /** 插入后向上调整。 */
    void push(int64 value){self.__values.push(value);int64 i=self.__values.len()-1;while(i>0){int64 parent=(i-1)/2;if(self.__values[parent]<=value){break;}self.__values[i]=self.__values[parent];i=parent;}self.__values[i]=value;}
    /** 返回最小值，空堆返回 None。 */
    Option<int64> peek(){if(self.isEmpty()){return Option<int64>::None;}return Option<int64>::Value(self.__values[0]);}
    /** 弹出最小值并向下调整。 */
    Option<int64> pop(){if(self.isEmpty()){return Option<int64>::None;}int64 result=self.__values[0];int64 value=self.__values.pop();int64 size=self.__values.len();if(size>0){int64 i=0;while(i<size/2){int64 child=i*2+1;if(child+1<size && self.__values[child+1]<self.__values[child]){child=child+1;}if(value<=self.__values[child]){break;}self.__values[i]=self.__values[child];i=child;}self.__values[i]=value;}return Option<int64>::Value(result);}
    /** 导出独立堆数组。 */
    List<int64> snapshot(){return self.__values;}
};

/** ChaLi 通用树；节点保存首孩子和次兄弟，遍历不借助宿主树算法。 */
struct GeneralTree: Copy<GeneralTree> {
    __BinaryNodes __nodes;
    /** 创建空树。 */
    static GeneralTree create() { }
    /** 返回独立副本。 */
    GeneralTree copy(){return self;}
    /** 返回有效节点数。 */
    int64 len(){return self.__nodes.count;}
    /** 清空节点。 */
    void clear(){self.__nodes.clear();}
    /** 仅空树能建立根；返回零基节点号，否则返回 -1。 */
    int64 addRoot(int64 value){if(self.__nodes.count!=0){return 0-1;}int64 node=self.__nodes.allocate(value);self.__nodes.root=node;return node-1;}
    /** 向有效父节点的末尾追加孩子。 */
    int64 addChild(int64 cursor,int64 value){
        if(cursor<0 || !self.__nodes.valid(cursor+1)){return 0-1;}
        int64 node=self.__nodes.allocate(value);self.__nodes.parent[node-1]=cursor+1;
        int64 child=self.__nodes.left[cursor];
        if(child==0){self.__nodes.left[cursor]=node;}
        else{while(self.__nodes.right[child-1]!=0){child=self.__nodes.right[child-1];}self.__nodes.right[child-1]=node;}
        return node-1;
    }
    /** 返回有效节点值，无效下标报错。 */
    int64 valueAt(int64 cursor){assert(cursor>=0 && self.__nodes.valid(cursor+1),"GeneralTree 节点无效");return self.__nodes.keys[cursor];}
    /** 返回零基根节点号，空树为 -1。 */
    int64 rootNode(){return self.__nodes.root-1;}
    /** 返回有效节点的独立孩子列表。 */
    List<int64> children(int64 cursor){
        List<int64> result;if(cursor<0 || !self.__nodes.valid(cursor+1)){return result;}
        int64 child=self.__nodes.left[cursor];while(child!=0){result.push(child-1);child=self.__nodes.right[child-1];}return result;
    }
    /** 按先序返回独立节点号列表。 */
    List<int64> preorder(){
        List<int64> result;List<int64> pending;
        if(self.__nodes.root!=0){pending.push(self.__nodes.root);}
        while(pending.len()>0){int64 node=pending.pop();result.push(node-1);List<int64> children=self.children(node-1);int64 i=children.len();while(i>0){i=i-1;pending.push(children[i]+1);}}
        return result;
    }
    /** 按层序返回独立节点号列表。 */
    List<int64> levelOrder(){
        List<int64> result;if(self.__nodes.root==0){return result;}result.push(self.__nodes.root-1);int64 i=0;
        while(i<result.len()){int64 child=self.__nodes.left[result[i]];while(child!=0){result.push(child-1);child=self.__nodes.right[child-1];}i=i+1;}return result;
    }
    /** 返回最大根叶路径节点数。 */
    int64 height(){
        if(self.__nodes.root==0){return 0;}List<int64> nodes;List<int64> depths;nodes.push(self.__nodes.root);depths.push(1);int64 result=0;
        while(nodes.len()>0){int64 node=nodes.pop();int64 depth=depths.pop();if(depth>result){result=depth;}int64 child=self.__nodes.left[node-1];while(child!=0){nodes.push(child);depths.push(depth+1);child=self.__nodes.right[child-1];}}return result;
    }
    /** 独立转换为首孩子作左孩子、次兄弟作右孩子的二叉表示。 */
    BinarySearchTree toBinary(){BinarySearchTree result;result.__nodes=self.__nodes;return result;}
    /** 独立复制二叉表示，保持节点槽号及根。 */
    static GeneralTree fromBinary(BinarySearchTree tree){GeneralTree result;result.__nodes=tree.__nodes;return result;}
    /** 返回独立首孩子、次兄弟快照。 */
    GeneralTreeSnapshot snapshot(){TreeSnapshot nodes=self.__nodes.snapshot();GeneralTreeSnapshot result;result.values=nodes.keys;result.firstChild=nodes.lefts;result.nextSibling=nodes.rights;result.live=nodes.live;result.root=nodes.root;result.count=nodes.count;return result;}
};
