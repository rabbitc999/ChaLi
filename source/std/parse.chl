module std::parse;

/* 从 lang.chl 原样迁出：符号名不变，只换了模块归属（现在必须 `import std::parse;` 才能用）。 */
enum ParseError : Error {
    Empty, Invalid, Overflow;

    /** 返回具体错误原因，并保留载荷中的位置或宿主诊断。 */
    String toString() {
        match (self) {
            ParseError::Empty => { return "输入为空"; }
            ParseError::Invalid => { return "输入格式无效"; }
            ParseError::Overflow => { return "数值超出目标类型范围"; }
        }
    }
};

int64 __parseInt64Error(std::lang::String text);
int64 __parseInt64Value(std::lang::String text);
int64 __parseUInt64Error(std::lang::String text);
uint64 __parseUInt64Value(std::lang::String text);
int64 __parseFloat64Error(std::lang::String text);
float64 __parseFloat64Value(std::lang::String text);
int64 __parseBoolError(std::lang::String text);
bool __parseBoolValue(std::lang::String text);

struct Parse {
    static Result<int64, std::lang::Error> parseInt64(std::lang::String text) {
        int64 error = __parseInt64Error(text);
        if (error == 0) {
            return Result<int64, std::lang::Error>::Ok(__parseInt64Value(text));
        }
        if (error == 1) { return Result<int64, std::lang::Error>::Err(ParseError::Empty); }
        if (error == 2) { return Result<int64, std::lang::Error>::Err(ParseError::Overflow); }
        return Result<int64, std::lang::Error>::Err(ParseError::Invalid);
    }

    static Result<uint64, std::lang::Error> parseUInt64(std::lang::String text) {
        int64 error = __parseUInt64Error(text);
        if (error == 0) {
            return Result<uint64, std::lang::Error>::Ok(__parseUInt64Value(text));
        }
        if (error == 1) { return Result<uint64, std::lang::Error>::Err(ParseError::Empty); }
        if (error == 2) { return Result<uint64, std::lang::Error>::Err(ParseError::Overflow); }
        return Result<uint64, std::lang::Error>::Err(ParseError::Invalid);
    }

    static Result<float64, std::lang::Error> parseFloat64(std::lang::String text) {
        int64 error = __parseFloat64Error(text);
        if (error == 0) {
            return Result<float64, std::lang::Error>::Ok(__parseFloat64Value(text));
        }
        if (error == 1) { return Result<float64, std::lang::Error>::Err(ParseError::Empty); }
        if (error == 2) { return Result<float64, std::lang::Error>::Err(ParseError::Overflow); }
        return Result<float64, std::lang::Error>::Err(ParseError::Invalid);
    }

    static Result<bool, std::lang::Error> parseBool(std::lang::String text) {
        int64 error = __parseBoolError(text);
        if (error == 0) {
            return Result<bool, std::lang::Error>::Ok(__parseBoolValue(text));
        }
        if (error == 1) { return Result<bool, std::lang::Error>::Err(ParseError::Empty); }
        return Result<bool, std::lang::Error>::Err(ParseError::Invalid);
    }
};
