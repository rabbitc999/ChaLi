cmake_minimum_required(VERSION 3.16)
project(chali_compiler LANGUAGES C CXX)
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
find_package(Threads REQUIRED)
include("${CMAKE_CURRENT_SOURCE_DIR}/tools/cmake_dependencies.cmake")
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/runtime/core_sources.txt")
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/runtime/core_sources.txt" STACKVM_CORE_SOURCES)
list(TRANSFORM STACKVM_CORE_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/runtime/")
add_library(chali_vm_core STATIC ${STACKVM_CORE_SOURCES})
file(GLOB CHALI_STANDARD_SOURCES CONFIGURE_DEPENDS glue/std_*.cpp)
list(REMOVE_ITEM CHALI_STANDARD_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/glue/std_demo.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/caspp/core_sources.txt")
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/caspp/core_sources.txt" CHALI_CAS_SOURCES)
list(TRANSFORM CHALI_CAS_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/caspp/")
if(NO_CHALI_STD OR NO_CHALI_STD_CAS OR NO_CHALI_BIG_INT)
    set(CHALI_CAS_SOURCES "")
endif()
add_library(chali_host_records STATIC ${CHALI_STANDARD_SOURCES} ${CHALI_CAS_SOURCES} ipage/sql.cpp ipage/dialect.cpp runtime/bigint.cpp runtime/bigint_multiplication.cpp runtime/bigint_division.cpp runtime/bigint_number_theory.cpp runtime/bigint_bits.cpp runtime/bigint_modular.cpp runtime/bigint_conversion.cpp runtime/bigfloat.cpp runtime/bigfloat_roots.cpp runtime/bigfloat_transcendental.cpp runtime/bigfloat_trigonometry.cpp
    "${CHALI_SQLITE_DIR}/sqlite3.c" json/json.cpp toml/toml.cpp toml/toml_source.cpp)
add_library(chali_runtime STATIC runtime/ast.cpp runtime/ast_type.cpp runtime/ast_node.cpp runtime/ast_data.cpp runtime/aggregate_optimize.cpp runtime/preprocess.cpp lztext/lztext.cpp
    "${CHALI_MINIZ_DIR}/miniz_tinfl.c" dap/dap_server.cpp)
target_link_libraries(chali_runtime PUBLIC chali_vm_core chali_host_records Threads::Threads)
set_source_files_properties("${CHALI_SQLITE_DIR}/sqlite3.c" PROPERTIES
    COMPILE_DEFINITIONS "SQLITE_THREADSAFE=1;SQLITE_OMIT_LOAD_EXTENSION=1")
set_source_files_properties("${CHALI_MINIZ_DIR}/miniz_tinfl.c" PROPERTIES
    COMPILE_DEFINITIONS "MINIZ_NO_ARCHIVE_APIS;MINIZ_NO_DEFLATE_APIS")

# 反射的前端与运行时默认同时编入；单次编译使用 --no-reflection 关闭。
option(CHALI_WITH_REFLECTION "启用注解与反射前端支持" ON)
option(STACKVM_WITH_REFLECTION "启用注解与反射运行时支持" ON)
foreach(target chali_vm_core chali_host_records chali_runtime)
    add_dependencies(${target} chali_dependencies_check)
    target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/runtime
        ${CMAKE_CURRENT_SOURCE_DIR}/json ${CMAKE_CURRENT_SOURCE_DIR}/toml ${CMAKE_CURRENT_SOURCE_DIR}/caspp/include
        "${CHALI_SQLITE_DIR}" "${CHALI_MINIZ_DIR}")
    target_compile_definitions(${target} PUBLIC CHALI_CUSTOM_ALLOCATOR=1
        CHALI_WITH_REFLECTION=$<BOOL:${CHALI_WITH_REFLECTION}>
        STACKVM_WITH_REFLECTION=$<BOOL:${STACKVM_WITH_REFLECTION}>)
endforeach()

# 裁剪定义 PUBLIC 传播到前端和运行时，避免配置不一致。
foreach(feature NO_CHALI_BIG_INT NO_CHALI_BIG_FLOAT NO_CHALI_DEFAULT_POOL NO_CHALI_STD NO_CHALI_STD_CAS NO_CHALI_STD_MATH NO_CHALI_STD_RANDOM NO_CHALI_STD_REGEX NO_CHALI_STD_SIGNAL NO_CHALI_STD_JSON NO_CHALI_STD_TOML NO_CHALI_STD_BINARY NO_CHALI_STD_LINALG NO_CHALI_STD_PARSE NO_CHALI_STD_PROCESS)
    option(${feature} "裁剪 ${feature} 对应功能" OFF)
    if(${feature})
        target_compile_definitions(chali_runtime PUBLIC ${feature})
    endif()
endforeach()

file(GLOB CHALI_MACRO_SOURCES CONFIGURE_DEPENDS macro/*.cpp literals/*.cpp syntax/*.cpp editor/*.cpp)
add_library(chali_parser STATIC chali_parser.cpp chali_resource_cleanup.cpp chali_generic.cpp chali_lambda.cpp
    chali_generic_closure.cpp chali_package.cpp chali_report.cpp chali_aot.cpp chali_aot_llvm.cpp chali_aot_runtime_assets.cpp chali_temp.cpp chali_stdlib_embedded.cpp)
target_sources(chali_parser PRIVATE ${CHALI_MACRO_SOURCES})
target_include_directories(chali_parser PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(chali_parser PUBLIC chali_runtime)

option(CHALI_STATIC_LLVM "静态链接 LLVM 与 LLD 后端" OFF)
if(CHALI_STATIC_LLVM)
    if(NOT WIN32)
        message(FATAL_ERROR "当前静态 LLVM 分发仅验收 Windows x64")
    endif()
    set(CHALI_LLVM_SDK "${CMAKE_CURRENT_SOURCE_DIR}/library/llvm/static-sdk" CACHE PATH "LLVM 静态开发库目录")
    find_program(CHALI_LLVM_CONFIG llvm-config.exe PATHS "${CHALI_LLVM_SDK}/bin" NO_DEFAULT_PATH REQUIRED)
    set(CHALI_LLVM_COMPONENTS core irreader passes x86codegen x86asmparser dtlto libdriver lto option windowsdriver windowsmanifest)
    execute_process(COMMAND "${CHALI_LLVM_CONFIG}" --link-static --libs ${CHALI_LLVM_COMPONENTS}
        OUTPUT_VARIABLE CHALI_LLVM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE CHALI_LLVM_CONFIG_STATUS)
    if(NOT CHALI_LLVM_CONFIG_STATUS EQUAL 0)
        message(FATAL_ERROR "llvm-config 静态库查询失败")
    endif()
    execute_process(COMMAND "${CHALI_LLVM_CONFIG}" --link-static --system-libs ${CHALI_LLVM_COMPONENTS}
        OUTPUT_VARIABLE CHALI_LLVM_SYSTEM_LIBS OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE CHALI_LLVM_CONFIG_STATUS)
    if(NOT CHALI_LLVM_CONFIG_STATUS EQUAL 0)
        message(FATAL_ERROR "llvm-config 系统库查询失败")
    endif()
    separate_arguments(CHALI_LLVM_LIBS NATIVE_COMMAND "${CHALI_LLVM_LIBS}")
    separate_arguments(CHALI_LLVM_SYSTEM_LIBS NATIVE_COMMAND "${CHALI_LLVM_SYSTEM_LIBS}")
    set_source_files_properties(chali_aot_llvm.cpp PROPERTIES COMPILE_DEFINITIONS CHALI_STATIC_LLVM=1
        INCLUDE_DIRECTORIES "${CHALI_LLVM_SDK}/include")
    target_link_directories(chali_parser PUBLIC "${CHALI_LLVM_SDK}/lib")
    target_link_libraries(chali_parser PUBLIC -Wl,--start-group lldMinGW lldCOFF lldCommon
        ${CHALI_LLVM_LIBS} -Wl,--end-group ${CHALI_LLVM_SYSTEM_LIBS})
endif()

add_executable(chali chali_main.cpp)
if(WIN32)
    file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/VERSION" CHALI_PROGRAM_VERSION LIMIT_COUNT 1)
    if(CHALI_STATIC_LLVM)
        set(CHALI_LLVM_VARIANT static)
    else()
        set(CHALI_LLVM_VARIANT external)
    endif()
    set_target_properties(chali PROPERTIES OUTPUT_NAME "chali-${CHALI_PROGRAM_VERSION}-llvm-${CHALI_LLVM_VARIANT}-windows-x64")
endif()
target_link_libraries(chali PRIVATE chali_parser chali_runtime)
configure_file(std/lang.chl ${CMAKE_CURRENT_BINARY_DIR}/std/lang.chl COPYONLY)
if(WIN32)
    target_link_libraries(chali PRIVATE winhttp)
endif()
if(NOT WIN32)
    target_link_libraries(chali PRIVATE m)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries(chali PRIVATE dl)
endif()
if(MSVC)
    target_compile_options(chali_runtime PRIVATE /utf-8)
    target_compile_options(chali_vm_core PRIVATE /utf-8)
    target_compile_options(chali_host_records PRIVATE /utf-8)
    target_compile_options(chali_parser PRIVATE /utf-8 /bigobj)
    target_compile_options(chali PRIVATE /utf-8)
endif()

# MinGW 调试/低优化构建的解析器与驱动可能超过普通 COFF 节数量上限。
if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(chali_vm_core PRIVATE -pthread)
    target_link_options(chali PRIVATE -static -pthread)
    # GCC 11 的 COFF 字符串表在大型 O0 单元中也会溢出；保留 -g，Debug 的两个生成目标使用 O1。
    foreach(target chali_parser chali)
        target_compile_options(${target} PRIVATE -Wa,-mbig-obj $<$<CONFIG:Debug>:-O1>)
    endforeach()
endif()
