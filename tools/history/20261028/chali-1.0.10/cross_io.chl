import std::io;
void main() {
    List<uint8> bytes;
    bytes.push((uint8)0);
    bytes.push((uint8)255);
    bytes.push((uint8)65);
    Result<int64, IoError> written = std::io::writeAllBytes("tmp/cross-bytes.bin", bytes);
    assert(written.expect("write") == 3);
    Result<List<uint8>, IoError> result = std::io::readAllBytes("tmp/cross-bytes.bin");
    List<uint8> loaded = result.expect("read");
    assert(loaded.len() == 3 && loaded[0] == (uint8)0 && loaded[1] == (uint8)255);
    println("cross {} {}", str(3.5), readLine());
    eprintln("stderr ok");
}
