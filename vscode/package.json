{
  "name": "chali-editor",
  "displayName": "ChaLi",
  "description": "ChaLi（.chl）语言支持：用编译器自带的 `chali lsp` 提供诊断、悬停、补全、跳转定义、文档大纲、格式化与宏块折叠。 支持在线模块依赖下载、共享缓存与离线校验。 支持 LLVM AOT 可执行文件构建。",
  "version": "1.0.12",
  "publisher": "rabbitc999",
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "author": {
    "name": "小兔糖糖_OvO",
    "email": "rabbitc999@outlook.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "chali",
    "chl",
    "parseengine",
    "stackvm"
  ],
  "main": "./extension.js",
  "scripts": {
    "test:extension": "node tools/test-extension-host.js",
    "embed": "node tools/embed-compiler.js",
    "check": "node tools/check-manifest.js",
    "test": "node test/smoke.js && node test/dependencies.js && node test/macros.js && node test/lspCancellation.js && node test/semanticProviders.js && node test/editorIntegration.js && node test/macroHighlighting.js && node test/build.js",
    "vscode:prepublish": "node tools/embed-compiler.js",
    "package": "node tools/package.js"
  },
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:chali",
    "onDebugResolve:chali",
    "onCommand:chali.installDependencies",
    "onCommand:chali.checkDependencies",
    "onCommand:chali.openLibraries",
    "onCommand:chali.previewMacroExpansion",
    "onCommand:chali.previewMacroExpansionOnce",
    "onCommand:chali.previewMacroExpansionAtCursor",
    "onCommand:chali.build",
    "onCommand:chali.buildExe",
    "onCommand:chali.configureTarget",
    "onCommand:chali.configureOutput",
    "onCommand:chali.openProjectConfig",
    "onCommand:chali.checkDebugEnvironment"
  ],
  "contributes": {
    "languages": [
      {
        "id": "chali",
        "aliases": [
          "ChaLi",
          "chali"
        ],
        "extensions": [
          ".chl"
        ],
        "configuration": "./chali-language-configuration.json"
      },
      {
        "id": "chali-svmb",
        "aliases": [
          "ChaLi 字节码",
          "ChaLi Bytecode"
        ],
        "extensions": [
          ".svmb"
        ]
      }
    ],
    "grammars": [
      {
        "language": "chali",
        "scopeName": "source.chali",
        "path": "./syntaxes/chali.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "chali",
        "label": "ChaLi",
        "languages": [
          "chali"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的 .chl 文件；与 executable 二选一。",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "传给被调试程序的命令行参数。",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "debuggerPath": {
                "type": "string",
                "description": "GDB 原生调试器路径，缺省从 CHALI_GDB 或 PATH 查找。"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "进入 ChaLi main 时停止。",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "工作目录；默认工程根或入口文件目录。"
              },
              "entry": {
                "type": "string",
                "enum": [
                  "file",
                  "project"
                ],
                "description": "选择当前文件或 chali.toml 的 main。"
              },
              "executable": {
                "type": "string",
                "description": "直接启动已有带符号原生产物，不触发构建。"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "覆盖环境变量，null 删除继承项。"
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal"
                ],
                "default": "internalConsole",
                "description": "集成终端支持标准输入，要求当前 ChaLi --debug 产物。"
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "目标源码绝对路径前缀到本地目录的映射；按最长目录边界匹配，支持断点反向映射。"
              },
              "debugMode": {
                "enum": [
                  "development",
                  "optimized"
                ],
                "description": "源码构建模式：development 使用 O0，optimized 保留 DWARF 并使用 O3／LTO；已有产物以实际调试目录为准。",
                "type": "string",
                "default": "development"
              }
            }
          },
          "attach": {
            "required": [
              "processId",
              "executable"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "description": "已有带符号原生产物；本机附加或核对 Linux 远程目标，不触发构建。"
              },
              "debuggerPath": {
                "type": "string",
                "description": "GDB 原生调试器路径，缺省从 CHALI_GDB 或 PATH 查找。"
              },
              "cwd": {
                "type": "string",
                "description": "工作目录；默认工程根或入口文件目录。"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "覆盖调试器环境；不改变已运行目标的环境。"
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "目标源码绝对路径前缀到本地目录的映射；按最长目录边界匹配，支持断点反向映射。"
              },
              "processId": {
                "type": [
                  "number",
                  "string"
                ],
                "minimum": 1,
                "pattern": "^[1-9][0-9]*$",
                "description": "本机目标 PID，或 Linux gdbserver 实际控制的目标 PID；核对映像身份后才开放查看。"
              },
              "stopOnAttach": {
                "type": "boolean",
                "default": true,
                "description": "附加并完成断点配置后保持全停；false 继续到后续停点。"
              },
              "remote": {
                "description": "连接已有 Linux gdbserver；省略时附加本机进程。",
                "required": [
                  "host",
                  "port"
                ],
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string",
                    "description": "已启动的 Linux gdbserver 的 TCP 主机地址。"
                  },
                  "port": {
                    "maximum": 65535,
                    "description": "gdbserver 的 TCP 监听端口。",
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "chali",
            "request": "launch",
            "name": "ChaLi：调试当前文件",
            "program": "${file}",
            "cwd": "${fileDirname}"
          },
          {
            "type": "chali",
            "request": "launch",
            "name": "ChaLi：调试项目入口",
            "entry": "project",
            "console": "integratedTerminal"
          },
          {
            "type": "chali",
            "request": "attach",
            "name": "ChaLi：附加到本机进程",
            "processId": 12345,
            "executable": "${workspaceFolder}/build/program",
            "windows": {
              "executable": "${workspaceFolder}/build/program.exe"
            }
          }
        ],
        "configurationSnippets": [
          {
            "label": "ChaLi：调试当前文件",
            "description": "使用带源码行和变量信息的 AOT 程序进行原生 GDB 调试。",
            "body": {
              "type": "chali",
              "request": "launch",
              "name": "ChaLi：调试当前文件",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\""
            }
          },
          {
            "label": "ChaLi：附加到本机进程",
            "description": "核对现有进程及符号产物，默认断开后保留目标。",
            "body": {
              "type": "chali",
              "request": "attach",
              "name": "ChaLi：附加到本机进程",
              "processId": 12345,
              "executable": "${workspaceFolder}/build/program",
              "windows": {
                "executable": "${workspaceFolder}/build/program.exe"
              }
            }
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[chali]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.suggest.showWords": false,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "chali.restartServer",
        "title": "%chali.restartServer.title%"
      },
      {
        "command": "chali.showServerLog",
        "title": "%chali.showServerLog.title%"
      },
      {
        "command": "chali.openDoc",
        "title": "%chali.openDoc.title%"
      },
      {
        "command": "chali.run",
        "title": "%chali.run.title%",
        "icon": "$(play)"
      },
      {
        "command": "chali.installDependencies",
        "title": "%chali.installDependencies.title%"
      },
      {
        "command": "chali.checkDependencies",
        "title": "%chali.checkDependencies.title%"
      },
      {
        "command": "chali.openLibraries",
        "title": "%chali.openLibraries.title%"
      },
      {
        "command": "chali.previewMacroExpansion",
        "title": "%chali.previewMacroExpansion.title%"
      },
      {
        "command": "chali.previewMacroExpansionOnce",
        "title": "%chali.previewMacroExpansionOnce.title%"
      },
      {
        "command": "chali.previewMacroExpansionAtCursor",
        "title": "%chali.previewMacroExpansionAtCursor.title%"
      },
      {
        "command": "chali.build",
        "title": "%chali.build.title%",
        "icon": "$(tools)"
      },
      {
        "command": "chali.buildExe",
        "title": "%chali.buildExe.title%"
      },
      {
        "command": "chali.configureTarget",
        "title": "%chali.configureTarget.title%"
      },
      {
        "command": "chali.configureOutput",
        "title": "%chali.configureOutput.title%"
      },
      {
        "command": "chali.openProjectConfig",
        "title": "%chali.openProjectConfig.title%"
      },
      {
        "command": "chali.checkDebugEnvironment",
        "title": "%chali.checkDebugEnvironment.title%"
      }
    ],
    "configuration": {
      "title": "ChaLi",
      "properties": {
        "chali.path": {
          "type": "string",
          "default": "",
          "description": "%chali.path.description%"
        },
        "chali.traceServer": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages"
          ],
          "description": "%chali.traceServer.description%"
        },
        "chali.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%chali.inlayHints.enabled.description%"
        },
        "chali.build.outputDirectory": {
          "type": "string",
          "default": "build",
          "description": "%chali.build.outputDirectory.description%"
        },
        "chali.build.llvmPath": {
          "type": "string",
          "default": "",
          "description": "%chali.build.llvmPath.description%"
        },
        "chali.build.checked": {
          "type": "boolean",
          "default": false,
          "description": "%chali.build.checked.description%"
        },
        "chali.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "GDB 路径；留空时使用 CHALI_GDB 或 PATH。"
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "chali.run",
          "when": "resourceLangId == chali",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "chali.run",
          "when": "resourceLangId == chali",
          "group": "navigation@1"
        },
        {
          "command": "chali.installDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.checkDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.openLibraries",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.previewMacroExpansion",
          "when": "editorLangId == chali && resourceScheme == file",
          "group": "chali@2"
        },
        {
          "command": "chali.buildExe",
          "when": "resourceExtname == .chl && resourceScheme == file",
          "group": "chaliBuild@1"
        }
      ],
      "explorer/context": [
        {
          "command": "chali.installDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.checkDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.openLibraries",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.buildExe",
          "when": "resourceExtname == .chl && resourceScheme == file",
          "group": "chaliBuild@1"
        }
      ],
      "editor/title": [
        {
          "command": "chali.build",
          "when": "resourceLangId == chali && resourceScheme == file",
          "group": "navigation@2"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rabbitc999/ChaLi.git"
  },
  "chaliCompilerVersion": "1.0.12",
  "chaliLLVMVariant": "external"
}
