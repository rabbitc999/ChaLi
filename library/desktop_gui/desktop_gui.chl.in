/** 绘图仅在 beginFrame/endFrame 内执行；颜色为 RRGGBBAA。 */
bool drawPixel(Point point, uint32 color) { return __draw_pixel((float32)point.x, (float32)point.y, color); }
bool drawLine(Point start, Point end, float64 thickness, uint32 color) { return __draw_line((float32)start.x, (float32)start.y, (float32)end.x, (float32)end.y, (float32)thickness, color); }
/** thickness 为零填充矩形；大于零绘制边框，roundness 为 0..1。 */
bool drawRectangle(Rect bounds, uint32 color, float64 thickness = 0, float64 roundness = 0) { return bounds.isValid() && __draw_rectangle(bounds.x, bounds.y, bounds.width, bounds.height, (float32)roundness, (int32)16, (float32)thickness, color); }
bool drawCircle(Point center, float64 radius, uint32 color, float64 thickness = 0) { return __draw_circle((float32)center.x, (float32)center.y, (float32)radius, (float32)thickness, (int32)64, color); }
bool drawEllipse(Point center, Point radius, uint32 color, bool outline = false) { return __draw_ellipse((float32)center.x, (float32)center.y, (float32)radius.x, (float32)radius.y, (int32)outline, color); }
bool drawTriangle(Point a, Point b, Point c, uint32 color, bool outline = false) { return __draw_triangle((float32)a.x, (float32)a.y, (float32)b.x, (float32)b.y, (float32)c.x, (float32)c.y, (int32)outline, color); }
bool drawPolygon(Point center, int64 sides, float64 radius, float64 rotation, uint32 color, float64 thickness = 0) { return sides >= 3 && sides <= 256 && __draw_polygon((float32)center.x, (float32)center.y, (int32)sides, (float32)radius, (float32)rotation, (float32)thickness, color); }
bool drawBezier(Point start, Point first_control, Point second_control, Point end, float64 thickness, uint32 color) { return __draw_bezier((float32)start.x, (float32)start.y, (float32)first_control.x, (float32)first_control.y, (float32)second_control.x, (float32)second_control.y, (float32)end.x, (float32)end.y, (float32)thickness, color); }
/** 以角度制绘制环带；inner_radius 为零时绘制扇形。 */
bool drawRing(Point center, float64 inner_radius, float64 outer_radius, float64 start_angle, float64 end_angle, uint32 color) { return __draw_ring((float32)center.x, (float32)center.y, (float32)inner_radius, (float32)outer_radius, (float32)start_angle, (float32)end_angle, (int32)64, color); }
bool drawText(String text, Point position, float64 size, uint32 color, float64 spacing = 1) { return __draw_text(text, (float32)position.x, (float32)position.y, (float32)size, (float32)spacing, color); }
Point measureText(String text, float64 size, float64 spacing = 1) { return __measure_text(text, (float32)size, (float32)spacing); }

#abi("C", "./@LIBRARY@", "chali_gui_texture_load")
int64 __texture_load(String path);
#abi("C", "./@LIBRARY@", "chali_gui_texture_valid")
bool __texture_valid(int64 id);
#abi("C", "./@LIBRARY@", "chali_gui_texture_close")
void __texture_close(int64 id);
#abi("C", "./@LIBRARY@", "chali_gui_texture_size")
Point __texture_size(int64 id);
#abi("C", "./@LIBRARY@", "chali_gui_texture_draw")
bool __texture_draw(int64 id, float32 sx, float32 sy, float32 sw, float32 sh, float32 x, float32 y, float32 width, float32 height, float32 origin_x, float32 origin_y, float32 rotation, uint32 tint);
/** 窗口拥有 GPU 纹理，别名关闭后共同失效，重开窗口不会复用旧身份。 */
struct Texture {
    int64 __id;

    bool isValid() { return __id != 0 && __texture_valid(self.__id); }
    void close() { if (self.__id != 0) { __texture_close(self.__id); self.__id = 0; } }
    Point size() { return __texture_size(self.__id); }
    bool draw(Rect destination, uint32 tint = (uint32)4294967295) {
        if (!self.isValid() || !destination.isValid()) { return false; }
        let size = self.size();
        return __texture_draw(self.__id, (float32)0, (float32)0, (float32)size.x, (float32)size.y, destination.x, destination.y, destination.width, destination.height, (float32)0, (float32)0, (float32)0, tint);
    }
    bool drawRegion(Rect source, Rect destination, Point origin, float64 rotation, uint32 tint = (uint32)4294967295) {
        return self.isValid() && source.isValid() && destination.isValid() && __texture_draw(self.__id, source.x, source.y, source.width, source.height, destination.x, destination.y, destination.width, destination.height, (float32)origin.x, (float32)origin.y, (float32)rotation, tint);
    }
};
Texture loadTexture(String path) { Texture result; result.__id = __texture_load(path); return result; }

/** 创建带名称与可独立拥有负载的用户事件。 */
Event customEvent(String name, String text = "", int64 code = 0, float64 value = 0) { Event result; result.__kind = 14; result.name = name; result.text = text; result.code = code; result.value = value; return result; }

struct __EventListener { int64 id; String name; void fn(Event) callback; bool once; bool active; };
/** 同一线程中的命名事件总线；支持退订、一次性回调、重入和延迟队列。 */
struct EventBus {
    List<__EventListener> __listeners;
    List<Event> __queue;
    int64 __head;
    int64 __next_id;
    int64 __depth;
    bool __pumping;
    bool __dirty;
    uint64 __generation;
    void __compact() {
        if (self.__depth != 0 || !self.__dirty) { return; }
        List<__EventListener> remaining;
        for (__EventListener listener in self.__listeners) { if (listener.active) { remaining.push(listener); } }
        self.__listeners = remaining; self.__dirty = false;
    }
    int64 __listen(String name, void fn(Event) callback, bool once) {
        self.__compact();
        if (name == "" || self.__next_id == 9223372036854775807 || self.__listeners.len() >= 4096) { return 0; }
        self.__next_id += 1;
        __EventListener listener; listener.id = self.__next_id; listener.name = name; listener.callback = callback; listener.once = once; listener.active = true;
        self.__listeners.push(listener); return listener.id;
    }
    int64 on(String name, void fn(Event) callback) { return self.__listen(name, callback, false); }
    int64 once(String name, void fn(Event) callback) { return self.__listen(name, callback, true); }
    bool off(int64 id) {
        int64 index = 0;
        while (index < self.__listeners.len()) {
            let listener = self.__listeners[index];
            if (listener.id == id && listener.active) { listener.active = false; listener.callback = __ignore_event; self.__listeners[index] = listener; self.__dirty = true; self.__compact(); return true; }
            index += 1;
        }
        return false;
    }
    void clear() {
        int64 index = 0;
        while (index < self.__listeners.len()) { let listener = self.__listeners[index]; listener.active = false; listener.callback = __ignore_event; self.__listeners[index] = listener; index += 1; }
        self.__queue.clear(); self.__head = 0; self.__generation += (uint64)1; self.__dirty = true; self.__compact();
    }
    int64 emit(Event event) {
        if (event.name == "" || !event.isValid() || self.__depth >= 64) { return 0; }
        self.__depth += 1; int64 limit = self.__listeners.len(); int64 index = 0; int64 delivered = 0;
        while (index < limit && index < self.__listeners.len()) {
            let listener = self.__listeners[index];
            if (listener.active && listener.name == event.name) {
                if (listener.once) { let removed = listener; removed.active = false; removed.callback = __ignore_event; self.__listeners[index] = removed; self.__dirty = true; }
                let callback = listener.callback; callback(event); delivered += 1;
            }
            index += 1;
        }
        self.__depth -= 1; self.__compact(); return delivered;
    }
    bool post(Event event) { if (event.name == "" || !event.isValid() || self.pending() >= 4096) { return false; } self.__queue.push(event); return true; }
    int64 pending() { return self.__queue.len() - self.__head; }
    int64 pump(int64 maximum = 256) {
        if (self.__pumping || maximum <= 0) { return 0; }
        self.__pumping = true; uint64 generation = self.__generation;
        int64 count = self.pending(); if (count > maximum) { count = maximum; }
        int64 processed = 0;
        while (processed < count && self.__head < self.__queue.len()) {
            let event = self.__queue[self.__head]; Event empty; self.__queue[self.__head] = empty; self.__head += 1;
            self.emit(event); processed += 1; if (self.__generation != generation) { break; }
        }
        if (self.__head == self.__queue.len()) { self.__queue.clear(); self.__head = 0; }
        if (self.__head >= 1024 && self.__head >= self.pending()) {
            List<Event> remaining; int64 index = self.__head;
            while (index < self.__queue.len()) { remaining.push(self.__queue[index]); index += 1; }
            self.__queue = remaining; self.__head = 0;
        }
        self.__pumping = false; return processed;
    }
};

void __ignore_paint(Rect bounds) {}
/** 自绘控件：绘制使用绝对坐标，输入回调使用控件内坐标；通过 handle 接入窗口事件。 */
struct CustomWidget {
    Widget __state;
    void fn(Rect) __paint;
    void fn(Event) __event;
    bool __has_paint;
    bool __has_event;
    bool __clip;
    bool __has_bounds;
    bool __last_focus;
    Rect __bounds;
    Rect __hit;
    uint64 __frame;
    int64 __capture;
    int64 __depth;
    EventBus __events;

    bool isValid() { return self.__state.isValid(); }
    int64 id() { return self.__state.id(); }
    void onDraw(void fn(Rect) callback) { self.__paint = callback; self.__has_paint = true; }
    void onEvent(void fn(Event) callback) { self.__event = callback; self.__has_event = true; }
    int64 on(String name, void fn(Event) callback) { return self.__events.on(name, callback); }
    int64 once(String name, void fn(Event) callback) { return self.__events.once(name, callback); }
    bool off(int64 id) { return self.__events.off(id); }
    void clearCallbacks() { self.__has_paint = false; self.__has_event = false; self.__paint = __ignore_paint; self.__event = __ignore_event; self.__events.clear(); }
    void close() { self.__state.close(); self.__capture = 0; self.__has_bounds = false; self.clearCallbacks(); }
    bool __dispatch(Event event) {
        if (!self.isValid() || self.__depth >= 64) { return false; }
        self.__depth += 1; event.source = self.id();
        if (self.__has_event) { self.__event(event); }
        if (self.isValid()) { self.__events.emit(event); }
        self.__depth -= 1; return true;
    }
    void __sync_focus() {
        bool next = self.isValid() && self.__state.visible() && self.__state.enabled() && self.__state.editing();
        if (self.isValid() && !next && self.__state.editing()) { self.__state.setEditing(false); }
        if (next != self.__last_focus) {
            self.__last_focus = next; Event event;
            if (next) { event.__kind = 4; event.name = "focus.gained"; } else { event.__kind = 5; event.name = "focus.lost"; self.__capture = 0; }
            self.__dispatch(event);
        }
    }
    bool focus() { if (!self.isValid() || !self.__state.enabled() || !self.__state.visible()) { return false; } self.__state.setEditing(true); self.__sync_focus(); return self.isValid() && self.__state.editing(); }
    void blur() { if (self.isValid()) { self.__state.setEditing(false); } self.__sync_focus(); }
    bool hasFocus() { return self.isValid() && self.__state.editing(); }
    bool setVisible(bool visible) { bool result = self.__state.setVisible(visible); self.__sync_focus(); return result; }
    bool setEnabled(bool enabled) { bool result = self.__state.setEnabled(enabled); self.__sync_focus(); return result; }
    bool visible() { return self.__state.visible(); }
    bool enabled() { return self.__state.enabled(); }
    bool setText(String text) { return self.__state.setText(text); }
    String text() { return self.__state.text(); }
    bool setRange(float64 minimum, float64 maximum) { return self.__state.setRange(minimum, maximum); }
    bool setValue(float64 value) { return self.__state.setValue(value); }
    float64 value() { return self.__state.value(); }
    bool setNumber(int64 value) { return self.__state.setNumber(value); }
    int64 number() { return self.__state.number(); }
    bool setChecked(bool value) { return self.__state.setChecked(value); }
    bool checked() { return self.__state.checked(); }
    Rect bounds() { return self.__bounds; }
    void setClipping(bool enabled) { self.__clip = enabled; }
    bool draw(Rect bounds) {
        if (!frameActive() || !self.isValid() || !bounds.isValid() || !self.__state.visible() || self.__frame == frameCount()) { return false; }
        self.__frame = frameCount(); self.__bounds = bounds; self.__hit = bounds.intersection(clipBounds()); self.__has_bounds = true;
        self.__sync_focus(); if (!self.isValid()) { return false; }
        bool clipped = false; if (self.__clip) { clipped = beginClip(bounds); if (!clipped) { return false; } }
        int64 window = __window_id(); uint64 frame = frameCount();
        if (self.__has_paint) { self.__paint(bounds); }
        if (clipped && window == __window_id() && frame == frameCount()) { endClip(); }
        return true;
    }
    bool handle(Event event) {
        self.__sync_focus();
        if (!self.isValid() || !self.__has_bounds || !self.__state.visible() || !self.__state.enabled()) { self.__capture = 0; return false; }
        int64 kind = event.__kind;
        if (kind >= 6 && kind <= 12 && !inputEnabled()) { self.__capture = 0; return false; }
        bool pointer = kind >= 9 && kind <= 12; bool handled = true;
        bool inside = self.__hit.contains(event.x, event.y);
        if (kind == 9) {
            if (!inside) { self.blur(); return false; }
            self.focus(); if (!self.isValid()) { return true; }
            if (event.code >= 0 && event.code < 8) { self.__capture = self.__capture | (1 << event.code); }
            event.name = "pointer.down";
        } else if (kind == 10) {
            int64 bit = 0; if (event.code >= 0 && event.code < 8) { bit = 1 << event.code; }
            bool captured = (self.__capture & bit) != 0; self.__capture = self.__capture & ~bit;
            if (!inside && !captured) { return false; } event.name = "pointer.up";
        } else if (kind == 11) { if (!inside && self.__capture == 0) { return false; } event.name = "pointer.move";
        } else if (kind == 12) { if (!inside) { return false; } event.name = "pointer.wheel";
        } else if (kind == 6 || kind == 7 || kind == 8) {
            if (!self.hasFocus()) { return false; }
            if (kind == 6) { event.name = "key.down"; } else if (kind == 7) { event.name = "key.up"; } else { event.name = "text.input"; }
        } else if (kind == 5 || kind == 2) {
            self.blur(); if (!self.isValid()) { return false; } self.__capture = 0; handled = false;
            if (kind == 5) { event.name = "window.blur"; } else { event.name = "window.close"; }
        } else if (kind == 3) { event.name = "window.resize"; handled = false;
        } else { return false; }
        if (pointer || kind == 6 || kind == 7 || kind == 8) { event.x -= self.__bounds.x; event.y -= self.__bounds.y; }
        self.__dispatch(event); return handled;
    }
    bool emit(Event event) { if (event.name == "") { return false; } event.__kind = 14; return self.__dispatch(event); }
};
CustomWidget customWidget() { CustomWidget result; result.__state = dummyRec(""); result.__clip = true; return result; }

/** draw 中构建一帧；窗口输入在控件之后派发，不保存临时原生回调。 */
void run(void fn() draw, void fn(Event) onEvent) {
    int64 original = __window_id();
    if (original == 0) { return; }
    while (__window_id() == original) {
        if (shouldClose()) {
            Event event = pollEvent();
            while (event.isValid() && __window_id() == original) { onEvent(event); if (__window_id() != original) { break; } event = pollEvent(); }
            break;
        }
        if (!beginFrame()) { break; }
        draw();
        if (__window_id() != original) { break; }
        Event event = pollEvent();
        while (event.isValid() && __window_id() == original) { onEvent(event); if (__window_id() != original) { break; } event = pollEvent(); }
        if (__window_id() != original) { break; }
        endFrame();
    }
    __close_id(original);
}
void run(void fn() draw) { run(draw, __ignore_event); }
