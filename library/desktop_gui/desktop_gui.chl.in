/** 支持默认整数宽高；options 的 1/2/4 分别为可缩放、隐藏和垂直同步。 */
bool openWindow(int64 width, int64 height, String title, int64 options) {
    if (width <= 0 || width > 2147483647 || height <= 0 || height > 2147483647 || options < 0 || options > 7) { return false; }
    return __open_options((int32)width, (int32)height, title, (int32)options);
}
bool open(int64 width, int64 height, String title) { return openWindow(width, height, title, 0); }
bool setTitle(String text) { return __set_title(text, len(text)); }
bool setTargetFps(int64 fps) { return fps >= 0 && fps <= 1000 && __set_window_value((int32)0, (float64)fps); }
bool setExitKey(int64 key) { return key >= 0 && key < 512 && __set_window_value((int32)1, (float64)key); }
bool setMinSize(int64 width, int64 height) {
    if (width < 1 || width > 2147483647 || height < 1 || height > 2147483647) { return false; }
    return __set_window_value((int32)2, (float64)width) && __set_window_value((int32)3, (float64)height);
}
bool setOpacity(float64 value) { return __set_window_value((int32)4, value); }
int64 width() { return (int64)__window_value((int32)0); }
int64 height() { return (int64)__window_value((int32)1); }
float64 frameTime() { return __window_value((int32)2); }
Point mousePosition() { Point result; result.x = __window_value((int32)3); result.y = __window_value((int32)4); return result; }
Point mouseWheel() { Point result; result.x = __window_value((int32)5); result.y = __window_value((int32)6); return result; }
Point dpiScale() { Point result; result.x = __window_value((int32)7); result.y = __window_value((int32)8); return result; }
bool focused() { return __window_value((int32)9) != 0; }
float64 time() { return __window_value((int32)10); }
bool beginClip(Rect bounds) { return bounds.isValid() && __begin_clip(bounds.x, bounds.y, bounds.width, bounds.height); }
bool enable(bool value) { return __configure((int32)0, (float64)value); }
bool lock(bool value) { return __configure((int32)1, (float64)value); }
bool setAlpha(float64 value) { return __configure((int32)2, value); }
bool setState(int64 value) { return __configure((int32)3, (float64)value); }
bool enableTooltips(bool value) { return __configure((int32)4, (float64)value); }
bool resetStyle() { return __configure((int32)5, 0); }
bool setFontSize(int64 value) { return __configure((int32)6, (float64)value); }
bool setTooltip(String text) { return __tooltip(text, len(text)); }
/** 每个颜色通道为 0..255，返回稳定的 RRGGBBAA。 */
uint32 rgba(int64 red, int64 green, int64 blue, int64 alpha) {
    assert(red >= 0 && red <= 255 && green >= 0 && green <= 255 && blue >= 0 && blue <= 255 && alpha >= 0 && alpha <= 255, "颜色通道必须在 0..255");
    return (uint32)((red << 24) | (green << 16) | (blue << 8) | alpha);
}

/** 把宿主标量事件复制为语言事件。 */
Event pollEvent() {
    let raw = __poll_event(); Event result;
    result.__kind = raw.kind; result.source = raw.source; result.code = raw.code;
    result.x = raw.x; result.y = raw.y; result.delta_x = raw.delta_x; result.delta_y = raw.delta_y;
    if (raw.kind == 8 && raw.code > 0 && raw.code <= 1114111) { result.text = __codepoint_text((int32)raw.code); }
    return result;
}
/** 无捕获的默认处理器，清空回调时立即释放原捕获。 */
void __ignore_event(Event event) {}

/** 控件模型由窗口拥有；语言对象持有回调，原生库只保存数值与文本。 */
struct Widget {
    int64 __id;
    void fn(Event) __event;
    void fn(Event) __click;
    void fn(Event) __change;
    void fn(Event) __submit;
    void fn(Event) __closed;
    bool __has_event;
    bool __has_click;
    bool __has_change;
    bool __has_submit;
    bool __has_closed;

    bool isValid() { return self.__id != 0 && __widget_valid(self.__id); }
    int64 id() { return self.__id; }
    void clearCallbacks() {
        self.__has_event = false; self.__has_click = false; self.__has_change = false; self.__has_submit = false; self.__has_closed = false;
        self.__event = __ignore_event; self.__click = __ignore_event; self.__change = __ignore_event;
        self.__submit = __ignore_event; self.__closed = __ignore_event;
    }
    void close() { if (self.__id != 0) { __widget_close(self.__id); self.__id = 0; } self.clearCallbacks(); }
    void onEvent(void fn(Event) callback) { self.__event = callback; self.__has_event = true; }
    void onClick(void fn(Event) callback) { self.__click = callback; self.__has_click = true; }
    void onChange(void fn(Event) callback) { self.__change = callback; self.__has_change = true; }
    void onSubmit(void fn(Event) callback) { self.__submit = callback; self.__has_submit = true; }
    void onClose(void fn(Event) callback) { self.__closed = callback; self.__has_closed = true; }
    /** 每帧同一模型绘制一次，回调可关闭控件或窗口。 */
    Event draw(Rect bounds) {
        Event event;
        if (!self.isValid() || !bounds.isValid()) { return event; }
        int64 flags = __draw_widget(self.__id, bounds.x, bounds.y, bounds.width, bounds.height);
        if (flags == 0) { return event; }
        int64 original = self.__id;
        event.__kind = 13; event.source = original; event.code = flags; event.x = bounds.x; event.y = bounds.y;
        if (self.__has_event) { self.__event(event); }
        if (self.__id != original || !self.isValid()) { return event; }
        if (event.clicked() && self.__has_click) { self.__click(event); }
        if (self.__id != original || !self.isValid()) { return event; }
        if (event.changed() && self.__has_change) { self.__change(event); }
        if (self.__id != original || !self.isValid()) { return event; }
        if (event.submitted() && self.__has_submit) { self.__submit(event); }
        if (self.__id != original || !self.isValid()) { return event; }
        if (event.closed() && self.__has_closed) { self.__closed(event); }
        return event;
    }
    bool setText(String text) { return __set_text(self.__id, (int32)0, text, len(text)); }
    String text() { if (!self.isValid()) { return ""; } return __get_text(self.__id, (int32)0); }
    bool setLeftText(String text) { return __set_text(self.__id, (int32)1, text, len(text)); }
    bool setRightText(String text) { return __set_text(self.__id, (int32)2, text, len(text)); }
    bool setMessage(String text) { return __set_text(self.__id, (int32)3, text, len(text)); }
    bool setButtons(String text) { return __set_text(self.__id, (int32)4, text, len(text)); }
    /** 分号和换行用于上游的多项文字协议；每项本身不可包含分隔符。 */
    bool setItems(List<String> items) {
        if (items.len() > 128) { return false; }
        String text = ""; bool first = true;
        for (String item in items) {
            if (item.contains(";") || item.contains("\n")) { return false; }
            if (!first) { text += ";"; } text += item; first = false;
        }
        return self.setText(text);
    }
    bool setTextCapacity(int64 capacity) { return capacity >= 2 && capacity <= 1048576 && __set_capacity(self.__id, (int32)capacity); }
    bool setChecked(bool value) { return __set_integer(self.__id, (int32)4, (int64)value); }
    bool checked() { return __get_integer(self.__id, (int32)4) != 0; }
    bool setEditing(bool value) { return __set_integer(self.__id, (int32)5, (int64)value); }
    bool editing() { return __get_integer(self.__id, (int32)5) != 0; }
    bool setSecret(bool value) { return __set_integer(self.__id, (int32)6, (int64)value); }
    bool secret() { return __get_integer(self.__id, (int32)6) != 0; }
    bool setVisible(bool value) { return __set_integer(self.__id, (int32)7, (int64)value); }
    bool visible() { return __get_integer(self.__id, (int32)7) != 0; }
    bool setEnabled(bool value) { return __set_integer(self.__id, (int32)8, (int64)value); }
    bool enabled() { return __get_integer(self.__id, (int32)8) != 0; }
    bool setSelected(int64 value) { return __set_integer(self.__id, (int32)0, value); }
    int64 selected() { return __get_integer(self.__id, (int32)0); }
    bool setNumber(int64 value) { return __set_integer(self.__id, (int32)1, value); }
    int64 number() { return __get_integer(self.__id, (int32)1); }
    int64 result() { return __get_integer(self.__id, (int32)9); }
    bool setScrollIndex(int64 value) { return __set_integer(self.__id, (int32)2, value); }
    int64 scrollIndex() { return __get_integer(self.__id, (int32)2); }
    int64 focusIndex() { return __get_integer(self.__id, (int32)3); }
    bool setRange(float64 minimum, float64 maximum) { return __set_range(self.__id, minimum, maximum); }
    bool setValue(float64 value) { return __set_real(self.__id, (int32)0, value); }
    float64 value() { return __get_real(self.__id, (int32)0); }
    bool setColor(uint32 rgba) { return __set_integer(self.__id, (int32)12, (int64)rgba); }
    uint32 color() { return (uint32)__get_integer(self.__id, (int32)12); }
    bool setHsv(float64 hue, float64 saturation, float64 brightness) {
        if (!(hue >= 0 && hue <= 360 && saturation >= 0 && saturation <= 1 && brightness >= 0 && brightness <= 1)) { return false; }
        return __set_real(self.__id, (int32)13, hue) && __set_real(self.__id, (int32)14, saturation) && __set_real(self.__id, (int32)15, brightness);
    }
    float64 hue() { return __get_real(self.__id, (int32)13); }
    float64 saturation() { return __get_real(self.__id, (int32)14); }
    float64 brightness() { return __get_real(self.__id, (int32)15); }
    bool setSpacing(float64 spacing, int64 subdivisions) {
        return subdivisions >= 1 && subdivisions <= 64 && __set_real(self.__id, (int32)16, spacing) && __set_integer(self.__id, (int32)10, subdivisions);
    }
    bool setContent(Rect bounds) {
        return bounds.isValid() && __set_real(self.__id, (int32)9, bounds.x) && __set_real(self.__id, (int32)10, bounds.y) &&
               __set_real(self.__id, (int32)11, bounds.width) && __set_real(self.__id, (int32)12, bounds.height);
    }
    Rect viewport() { return Rect::at(__get_real(self.__id, (int32)5), __get_real(self.__id, (int32)6), __get_real(self.__id, (int32)7), __get_real(self.__id, (int32)8)); }
    Point scrollOffset() { Point result; result.x = __get_real(self.__id, (int32)3); result.y = __get_real(self.__id, (int32)4); return result; }
    bool setScrollOffset(float64 x, float64 y) {
        if (!(x >= -10000000 && x <= 10000000 && y >= -10000000 && y <= 10000000)) { return false; }
        return __set_real(self.__id, (int32)3, x) && __set_real(self.__id, (int32)4, y);
    }
    bool beginContent() { return std::gui::beginClip(self.viewport()); }
};

/** 创建指定种类；通常使用下方具名工厂，失败可用 isValid 检查。 */
Widget createControl(int64 kind, String text) {
    Widget result;
    if (kind >= 0 && kind < @CONTROL_COUNT@) { result.__id = __widget_create((int32)kind, text, len(text)); }
    return result;
}
int64 controlCount() { return @CONTROL_COUNT@; }
