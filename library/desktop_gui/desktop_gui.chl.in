/** 保留原即时接口，并允许与控件工厂重载。 */
bool open(int32 width, int32 height, String title) { return __open_native(width, height, title); }
void label(int32 x, int32 y, int32 width, int32 height, String text) { __label_native(x, y, width, height, text); }
bool button(int32 x, int32 y, int32 width, int32 height, String text) { return __button_native(x, y, width, height, text); }

/** 窗口及输入事件；控件事件在 draw 中同步派发。 */
enum EventKind {
    None, Opened, Closing, Resized, Focused, Blurred, KeyPressed, KeyReleased,
    TextEntered, MousePressed, MouseReleased, MouseMoved, MouseWheel, Control, Custom;
    $std::macro::Equal<EventKind>(leftEqual);
    $std::macro::Clone<EventKind>(clone);
};
/** C ABI 只传递数值，不跨调用保留借用。 */
struct __RawEvent { int64 kind; int64 source; int64 code; float64 x; float64 y; float64 delta_x; float64 delta_y; };
/** 独立事件快照；控件的 code 为组合标记，窗口事件为键码或按钮号。 */
struct Event {
    int64 __kind;
    int64 source;
    int64 code;
    float64 x;
    float64 y;
    float64 delta_x;
    float64 delta_y;
    String name;
    String text;
    float64 value;

    bool isValid() { return self.__kind != 0; }
    EventKind kind() {
        if (self.__kind == 1) { return EventKind::Opened; }
        if (self.__kind == 2) { return EventKind::Closing; }
        if (self.__kind == 3) { return EventKind::Resized; }
        if (self.__kind == 4) { return EventKind::Focused; }
        if (self.__kind == 5) { return EventKind::Blurred; }
        if (self.__kind == 6) { return EventKind::KeyPressed; }
        if (self.__kind == 7) { return EventKind::KeyReleased; }
        if (self.__kind == 8) { return EventKind::TextEntered; }
        if (self.__kind == 9) { return EventKind::MousePressed; }
        if (self.__kind == 10) { return EventKind::MouseReleased; }
        if (self.__kind == 11) { return EventKind::MouseMoved; }
        if (self.__kind == 12) { return EventKind::MouseWheel; }
        if (self.__kind == 13) { return EventKind::Control; }
        if (self.__kind == 14) { return EventKind::Custom; }
        return EventKind::None;
    }
    bool changed() { return self.__kind == 13 && (self.code & 1) != 0; }
    bool clicked() { return self.__kind == 13 && (self.code & 2) != 0; }
    bool submitted() { return self.__kind == 13 && (self.code & 4) != 0; }
    bool editingChanged() { return self.__kind == 13 && (self.code & 8) != 0; }
    bool closed() { return self.__kind == 2 || (self.__kind == 13 && (self.code & 16) != 0); }
    bool selectionChanged() { return self.__kind == 13 && (self.code & 32) != 0; }
    bool scrolled() { return self.__kind == 13 && (self.code & 64) != 0; }
    bool hovered() { return self.__kind == 13 && (self.code & 128) != 0; }
    bool focusChanged() { return self.__kind == 4 || self.__kind == 5 || (self.__kind == 13 && (self.code & 256) != 0); }
};
/** 以逻辑像素表示的控件边界。 */
struct Rect {
    float32 x;
    float32 y;
    float32 width;
    float32 height;
    static Rect at(float64 x, float64 y, float64 width, float64 height) {
        Rect result; result.x = (float32)x; result.y = (float32)y;
        result.width = (float32)width; result.height = (float32)height; return result;
    }
    bool contains(float64 x, float64 y) { return self.isValid() && x >= self.x && y >= self.y && x < self.x + self.width && y < self.y + self.height; }
    Rect intersection(Rect other) {
        float64 x = self.x; if (other.x > x) { x = other.x; }
        float64 y = self.y; if (other.y > y) { y = other.y; }
        float64 right = self.x + self.width; if (other.x + other.width < right) { right = other.x + other.width; }
        float64 bottom = self.y + self.height; if (other.y + other.height < bottom) { bottom = other.y + other.height; }
        float64 width = right - x; if (width < 0) { width = 0; }
        float64 height = bottom - y; if (height < 0) { height = 0; }
        return Rect::at(x, y, width, height);
    }

    bool isValid() { return self.x >= -10000000 && self.x <= 10000000 && self.y >= -10000000 && self.y <= 10000000 && self.width > 0 && self.width <= 10000000 && self.height > 0 && self.height <= 10000000; }
};
/** 滚动偏移、网格坐标或二维尺寸。 */
struct Point {
    float64 x; float64 y;
    static Point at(float64 x, float64 y) { Point result; result.x = x; result.y = y; return result; }
};

