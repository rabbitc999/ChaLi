module std::crypto;

#abi("C", "./@LIBRARY@", "chali_crypto_random")
String __random_hex(int64 count) ["chali_crypto_free"];
#abi("C", "./@LIBRARY@", "chali_crypto_sha256")
String __sha256(String input, int64 length) ["chali_crypto_free"];
#abi("C", "./@LIBRARY@", "chali_crypto_hmac")
String __hmac(String input, int64 length, String key, int64 key_length) ["chali_crypto_free"];
#abi("C", "./@LIBRARY@", "chali_crypto_verify")
bool __verify(String input, int64 length, String public_key, String signature);

/** 生成 count 个安全随机字节，以小写十六进制返回。 */
Result<String,Error> randomHex(int64 count) {
    String value = __random_hex(count);
    if (len(value) == 0) { return Result<String,Error>::Fail(MessageError::from("invalid count or random backend unavailable")); }
    return Result<String,Error>::Ok(value);
}

/** 计算 UTF-8 String 的 SHA-256，小写十六进制编码。 */
Result<String,Error> sha256(String input) {
    String value = __sha256(input, len(input));
    if (len(value) == 0) { return Result<String,Error>::Fail(MessageError::from("SHA-256 backend unavailable")); }
    return Result<String,Error>::Ok(value);
}

/** 计算 HMAC-SHA-256，结果采用小写十六进制。 */
Result<String,Error> hmacSha256(String input, String key) {
    String value = __hmac(input, len(input), key, len(key));
    if (len(value) == 0) { return Result<String,Error>::Fail(MessageError::from("HMAC-SHA-256 backend unavailable")); }
    return Result<String,Error>::Ok(value);
}

/** 验证十六进制 Ed25519 公钥和分离签名。 */
bool verifyEd25519(String input, String public_key, String signature) {
    if (len(public_key) != 64 || len(signature) != 128) { return false; }
    return __verify(input, len(input), public_key, signature);
}
