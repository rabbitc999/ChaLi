/* store.chl —— MySQL 存取层。
 *
 * 全部 SQL 在这里拼装：列名来自反射元数据（编译期字段名，不是用户输入），
 * 文本值一律经 Database::quote 转义成 MySQL 字面量。std::sql 的参数化执行
 * 目前由 SQLite 后端实现，MySQL 后端按文档口径使用 db.quote 转义。
 */

module store;

import std::sql;
import std::reflect;
import std::json;
import model;

/** 连接配置；默认值对应本机开发库 root/123456@127.0.0.1:3306。 */
struct Config
{
    String host;
    String user;
    String password;
    String database;
    int32 port;
};

/**
 * @brief 生成默认配置。
 */
Config defaultConfig()
{
    Config config;
    config.host = "127.0.0.1";
    config.user = "root";
    config.password = "123456";
    config.database = "students_db";
    config.port = (int32)3306;
    return config;
}

/**
 * @brief 连接 MySQL；库不存在时先建库再连。
 * @param config 连接配置。
 * @retval 连接值；未打开时用 `lastError()` 看诊断（与 `Database::mysql` 同口径，
 *         连接是不可复制值，不走 Result 包装）。
 */
Database connect(Config const& config)
{
    Database database = Database::mysql(config.host, config.user, config.password, config.database, config.port);
    if (database.isOpen()) { return move database; }
    /* 常见原因是库还没建：连一个不带默认库的会话建库，再连一次。 */
    Database bootstrap = Database::mysql(config.host, config.user, config.password, "", config.port);
    if (bootstrap.isOpen())
    {
        ResultSet created = bootstrap.exec("CREATE DATABASE IF NOT EXISTS `" + config.database + "` DEFAULT CHARACTER SET utf8mb4");
        bool created_ok = created.ok;
        bootstrap.close();
        if (created_ok)
        {
            Database retry = Database::mysql(config.host, config.user, config.password, config.database, config.port);
            return move retry;
        }
    }
    return move database;
}

/**
 * @brief 建表（不存在时）；列定义从反射元数据生成。
 */
Result<bool, MessageError> ensureSchema(Database mut& database)
{
    let columns = model::mysqlColumns();
    if (columns.isErr()) { return Result<bool, MessageError>::Err(columns.error()); }
    String sql = "CREATE TABLE IF NOT EXISTS `students` (" + columns.unwrap() + ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4";
    ResultSet result = database.exec(sql);
    if (!result.ok) { return Result<bool, MessageError>::Err(MessageError::from(result.error)); }
    return Result<bool, MessageError>::Ok(true);
}

/**
 * @brief 结果集 → JSON 数组：列名与类型从反射读，读出的记录再过一遍校验。
 * @param rows 任意 SELECT 的结果集。
 * @retval JSON 数组文本；空结果集给 "[]"。
 */
Result<String, MessageError> encodeRows(ResultSet const& rows)
{
    let fields = std::reflect::getStructInfo<Student>().unwrap().fields;
    List<String> records;
    for (int64 row in std::lang::range(0, rows.rowCount()))
    {
        List<String> values;
        for (std::reflect::FieldInfo field in fields)
        {
            int64 column = rows.columnIndex(field.name);
            if (column < 0)
            {
                return Result<String, MessageError>::Err(MessageError::from("数据库缺少字段：" + field.name));
            }
            String value = rows.textAt(row, column);
            if (field.typeId == std::reflect::getTypeId<String>())
            {
                value = std::reflect::__serdeQuote(value);
            }
            values.push(std::reflect::__serdeQuote(field.name) + ":" + value);
        }
        String separator = ",";
        String text = "{" + separator.join(values) + "}";
        let checked = std::json::deserialize<Student>(text);
        if (checked.isErr())
        {
            return Result<String, MessageError>::Err(MessageError::from("数据库记录不符合学生模型：" + checked.error().toString()));
        }
        Student student = checked.unwrap();
        String problem = model::validate(&student);
        if (problem != "")
        {
            return Result<String, MessageError>::Err(MessageError::from(problem));
        }
        String encoded = std::json::serialize<Student>(&student)?;
        records.push(encoded);
    }
    String separator = ",";
    return Result<String, MessageError>::Ok("[" + separator.join(records) + "]");
}

/**
 * @brief 把学生值变成「列名 → SQL 字面量」两份清单（值从序列化 JSON 里取）。
 * @param student 已通过校验的学生值。
 * @retval 两份等长列表；序列化失败时给出诊断。
 */
Result<bool, MessageError> toLiterals(Database mut& database, Student const& student, List<String> mut& columns, List<String> mut& literals)
{
    String encoded = std::json::serialize<Student>(&student)?;
    let parsed = std::json::parse(encoded)?;
    let fields = std::reflect::getStructInfo<Student>().unwrap().fields;
    for (std::reflect::FieldInfo field in fields)
    {
        let node = parsed.find(field.name);
        if (node.isNone())
        {
            return Result<bool, MessageError>::Err(MessageError::from("序列化结果缺少字段：" + field.name));
        }
        JsonValue value = node.unwrap();
        String literal = "";
        if (value.isString())
        {
            let text = value.asString();
            if (text.isNone()) { return Result<bool, MessageError>::Err(MessageError::from("字段不是文本：" + field.name)); }
            literal = database.quote(text.unwrap());
        }
        elif (value.isInt())
        {
            let number = value.asInt();
            if (number.isNone()) { return Result<bool, MessageError>::Err(MessageError::from("字段不是整数：" + field.name)); }
            literal = number.unwrap().toString();
        }
        else
        {
            return Result<bool, MessageError>::Err(MessageError::from("字段类型不支持：" + field.name));
        }
        columns.push("`" + field.name + "`");
        literals.push(literal);
    }
    return Result<bool, MessageError>::Ok(true);
}

/**
 * @brief 下一个可用学号：当前最大学号 + 1。
 */
int64 nextId(Database mut& database)
{
    return database.count("SELECT COALESCE(MAX(`id`), 0) + 1 FROM `students`");
}

/**
 * @brief 新增学生；学号为 0 时自动分配。
 * @retval 入库后的完整 JSON（含最终学号）。
 */
Result<String, MessageError> add(Database mut& database, Student const& student)
{
    Student record = student;
    if (record.id <= 0)
    {
        record.id = nextId(database);
    }
    String problem = model::validate(&record);
    if (problem != "")
    {
        return Result<String, MessageError>::Err(MessageError::from(problem));
    }
    ResultSet exists = database.exec("SELECT `id` FROM `students` WHERE `id` = " + record.id.toString() + " LIMIT 1");
    if (!exists.ok) { return Result<String, MessageError>::Err(MessageError::from(exists.error)); }
    if (!exists.isEmpty()) { return Result<String, MessageError>::Err(MessageError::from("学号已存在：" + record.id.toString())); }
    List<String> columns;
    List<String> literals;
    let packed = toLiterals(&database, &record, &columns, &literals);
    if (packed.isErr()) { return Result<String, MessageError>::Err(packed.error()); }
    String separator = ", ";
    String sql = "INSERT INTO `students` (" + separator.join(columns) + ") VALUES (" + separator.join(literals) + ")";
    ResultSet result = database.exec(sql);
    if (!result.ok) { return Result<String, MessageError>::Err(MessageError::from(result.error)); }
    if (result.affected != 1) { return Result<String, MessageError>::Err(MessageError::from("写入失败：影响 0 行")); }
    return std::json::serialize<Student>(&record);
}

/**
 * @brief 按学号更新；学号以 URL 为准，请求体里的 id 忽略。
 */
Result<String, MessageError> update(Database mut& database, int64 id, Student const& student)
{
    String problem = model::validate(&student);
    if (problem != "")
    {
        return Result<String, MessageError>::Err(MessageError::from(problem));
    }
    if (id <= 0) { return Result<String, MessageError>::Err(MessageError::from("学号必须是正整数")); }
    Student record = student;
    record.id = id;
    List<String> columns;
    List<String> literals;
    let packed = toLiterals(&database, &record, &columns, &literals);
    if (packed.isErr()) { return Result<String, MessageError>::Err(packed.error()); }
    String assignments = "";
    for (int64 index in std::lang::range(0, len(columns)))
    {
        if (!assignments.isEmpty()) { assignments = assignments + ", "; }
        assignments = assignments + columns[index] + " = " + literals[index];
    }
    String sql = "UPDATE `students` SET " + assignments + " WHERE `id` = " + id.toString();
    ResultSet result = database.exec(sql);
    if (!result.ok) { return Result<String, MessageError>::Err(MessageError::from(result.error)); }
    if (result.affected != 1) { return Result<String, MessageError>::Err(MessageError::from("学生不存在")); }
    return std::json::serialize<Student>(&record);
}

/**
 * @brief 按学号删除。
 */
Result<String, MessageError> remove(Database mut& database, int64 id)
{
    if (id <= 0) { return Result<String, MessageError>::Err(MessageError::from("学号必须是正整数")); }
    ResultSet result = database.exec("DELETE FROM `students` WHERE `id` = " + id.toString());
    if (!result.ok) { return Result<String, MessageError>::Err(MessageError::from(result.error)); }
    if (result.affected != 1) { return Result<String, MessageError>::Err(MessageError::from("学生不存在")); }
    return Result<String, MessageError>::Ok("已删除");
}

/**
 * @brief 按学号查一个学生，返回单个 JSON 对象。
 */
Result<String, MessageError> get(Database mut& database, int64 id)
{
    if (id <= 0) { return Result<String, MessageError>::Err(MessageError::from("学号必须是正整数")); }
    ResultSet rows = database.exec("SELECT * FROM `students` WHERE `id` = " + id.toString() + " LIMIT 1");
    if (!rows.ok) { return Result<String, MessageError>::Err(MessageError::from(rows.error)); }
    if (rows.isEmpty()) { return Result<String, MessageError>::Err(MessageError::from("学生不存在")); }
    let encoded = encodeRows(&rows)?;
    return Result<String, MessageError>::Ok(encoded[1:len(encoded) - 1]);
}

/**
 * @brief 列出学生：可选姓名模糊搜索与排序字段。
 * @param keyword 姓名模糊关键字，空串表示不过滤。
 * @param orderField 排序字段，必须是模型字段；空串按学号。
 * @param descending true 为降序。
 */
Result<String, MessageError> list(Database mut& database, String keyword, String orderField, bool descending)
{
    String order = orderField;
    if (order.isEmpty()) { order = "id"; }
    if (!model::isField(order))
    {
        return Result<String, MessageError>::Err(MessageError::from("模型 Student 没有字段 " + order));
    }
    String sql = "SELECT * FROM `students`";
    if (!keyword.isEmpty())
    {
        /* LIKE 通配符先转义，再交给 quote 处理引号与反斜杠。
         * 切片按字节算：按 UTF-8 字符步进，避免切进多字节字符中间。 */
        String escaped = "";
        int64 index = 0;
        while (index < len(keyword))
        {
            int64 lead = (int64)keyword[index];
            int64 step = 1;
            if (lead >= 240) { step = 4; }
            elif (lead >= 224) { step = 3; }
            elif (lead >= 192) { step = 2; }
            String piece = keyword[index:(index + step)];
            if (piece == "\\" || piece == "%" || piece == "_") { escaped = escaped + "\\"; }
            escaped = escaped + piece;
            index = index + step;
        }
        sql = sql + " WHERE `name` LIKE " + database.quote("%" + escaped + "%");
    }
    String direction = " ASC";
    if (descending) { direction = " DESC"; }
    sql = sql + " ORDER BY `" + order + "`" + direction;
    ResultSet rows = database.exec(sql);
    if (!rows.ok) { return Result<String, MessageError>::Err(MessageError::from(rows.error)); }
    return encodeRows(&rows);
}
