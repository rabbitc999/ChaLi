/* model.chl —— 学生模型：一份声明，多处复用。
 *
 * 字段清单由 @Reflect 暴露给反射运行期，@ModelClass / @ModelField 交给 std::sql：
 * 建表列、查询列、JSON 键、排序字段合法性检查全部从这一份声明派生。
 */

module model;

import std::sql;
import std::reflect;
import std::json;

@Reflect
@std::sql::ModelClass("students")
struct Student
{
    @std::sql::ModelField(id: true)
    int64 id;
    String name;
    int64 age;
    String className;
    int64 score;
};

/**
 * @brief 业务校验：学号正整数、姓名班级非空且限长、年龄与成绩在区间内。
 * @param student 待检查的学生值。
 * @retval 通过时返回空字符串；不通过返回可直接展示的诊断。
 * @note 长度按字节计（len 数字节），120 字节约 40 个汉字，与列长度对齐。
 */
String validate(Student const& student)
{
    if (student.id <= 0)
    {
        return "学号必须是正整数";
    }
    if (student.name.trim().isEmpty() || len(student.name) > 120)
    {
        return "姓名必须为 1 到 120 字节的非空文本";
    }
    if (student.className.trim().isEmpty() || len(student.className) > 120)
    {
        return "班级必须为 1 到 120 字节的非空文本";
    }
    if (student.age < 1 || student.age > 150)
    {
        return "年龄必须在 1 到 150 之间";
    }
    if (student.score < 0 || student.score > 100)
    {
        return "成绩必须在 0 到 100 之间";
    }
    return "";
}

/**
 * @brief 反射字段类型 → MySQL 列类型。
 * @param typeId 反射字段类型编号。
 * @param primary 是否主键。
 * @retval MySQL 列定义片段（含反引号列名）；无法识别的类型返回空串。
 * @note 列名来自编译期模型字段名，不是用户输入，拼进 SQL 安全。
 */
String columnDefinition(uint64 typeId, bool primary)
{
    String name = "";
    if (typeId == std::reflect::getTypeId<String>()) { name = "TEXT"; }
    elif (typeId == std::reflect::getTypeId<int64>()) { name = "BIGINT"; }
    else { return ""; }
    return name;
}

/**
 * @brief 从反射元数据生成建表列清单（不含表级选项）。
 * @retval 逗号分隔的 MySQL 列定义；模型缺 @Reflect 或类型不可识别时报错。
 */
Result<String, Error> mysqlColumns()
{
    std::reflect::requireReflection();
    let reflected = std::reflect::getStructInfo<Student>();
    if (reflected.isNone())
    {
        return Result<String, Error>::Err(MessageError::from("Student 模型需要 @Reflect"));
    }
    let info = reflected.unwrap();
    String output = "";
    for (std::reflect::FieldInfo field in info.fields)
    {
        bool primary = false;
        for (std::reflect::Annotation annotation in field.annotations)
        {
            /* 主键由 @ModelField(id: true) 标出；注解参数这里只关心布尔位。 */
            if (annotation.annotationId != 0 && len(annotation.args) == 3)
            {
                let flag = annotation.args.at(2).asBool();
                if (flag.isOk() && flag.unwrap()) { primary = true; }
            }
        }
        if (!output.isEmpty()) { output = output + ", "; }
        output = output + "`" + field.name + "` " + columnDefinition(field.typeId, primary);
        if (primary) { output = output + " PRIMARY KEY"; }
    }
    if (output.isEmpty())
    {
        return Result<String, Error>::Err(MessageError::from("Student 模型没有可映射字段"));
    }
    return Result<String, Error>::Ok(output);
}

/**
 * @brief 模型字段清单（供 /api/schema 与排序字段校验使用）。
 * @retval JSON 数组文本：[{"name":"id","type":"int"},…]。
 */
Result<String, Error> schemaJson()
{
    std::reflect::requireReflection();
    let reflected = std::reflect::getStructInfo<Student>();
    if (reflected.isNone())
    {
        return Result<String, Error>::Err(MessageError::from("Student 模型需要 @Reflect"));
    }
    List<String> items;
    for (std::reflect::FieldInfo field in reflected.unwrap().fields)
    {
        String kind = "int";
        if (field.typeId == std::reflect::getTypeId<String>()) { kind = "text"; }
        items.push("{\"name\":" + std::reflect::__serdeQuote(field.name) + ",\"type\":" + std::reflect::__serdeQuote(kind) + "}");
    }
    String separator = ",";
    return Result<String, Error>::Ok("[" + separator.join(items) + "]");
}

/**
 * @brief 判断给定名字是不是模型字段（排序与查询白名单）。
 * @param name 待检查的字段名。
 */
bool isField(String name)
{
    let reflected = std::reflect::getStructInfo<Student>();
    if (reflected.isNone()) { return false; }
    for (std::reflect::FieldInfo field in reflected.unwrap().fields)
    {
        if (field.name == name) { return true; }
    }
    return false;
}
