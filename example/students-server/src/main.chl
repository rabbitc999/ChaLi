/* main.chl —— 学生信息管理系统入口：连库、建表、起 HTTP 服务。
 *
 * 用法（在本目录运行）：
 *   chali src/main.chl [端口] [前端目录]
 *
 * 默认端口 8787，前端目录 web/。数据库连接参数在本文件下方 ServerConfig 里改。
 */

module studentsServer;

import std::io;
import std::net;
import std::sql;
import std::text;
import api;
import httpd;
import model;
import store;

/** 服务配置：监听地址与前端目录之外，数据库连接参数也在这里改。 */
struct ServerConfig
{
    String host;
    int32 port;
    String webRoot;
    store::Config database;
};

/**
 * @brief 生成默认服务配置：127.0.0.1:8787，前端目录 web/。
 */
ServerConfig defaultServerConfig()
{
    ServerConfig config;
    config.host = "127.0.0.1";
    config.port = (int32)8787;
    config.webRoot = "web";
    config.database = store::defaultConfig();
    return config;
}

/**
 * @brief 读取前端页面文件；找不到时给可读诊断。
 * @param webRoot 前端目录。
 * @param fileName 目录下的文件名。
 */
Result<String, MessageError> readAsset(String webRoot, String fileName)
{
    let opened = std::io::FileStream::open(webRoot + "/" + fileName, "r");
    if (opened.isErr())
    {
        return Result<String, MessageError>::Err(MessageError::from("打不开前端文件 " + webRoot + "/" + fileName
            + "（要在 example/students-server 目录里启动）"));
    }
    std::io::FileStream stream = opened.take();
    let content = stream.readAllString();
    stream.close();
    if (content.isErr())
    {
        return Result<String, MessageError>::Err(MessageError::from("读取前端文件失败：" + webRoot + "/" + fileName));
    }
    return Result<String, MessageError>::Ok(content.unwrap());
}

/**
 * @brief 处理一条已接受的连接：读请求 → 静态页或 REST → 回响应。
 * @param database 数据库连接。
 * @param peer 客户端连接。
 * @param page 启动时读进内存的首页 HTML。
 */
void serve(std::sql::Database mut& database, std::net::TcpSocket mut& peer, String page)
{
    let read = httpd::readRequest(peer, 10000);
    if (read.isErr())
    {
        /* 空连接 / 超时是常态（浏览器预连接），安静地关掉即可。 */
        return;
    }
    httpd::Request request = read.unwrap();
    if ((request.path == "/" || request.path == "/index.html") && request.method == "GET")
    {
        let sent = httpd::sendResponse(peer, 200, "OK", "text/html; charset=utf-8", page);
        if (sent.isErr()) { println("发送首页失败：{}", sent.error().toString()); }
        return;
    }
    api::Reply reply = api::handle(&database, request.method, request.path, request.query, request.body);
    String reason = "OK";
    if (reply.status == 400) { reason = "Bad Request"; }
    elif (reply.status == 404) { reason = "Not Found"; }
    elif (reply.status == 405) { reason = "Method Not Allowed"; }
    elif (reply.status == 500) { reason = "Internal Server Error"; }
    let sent = httpd::sendResponse(peer, reply.status, reason, reply.contentType, reply.body);
    if (sent.isErr()) { println("发送响应失败：{}", sent.error().toString()); }
    println("{} {} -> {}", request.method, request.path, reply.status);
}

/**
 * @brief 入口：解析参数 → 连库建表 → 读首页 → accept 循环。
 * @param args 命令行参数：[端口] [前端目录]（都可省略）。
 */
void main(List<String> args)
{
    ServerConfig config = defaultServerConfig();
    if (len(args) >= 1)
    {
        int32 specified = (int32)api::parseId(args[0]);
        if (specified <= 0)
        {
            println("错误：端口必须是正整数，收到 [{}]", args[0]);
            return;
        }
        config.port = specified;
    }
    if (len(args) >= 2)
    {
        config.webRoot = std::text::Text::trim(args[1]);
    }

    std::sql::Database database = store::connect(&config.database);
    if (!database.isOpen())
    {
        println("错误：连接 MySQL 失败：{}", database.lastError());
        return;
    }
    let schema = store::ensureSchema(&database);
    if (schema.isErr())
    {
        println("错误：建表失败：{}", schema.error().toString());
        database.close();
        return;
    }

    let asset = readAsset(config.webRoot, "index.html");
    if (asset.isErr())
    {
        println("错误：{}", asset.error().toString());
        database.close();
        return;
    }
    String page = asset.unwrap();

    std::net::TcpListener listener = std::net::TcpListener::listen(config.host, config.port, (int32)16);
    if (!listener.isOpen())
    {
        println("错误：监听失败：{}", listener.lastError());
        database.close();
        return;
    }
    println("学生信息管理系统已启动：http://{}:{}", config.host, listener.localPort());
    println("数据库 {}@{}:{}/{}（Ctrl+C 退出）", config.database.database, config.database.host,
            config.database.port, config.database.user);

    while (true)
    {
        std::net::TcpSocket peer = listener.accept((int32)500);
        if (!peer.isOpen())
        {
            /* 超时轮询：回到循环顶上再等，给 Ctrl+C 留出反应机会。 */
            continue;
        }
        serve(&database, &peer, page);
        peer.close();
    }
}
