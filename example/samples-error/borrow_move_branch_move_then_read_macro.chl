int64 closed = 0;
struct Handle : Closeable {
    int64 id;
    void close() { closed = closed * 10 + self.id; }
}
void consume(Handle value) { assert(value.id > 0); }
$macro TAKE(mut &x) -> stmt
consume(move x);
$end_macro
void test(bool flag) { Handle h; h.id = 1; if (flag) { $TAKE(h); } println("{}", h.id); }
void main() { test(true); }
