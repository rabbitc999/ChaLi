import std::iter;
import std::linear_algebra;

void main() {
    List<int64> values;
    values.push(3);
    values.push(7);
    assert(values.indexOf(7) == 1);
    Map<int64, int64> table;
    table.put(4, 9);
    assert(table.keyAt(0) == 4 && table.valAt(0) == 9);
    { let cursor = values.iterMut(); assert(cursor.sizeHint()[0] == 2); }
    let owned = values.intoIter();
    assert(owned.count() == 2);
    List<int64> seed;
    seed.push(1); seed.push(2); seed.push(3);
    let pipeline = std::iter::fromList<int64>(seed).stepBy(2);
    assert(pipeline.count() == 2);
    assert(std::core::add(3, 4) == 7);
    assert(std::core::sub(7, 4) == 3);
    assert(std::core::mul(3, 4) == 12);
    assert(std::core::div(12, 4) == 3);
    assert(std::core::mod(7, 4) == 3);
    assert(std::core::eq(3, 3) && std::core::ne(3, 4));
    assert(std::core::lt(3, 4) && std::core::le(3, 3));
    assert(std::core::gt(4, 3) && std::core::ge(3, 3));
    int64 data[2];
    std::core::index(data, 0) = 11;
    assert(index(data, 0) == 11);
    LuFactorization factorization;
    std::core::pause();
    println("camelCase PascalCase");
}
