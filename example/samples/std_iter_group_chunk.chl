import std::iter;
int64 parity(int64 value) { return value % 2; }
void main() {
    let groups = groupBy(intIter(0,5),parity);
    assert(groups[0][0] == 0 && groups[0][2] == 4 && groups[1].len() == 2);
    let blocks = chunk(intIter(0,5),2);
    let first = blocks.next().unwrap();
    let second = blocks.next().unwrap();
    let last = blocks.next().unwrap();
    assert(first[1] == 1 && second[0] == 2 && last.len() == 1 && last[0] == 4 && blocks.next().isNone());
    let paired = zip(intIter(0,2),intIter(3,4));
    assert(!paired.next().isNone() && paired.next().isNone());
    println("iterator groups, chunks and zip OK");
}
