Result<Result<String, MessageError>, MessageError> gen(int64 gtype)
{
    return match(gtype) {
        1 => { Ok(Ok("type1")) }
        2 => { Ok(Fail(MessageError::from("type2"))) }
        _ => { Fail(MessageError::from("type3")) }
    };
}
Result<String, Error> run(int64 gtype) {
    return Ok((gen(gtype + 1)?)?);
}
void showMode(int64 gtype) {
    match (run(gtype)) {
        Ok(S) => { println("Ok={}", S); }
        MessageError(S) => { println("Fail={}", S); }
        Fail(_) => { println("Error"); }
    }
}
void main() {
    for (int64 i in range(0, 5)) {
        showMode(i);
    }
}
