
void main() {
    RawStorage<int64> source = RawStorage<int64>::allocate(3);
    RawStorage<uint8> destination = RawStorage<uint8>::allocate(24);
    unsafe {
        BarePtr<int64> p = barePointer<int64>(source.pointer(0));
        BarePtr<int64> next = p + 2;
        assert(next - p == 2 && p - next == 0 - 2);
        next = next - 1;
        assert(next.address == p.address + 8);
        next = 2 + p;
        assert(next.address == p.address + 16);
        BarePtr<uint8> bytes = barePointer<uint8>(destination.pointer(0));
        memset<int64>(p, (uint8)42, 24);
        memcpy<uint8,int64>(bytes, p, 24);
        int64 i = 0;
        while (i < 24) {
            uint8 mut& value = dereference<uint8>(bytes + i);
            assert(*value == (uint8)42);
            i = i + 1;
        }
        RawPtr<int64> erased;
        erased.storage = destination.handle;
        erased.index = 0;
        BarePtr<int64> reinterpreted = barePointer<int64>(erased);
        assert(reinterpreted.address == bytes.address);
        memset<int64>(reinterpreted, (uint8)0, 8);
        int64 mut& zero = dereference<int64>(reinterpreted);
        assert(*zero == 0);
        *zero = 123;
        int64 mut& again = dereference<int64>(reinterpreted);
        assert(*again == 123);
        BarePtr<uint8> nullPointer;
        memcpy<uint8,uint8>(nullPointer, nullPointer, 0);
        memset<uint8>(nullPointer, (uint8)0, 0);
        // 字节操作不改写有类型槽位的初始化位图。
        assert(!source.isInitialized(0) && !destination.isInitialized(0));
    }
    source.close();
    destination.close();
    println("raw pointer OK");
}
