struct LoopItem : Drop {
    String text;
    void drop() { assert(self.text != ""); }
};
String loopText() { return "fresh"; }
List<int64> loopList() { List<int64> value; value.push(7); return value; }
LoopItem loopItem() { LoopItem value; value.text="item"; return value; }
String returnLoopText() { return loop { String local="returned"; break local; }; }
int64 main() {
    for (int64 i=0; i<10; i++) {
        String fresh=loop { break loopText(); };
        String local=loop { String text="local"; break text; };
        assert(fresh=="fresh" && local=="local");
        List<int64> values=loop { break loopList(); };
        assert(values.len()==1 && values[0]==7);
        List<int64> copied=loop { List<int64> source; source.push(8); break source; };
        assert(copied[0]==8);
        LoopItem item=loop { LoopItem source; source.text="owned"; break source; };
        assert(item.text=="owned");
        LoopItem made=loop { break loopItem(); };
        assert(made.text=="item");
        auto nested=loop { break loop { String text="nested"; break text; }; };
        assert(nested=="nested");
        auto pair=loop { auto (text, number)=("tuple",7); break text; };
        assert(pair=="tuple");
        String matched=loop {
            Option<String> option=Option<String>::Value("match");
            match(option) { Value(text)=>{break text;} None=>{break "none";} }
        };
        assert(matched=="match");
        loop { break loopText(); };
        loop { break loopList(); };
        loop { break loopItem(); };
    }
    assert(returnLoopText()=="returned");
    auto narrow=loop { int32 local=7; break local; };
    assert(narrow==7);
    String source="unchanged";
    String value=loop { String source="inner"; break source; };
    assert(value=="inner" && source=="unchanged");
    println("loop owned values OK");
    return 0;
}
