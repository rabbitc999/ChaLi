/* fn_trailing_return.chl —— fn 前缀与返回类型后置写法。 */

fn show() {
    println("void entry");
}

fn add(int64 left, int64 right) -> int64 {
    return left + right;
}

fn identity<T>(T value) -> T {
    return value;
}

/* 返回闭包类型的四种写法：返回类型前置、后置嵌套、后置加括号、函数头前置。
 * 后置的 `-> fn(T) -> T` 与 `-> (fn(T) -> T)` 只写在返回类型位置；
 * `fn` 后直接跟 `(` 是 lambda 的前缀。后置写法的形参名只作注解，会被擦掉。 */
fn makeAdder<T>(T base) -> (T fn(T)) {
    return T fn copy (T value) { return base + value; };
}

fn makeAdder2<T>(T base) -> fn(T) -> T {
    return T fn copy (T value) { return base + value; };
}

fn makeAdder3<T>(T base) -> (fn(T v) -> T) {
    return T fn copy (T value) { return base + value; };
}

/* 后置加括号时形参名只作注解（`v` 会被擦掉，不进入类型身份）。 */
(T fn(T)) makeAdder4<T>(T base) {
    return T fn copy (T value) { return base + value; };
}

fn main() {
    show();
    println("add {}", add(3, 4));
    println("identity {}", identity<int64>(9));

    int64 fn(int64) addFive = makeAdder<int64>(5);
    int64 fn(int64) addSix = makeAdder2<int64>(6);
    int64 fn(int64) addSeven = makeAdder3<int64>(7);
    int64 fn(int64) addEight = makeAdder4<int64>(8);
    println("closures {} {} {} {}", addFive(1), addSix(1), addSeven(1), addEight(1));

    /* 具名函数在语句位置就是具名闭包：名字绑到闭包上，默认只读借用外层变量。 */
    int64 base = 100;
    fn localTwice(int64 value) -> int64 {
        return value * 2;
    }
    fn localPlusBase(int64 value) -> int64 {
        return base + value;
    }
    fn localNoReturn() {
        println("local void");
    }
    println("local {}", localTwice(21));
    println("local+base {}", localPlusBase(1));
    base = 200;
    println("local+base after {}", localPlusBase(1));
    localNoReturn();
}
