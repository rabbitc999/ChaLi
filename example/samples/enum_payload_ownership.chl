import enum_wrapping;
int64 closed = 0;
int64 deferred = 0;
struct Handle : Closeable {
    int64 id;
    void close() { closed += 1; }
}
enum Owned { Empty, Resource(Handle value) }
Owned create(int64 id) {
    Handle value;
    value.id = id;
    defer { deferred += 1; }
    return move value;
}
struct Holder { Owned value; }
void replace(Owned mut& target, int64 id) { target = create(id); }
void iteration(int64 id) {
    Owned value = create(id);
    value = create(id + 1);
    replace(&value, id + 2);
    Holder holder;
    holder.value = create(id + 3);
    holder.value = create(id + 4);
    int64 original = id;
    Option<int64 const&> borrowed = reference(&original);
    match(borrowed) { Value(ref) => { assert(ref == id); } None => { assert(false); } }
    Envelope<String> packet = pack("module");
    match(packet) { Item(text) => { assert(text == "module"); } Empty => { assert(false); } }
}
void main() {
    for (int64 i in range(0, 1024)) { iteration(i); }
    assert(closed == 5120 && deferred == 5120);
    println("enum payload ownership: closed=5120 deferred=5120 cross-module generic borrow");
}
