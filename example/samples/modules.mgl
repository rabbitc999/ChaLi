module moduleDemo;
import math::ops;

int64 main() {
    List<int64> values;
    foreach (int64 value in range(1, 5)) {
        values.push(twice(value));
    }
    bool first = true;
    foreach (int64 value in values) {
        if (!first) {
            print(" ");
        }
        print("{}", value);
        first = false;
    }
    println("");
    return 0;
}
