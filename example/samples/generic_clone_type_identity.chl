import std::macro;
int64 customClones = 0;
struct String : Clone<String> {
    int64 code;
    String clone() {
        customClones += 1;
        return self;
    }
}
struct MyBox<T> {
    T value;
    $std::macro::Clone<MyBox<T>>(clone);
}
void main() {
    MyBox<String> custom;
    custom.value.code = 23;
    let customCopy = custom.clone();
    assert(customCopy.value.code == 23 && customClones == 1);
    MyBox<std::core::String> standard;
    standard.value = "kept";
    let standardCopy = standard.clone();
    standard.value = "changed";
    assert(standardCopy.value == "kept" && customClones == 1);
    println("generic clone: nominal String and core String remain distinct");
}
