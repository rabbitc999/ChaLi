import std::macro;
struct Wrap<T> {
    T value;
    $std::macro::Clone<Wrap<T>>(clone);
}
$macro DECLARE<T>(name:ident) -> stmt
T name;
$end_macro
$macro INITIALIZE<T>(name:ident, value:expr) -> stmt
T name = value;
$end_macro
int64 increment(int64 value) { return value + 1; }
void main() {
    $DECLARE<Map<String, List<(int64, String)>>>(mapping);
    List<(int64, String)> entries;
    entries.push(((int64)7, "七"));
    mapping.put("key", entries);
    assert(mapping["key"][0][0] == 7);
    $INITIALIZE<(int64, String)>(pair, ((int64)9, "九"));
    $INITIALIZE<int64 fn(int64)>(callback, increment);
    assert(pair[0] == 9 && pair[1] == "九" && callback(5) == 6);
    Wrap<Wrap<String>> original;
    original.value.value = "nested";
    let copied = original.clone();
    copied.value.value = "changed";
    assert(original.value.value == "nested" && copied.value.value == "changed");
    println("syntax macro types: map,list,tuple,function,nested clone");
}
