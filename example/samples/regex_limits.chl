/* 正则的"限制"已尽量放开：不再有 4096 字节模式串上限、也不再限定 256 条编译上限。
 * 这里验证：超长模式能编、几百条不同模式也能编，而且宿主侧不泄漏（活块数不变）。 */
import std::memory;
import std::regex;

void main() {
    String oversized = "";
    for (int64 i = 0; i < 4097; i = i + 1) {
        oversized = oversized + "a";
    }
    Result<Regex, Error> longRule = Regex::compile(oversized);
    assert(longRule.isOk());
    assert(longRule.unwrap().fullMatch(oversized));

    int64 before = Memory::stats().liveBlocks;
    for (int64 i = 0; i < 300; i = i + 1) {

        Result<Regex, Error> item =
        Regex::compile(format("x{}y", i));
        assert(item.isOk());

    }
    int64 after = Memory::stats().liveBlocks;
    assert(after == before);

    Result<Regex, Error> bad = Regex::compile("[");
    assert(bad.isErr());
    println("regex limits OK");
}
