Result<Result<String, MessageError>, MessageError> gen() {
    return Ok(Fail(MessageError::from("inner")));
}
Result<String, Error> stringify() {
    // String 的隐式文本转换不等于继续传播内层 Fail。
    return Ok(gen()?);
}
void main() {
    let value = stringify();
    assert(value.isOk());
    assert(value.unwrap() == "Fail(inner)");
    println("implicit String conversion: Ok(Fail(inner))");
}
