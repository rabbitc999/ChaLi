Result<Result<String, MessageError>, MessageError> gen() {
    return Ok(Err(MessageError::from("inner")));
}
Result<String, Error> stringify() {
    // String 的隐式文本转换不等于继续传播内层 Err。
    return Ok(gen()?);
}
void main() {
    let value = stringify();
    assert(value.isOk());
    assert(value.unwrap() == "Err(inner)");
    println("implicit String conversion: Ok(Err(inner))");
}
