import std::date_time;
void main() {
    let local = std::date_time::parse_offset("1970-01-01T05:30:00+05:30").unwrap();
    assert(std::date_time::to_unix_seconds(local.utc().unwrap()).unwrap() == 0);
    assert(std::date_time::format_offset(local).unwrap() == "1970-01-01T05:30:00+05:30");
    assert(std::date_time::parse_offset("1970-01-01T00:00:00+14:01").isErr());
    assert(std::date_time::parse_offset("1970-01-01T00:00:00-00:60").isErr());
    println("fixed UTC offset OK");
}
