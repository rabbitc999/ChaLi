/* string_text.chl —— 字符串工具族 `std::text::Text::*`（纯胶水，不动文法）。 */

import std::text;

void main() {
    String csv = "  alpha,beta,,gamma  ";

    /* trim → split → join */
    List<String> parts = Text::split(Text::trim(csv), ",");
    println("段数 {} 首段 {} 末段 {}", parts.len(), parts[0], parts[parts.len() - 1]);
    println("拼回 {}", Text::join(parts, "|"));

    /* find / rfind / contains / startsWith / endsWith / compare / charAt */
    String text = "abcabc";
    println("find {} rfind {} contains {}", Text::find(text, "bc"),
    Text::rfind(text, "bc"), Text::contains(text, "cab"));
    println("starts {} ends {} cmp {}", Text::startsWith(text, "ab"),
    Text::endsWith(text, "bc"), Text::compare("a", "b"));
    println("charAt {}", Text::charAt(text, 1));

    /* upper / lower / replace / repeat / pad */
    println("{} {}", Text::toUpper("MiXeD"), Text::toLower("MiXeD"));
    println("{}", Text::replace(text, "ab", "X"));
    println("{}{}", Text::repeat("=", 3), Text::padStart("7", 3, '0'));
    println("[{}]", Text::padEnd("ab", 5, '.'));
}
