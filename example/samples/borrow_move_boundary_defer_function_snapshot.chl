struct Handle:Closeable {int64 id;void close(){}void takeSelf(){consume(move self);}};void consume(Handle value){}void forward(Handle mut& p){take(p);}void take(Handle mut& p){consume(move p);}void recursive(Handle mut& p,bool flag){if(flag){take(p);}else{recursive(p,true);}}void genericTake<T>(T mut& p){consume(move p);}struct Mover{void take(Handle mut& p){consume(move p);}static void takeStatic(Handle mut& p){consume(move p);}}void main(){Handle h;let f=void fn(){println("{}",h.id);};let registered=void fn copy[f](){f();};defer registered();let g=move f;g();}
