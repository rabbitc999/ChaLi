module borrow_sources::left;
#borrow(#ret,a)
int64 mut& pick(int64 mut& a, int64 mut& b) { return a; }

#borrow(#ret,a)
T mut& pickGeneric<T>(T mut& a, T mut& b, bool first) {
    if (first) { return a; }
    return a;
}

interface Value { int64 number(); }
struct Number : Value {
    int64 value;
    int64 number() { return value; }
}
#borrow(#ret,a)
T mut& constrained<T:Value>(T mut& a, T mut& b) {
    assert(a.number() >= 0);
    return a;
}
