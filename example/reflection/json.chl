import std::reflect;
import std::json;
int64 constructed=0;int64 dropped=0;
@Reflect struct User : Drop {
    String name;int64 id;
    User(String name,int64 id){self.name=name;self.id=id;constructed++;}
    String describe(){return format("{}:{}",self.name,self.id);}
    void rename(String name){self.name=name;}
    void drop(){dropped++;}
};
void main(){
    let document=parse("{\"name\":\"alice\",\"id\":7}").unwrap();
    List<ReflectValue> args;
    args.push(ReflectValue::Text(document.find("name").unwrap().asString().unwrap()));
    args.push(ReflectValue::I32((int32)7));
    assert(construct<User>(args).isErr());assert(constructed==0 && dropped==0);
    args[1]=ReflectValue::I64(document.find("id").unwrap().asInt().unwrap());
    document.close();
    List<ReflectValue> empty;
    {
        let result=construct<User>(args);assert(result.isOk() && constructed==1);
        User user=result.unwrap();
        String before=callMethodConst<User>(&user,"describe",empty).unwrap().asText().unwrap();
        assert(before=="alice:7" && user.name=="alice");
        List<ReflectValue> names;names.push(ReflectValue::Text("bob"));
        assert(callMethod<User>(&user,"rename",names).isOk());
        assert(callMethodConst<User>(&user,"describe",empty).unwrap().asText().unwrap()=="bob:7");
        assert(before=="alice:7" && names[0].asText().unwrap()=="bob" && args[0].asText().unwrap()=="alice");
        int64 savedDrops=dropped;args[1]=ReflectValue::Bool(false);
        assert(construct<User>(args).isErr());assert(constructed==1 && dropped==savedDrops);
        assert(callMethod<User>(&user,"drop",empty).isErr());
    }
    assert(dropped>0);println("reflection json OK");
}
