import std::reflect;
@Reflect interface Reader { int64 read(); int64 bump(int64 by); };
@Reflect struct Counter : Reader {
    int64 value;
    Counter(int64 initial){self.value=initial;}
    int64 read(){return self.value;}
    int64 bump(int64 by){self.value+=by;return self.value;}
    static int64 answer(int64 by){return 40+by;}
};
@Reflect enum Choice { Ready, Value(int64 value);
    int64 read(){int64 result=0;match(self){Ready=>{result=1;}Value(v)=>{result=v;}}return result;}
    static int64 answer(){return 8;}
};
@Reflect int64 plus(int64 x){return x+1;}
@Reflect String echo(String text){return text;}
@Reflect void nothing(){}
@Reflect int64 unsupported(int64 const& x){return x;}
@Reflect int32 overloaded(int32 value){return (int32)(value+1);}
@Reflect int64 overloaded(int64 value){return value+2;}
@Reflect uint64 high(uint64 value){return value;}
@Reflect float32 single(float32 value){return value;}
@Reflect float64 doubleValue(float64 value){return value;}
@Reflect int64 getFuncInfo(String value){assert(value=="alive");return 5;}
@Reflect bool flag(bool value){return value;}
@Reflect char character(char value){return value;}
struct Hidden {int64 read(){return 99;}};
void main(){
    List<ReflectValue> args;List<ReflectValue> empty;
    args.push(ReflectValue::I64(2));
    assert(call("program::plus",args).unwrap().asI64().unwrap()==3);
    assert(call("program::absent",args).isErr());
    assert(call("program::unsupported",args).isErr());
    Counter obj=construct<Counter>(args).unwrap();
    assert(callMethod<Counter>(&obj,"bump",args).unwrap().asI64().unwrap()==4);
    assert(callMethodConst<Counter>(&obj,"read",empty).unwrap().asI64().unwrap()==4);
    assert(callMethodConst<Counter>(&obj,"bump",args).isErr());
    assert(callStatic<Counter>("answer",args).unwrap().asI64().unwrap()==42);
    Counter mut& interfaceObj=new Counter(4);Any boxed;boxed.set(&interfaceObj);Reader mut& reader=boxed.getReference();
    assert(callInterface<Reader>(reader,"bump",args).unwrap().asI64().unwrap()==6);
    assert(callInterfaceConst<Reader>(reader,"read",empty).unwrap().asI64().unwrap()==6);
    assert(callInterfaceConst<Reader>(reader,"bump",args).isErr());
    Choice choice=Choice::Ready;
    assert(callEnumMethod<Choice>(&choice,"read",empty).unwrap().asI64().unwrap()==1);
    choice=Choice::Value(9);
    assert(callEnumMethodConst<Choice>(&choice,"read",empty).unwrap().asI64().unwrap()==9);
    assert(callEnumStatic<Choice>("answer",empty).unwrap().asI64().unwrap()==8);
    assert(call("program::nothing",empty).isOk());
    List<ReflectValue> textArgs;textArgs.push(ReflectValue::Text("alive"));
    assert(call("program::echo",textArgs).unwrap().asText().unwrap()=="alive");
    assert(textArgs[0].asText().unwrap()=="alive");
    assert(call("program::getFuncInfo",textArgs).unwrap().asI64().unwrap()==5);
    args[0]=ReflectValue::I32((int32)2);
    assert(call("program::plus",args).isErr());
    assert(construct<Counter>(args).isErr());
    assert(callMethod<Counter>(&obj,"bump",args).isErr());
    assert(callStatic<Counter>("answer",empty).isErr());
    List<ReflectValue> operand;operand.push(ReflectValue::I64(2));
    operand[0]=ReflectValue::I32((int32)10);
    assert(call("program::overloaded",operand).unwrap().asI32().unwrap()==(int32)11);
    operand[0]=ReflectValue::I64(10);
    assert(call("program::overloaded",operand).unwrap().asI64().unwrap()==12);
    operand[0]=ReflectValue::U64((uint64)0xffffffffffffffff);
    assert(call("program::high",operand).unwrap().asU64().unwrap()==(uint64)0xffffffffffffffff);
    operand[0]=ReflectValue::F32((float32)1.25);
    assert(call("program::single",operand).unwrap().asF32().unwrap()==(float32)1.25);
    operand[0]=ReflectValue::F64(2.5);
    assert(call("program::doubleValue",operand).unwrap().asF64().unwrap()==2.5);
    operand[0]=ReflectValue::Bool(true);
    assert(call("program::flag",operand).unwrap().asBool().unwrap());
    operand[0]=ReflectValue::Char('x');
    assert(call("program::character",operand).unwrap().asChar().unwrap()=='x');
    Hidden hidden;assert(callMethod<Hidden>(&hidden,"read",empty).isErr());
    // 缺失、个数、精确类型和接收者错误须保留可区分的错误码。
    match (call("program::absent",empty).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::NotFound => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    match (call("program::plus",empty).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::ArgumentCount => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    match (call("program::plus",operand).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::TypeMismatch => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    match (callMethodConst<Counter>(&obj,"bump",args).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::TypeMismatch => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    match (call("program::unsupported",args).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::UnsupportedSignature => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    match (callMethod<Hidden>(&hidden,"read",empty).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::NotExposed => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }

    interfaceObj.drop();
    println("reflection calls OK");
}

