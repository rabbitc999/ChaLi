import std::reflect;
@Reflect interface View {
    String name(){return "default";}
    int64 bump(int64 by){return 100+by;}
};
@Reflect struct Actual : View {
    String title;int64 value;
    Actual(String title,int64 value){self.title=title;self.value=value;}
    String name(){return self.title;}
    int64 bump(int64 by){self.value+=by;return self.value;}
};
@Reflect struct DefaultView : View {int64 unused;};
struct Hidden : View {int64 unused;};
@Reflect enum State {Ready, Named(String text);
    String name(){String result="ready";match(self){Named(text)=>{result=text;}Ready=>{}}return result;}
};
void main(){
    List<ReflectValue> empty;List<ReflectValue> args;args.push(ReflectValue::I64(2));
    Actual mut& actual=new Actual("actual",20);Any actualBox;actualBox.set(&actual);View mut& view=actualBox.getReference();
    assert(callInterfaceConst<View>(view,"name",empty).unwrap().asText().unwrap()=="actual");
    assert(callInterfaceConst<View>(view,"bump",args).isErr());
    match (callInterfaceConst<View>(view,"bump",args).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::ReceiverMismatch => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    assert(actual.value==20);
    assert(callInterface<View>(view,"bump",args).unwrap().asI64().unwrap()==22 && actual.value==22);
    DefaultView mut& fallback = new DefaultView;Any defaultBox;defaultBox.set(&fallback);View const& readonly=defaultBox.getReference();
    assert(callInterfaceConst<View>(readonly,"name",empty).unwrap().asText().unwrap()=="default");
    assert(callInterfaceConst<View>(readonly,"bump",args).unwrap().asI64().unwrap()==102);
    Hidden mut& hidden = new Hidden;Any hiddenBox;hiddenBox.set(&hidden);View mut& hiddenView=hiddenBox.getReference();
    match (callInterface<View>(hiddenView,"name",empty).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::NotExposed => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    State state=State::Ready;
    assert(callEnumMethodConst<State>(&state,"name",empty).unwrap().asText().unwrap()=="ready");
    state=State::Named("working");
    String snapshot=callEnumMethod<State>(&state,"name",empty).unwrap().asText().unwrap();
    state=State::Ready;state=State::Named("finished");
    assert(snapshot=="working" && callEnumMethodConst<State>(&state,"name",empty).unwrap().asText().unwrap()=="finished");
    hidden.drop();fallback.drop();actual.drop();
    println("reflection dispatch OK");
}
