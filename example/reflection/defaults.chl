import std::reflect;
@Reflect void close(){}
@Reflect struct Plain {int64 value;String label;};
void main(){
    List<ReflectValue> args;
    assert(call("program::close",args).isOk());
    Plain plain=construct<Plain>(args).unwrap();
    assert(plain.value==0 && plain.label=="");
    let info=getStructInfo<Plain>().unwrap();
    assert(info.methods.len()==2 && info.methods[1].isConstructor && info.methods[1].function.params.len()==0);
    args.push(ReflectValue::I64(1));
    assert(construct<Plain>(args).isErr());
    match (construct<Plain>(args).error())
    {
        ReflectError(reflectionError) => {
            match (reflectionError) { ReflectError::ArgumentCount => {} _ => { assert(false); } }
        }
        _ => { assert(false); }
    }
    println("reflection defaults OK");
}
