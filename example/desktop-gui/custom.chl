import std::gui;

void main() {
    assert(std::gui::open_window(800, 480, "ChaLi drawing and custom events", 1));
    bool custom_font = std::gui::load_font("C:/Windows/Fonts/segoeui.ttf", (int32)24, "");
    if (!custom_font) { std::gui::load_font("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", (int32)24, ""); }
    std::gui::set_background((uint32)0xf2f5faff);
    let reset = std::gui::button("Reset");
    let close = std::gui::button("Close");
    let slider = std::gui::custom_widget();
    std::gui::EventBus events;
    float64 value = 35; bool dragging = false; String status = "Drag the custom slider";
    events.on("value.changed", void fn mut(std::gui::Event event) { status = event.text + ": " + event.value.toString() + "%"; });
    slider.on_draw(void fn(std::gui::Rect bounds) {
        std::gui::draw_rectangle(bounds, (uint32)0xffffffff, 0, 0.12);
        std::gui::draw_text("Custom slider", std::gui::Point::at(bounds.x + 24, bounds.y + 18), 22, (uint32)0x172b4dff);
        float64 width = bounds.width - 48;
        std::gui::draw_rectangle(std::gui::Rect::at(bounds.x + 24, bounds.y + 80, width, 10), (uint32)0xe3eaf5ff, 0, 1);
        if (value > 0) { std::gui::draw_rectangle(std::gui::Rect::at(bounds.x + 24, bounds.y + 80, width * value / 100, 10), (uint32)0x3468d4ff, 0, 1); }
        std::gui::draw_circle(std::gui::Point::at(bounds.x + 24 + width * value / 100, bounds.y + 85), 11, (uint32)0x3468d4ff);
        std::gui::draw_text(value.toString() + "%", std::gui::Point::at(bounds.x + 24, bounds.y + 120), 20, (uint32)0x3468d4ff);
    });
    slider.on("value.changed", void fn mut(std::gui::Event event) { events.post(event); });
    slider.on("pointer.down", void fn mut(std::gui::Event event) {
        if (event.code == 0) {
            dragging = true; value = (event.x - 24) * 100 / 688;
            if (value < 0) { value = 0; } if (value > 100) { value = 100; }
            slider.emit(std::gui::custom_event("value.changed", "Pointer", 0, value));
        }
    });
    slider.on("pointer.move", void fn mut(std::gui::Event event) {
        if (dragging) {
            value = (event.x - 24) * 100 / 688;
            if (value < 0) { value = 0; } if (value > 100) { value = 100; }
            slider.emit(std::gui::custom_event("value.changed", "Drag", 0, value));
        }
    });
    slider.on("pointer.up", void fn mut(std::gui::Event event) { dragging = false; });
    slider.on("focus.lost", void fn mut(std::gui::Event event) { dragging = false; });
    reset.on_click(void fn mut(std::gui::Event event) { value = 35; slider.emit(std::gui::custom_event("value.changed", "Reset", 0, value)); });
    close.on_click(void fn(std::gui::Event event) { std::gui::request_close(); });
    std::gui::run(void fn mut() {
        events.pump();
        std::gui::draw_text("Drawing and custom events", std::gui::Point::at(32, 28), 28, (uint32)0x172b4dff);
        std::gui::draw_text(status, std::gui::Point::at(32, 72), 18, (uint32)0x5b6f8aff);
        slider.draw(std::gui::Rect::at(32, 120, 736, 176));
        reset.draw(std::gui::Rect::at(32, 328, 136, 36));
        close.draw(std::gui::Rect::at(188, 328, 136, 36));
        std::gui::draw_bezier(std::gui::Point::at(420, 360), std::gui::Point::at(480, 310), std::gui::Point::at(580, 410), std::gui::Point::at(660, 340), 3, (uint32)0x3468d4ff);
        std::gui::draw_polygon(std::gui::Point::at(720, 346), 6, 22, 0, (uint32)0x53ad8cff);
        std::gui::draw_text("C drawing API | 34 native controls | Named event callbacks", std::gui::Point::at(32, 420), 16, (uint32)0x5b6f8aff);
    }, void fn mut(std::gui::Event event) { slider.handle(event); });
    slider.close(); reset.close(); close.close(); events.clear();
}
