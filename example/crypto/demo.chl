import std::crypto;
void main() {
    assert(sha256("abc").unwrap() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    assert(hmacSha256("The quick brown fox jumps over the lazy dog","key").unwrap()
        == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8");
    String key = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a";
    String sig = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155"
        + "5fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b";
    assert(verifyEd25519("",key,sig));
    assert(!verifyEd25519("changed",key,sig));
    assert(randomHex(0).isErr());
    assert(len(randomHex(16).unwrap()) == 32);
    println("crypto OK");
}
