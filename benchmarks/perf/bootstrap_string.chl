
/** 实验字节字符串：算法由 ChaLi 实现，原始存储仅负责分配和检查。
 * UTF-8 内容按字节保存；不把字节下标解释为 Unicode 码点。
 * Closeable 资源仅通过 cloneBytes 显式复制，不声明 Copy 接口。
 */
struct BootstrapString: Closeable {
    std::lang::RawStorage<uint8> storage;
    std::lang::BarePtr<uint8> data;
    int64 length;

    int64 byteLength() { return self.length; }
    int64 capacity() { return self.storage.capacity(); }
    void reserve(int64 requested) {
        assert(requested >= 0);
        if (requested <= self.storage.capacity()) { return; }
        std::lang::RawStorage<uint8> fresh = std::lang::RawStorage<uint8>::allocate(requested);
        unsafe {
            if (self.length > 0) {
                std::lang::memcpy<uint8,uint8>(std::lang::barePointer<uint8>(fresh.pointer(0)),
                    self.data, self.length);
            }
        }
        self.storage.close();
        self.storage = move(fresh);
        unsafe { self.data = std::lang::barePointer<uint8>(self.storage.pointer(0)); }
    }
    void pushByte(uint8 value) {
        if (self.length == self.storage.capacity()) {
            int64 next = 16;
            if (self.length > 0) {
                assert(self.length <= 4611686018427387903);
                next = self.length * 2;
            }
            self.reserve(next);
        }
        unsafe {
            std::lang::BarePtr<uint8> pointer = self.data + self.length;
            uint8 mut& target = std::lang::dereference<uint8>(pointer);
            *target = value;
        }
        self.length = self.length + 1;
    }
    uint8 getByte(int64 index) {
        assert(index >= 0 && index < self.length);
        unsafe {
            uint8 mut& value = std::lang::dereference<uint8>(self.data + index);
            return *value;
        }
    }
    Option<uint8> byteAt(int64 index) {
        if (index < 0 || index >= self.length) { return Option<uint8>::None; }
        return Option<uint8>::Value(self.getByte(index));
    }
    void setByte(int64 index, uint8 value) {
        assert(index >= 0 && index < self.length);
        unsafe {
            uint8 mut& target = std::lang::dereference<uint8>(self.data + index);
            *target = value;
        }
    }
    void append(BootstrapString& other) {
        int64 count = other.byteLength();
        assert(count <= 9223372036854775807 - self.length);
        self.reserve(self.length + count);
        if (count > 0) {
            unsafe {
                std::lang::memcpy<uint8,uint8>(self.data + self.length, other.data, count);
            }
        }
        self.length = self.length + count;
    }
    void appendNative(String text) {
        List<uint8> bytes = text.bytes();
        assert(bytes.len() <= 9223372036854775807 - self.length);
        self.reserve(self.length + bytes.len());
        int64 i = 0;
        while (i < bytes.len()) { self.pushByte(bytes[i]); i = i + 1; }
    }
    BootstrapString cloneBytes() {
        BootstrapString result;
        result.reserve(self.length);
        if (self.length > 0) {
            unsafe {
                std::lang::memcpy<uint8,uint8>(result.data, self.data, self.length);
            }
        }
        result.length = self.length;
        return move(result);
    }
    void fill(uint8 value, int64 count) {
        assert(count >= 0);
        self.reserve(count);
        if (count > 0) {
            unsafe { std::lang::memset<uint8>(self.data, value, count); }
        }
        self.length = count;
    }
    int64 indexOf(BootstrapString& needle, int64 start = 0) {
        if (start < 0) { start = 0; }
        if (start > self.length) { return 0 - 1; }
        int64 width = needle.byteLength();
        int64 i = start;
        while (i <= self.length - width) {
            int64 j = 0;
            while (j < width && self.getByte(i + j) == needle.getByte(j)) { j = j + 1; }
            if (j == width) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }
    void clear() {
        self.length = 0;
    }
    void close() { self.clear(); self.storage.close(); self.data.address = 0; }
};
