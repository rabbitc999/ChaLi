struct Inner { int8 tag; float32 weight; };
struct Packet { Inner inner; int32 count; float64 total; };
struct Packed packed { int8 tag; float64 value; int32 count; };
struct PackedOuter packed { int8 lead; Packet normal; Packed packed; };
struct NormalOuter { int8 lead; Packed packed; float64 tail; };
#abi("C", "./native.dll", "packed_layout")
int32 packed_layout();
#abi("C", "./native.dll", "packed_transform")
Packed packed_transform(Packed value);
#abi("C", "./native.dll", "packed_update")
void packed_update(Packed mut& value);
#abi("C", "./native.dll", "packed_snapshot")
Option<Packed const&> packed_snapshot();
#abi("C", "./native.dll", "packed_numbers")
Packed[] packed_numbers(int32 count) [count];
#abi("C", "./native.dll", "packed_fill")
void packed_fill(Packed[] values, int32 count);
#abi("C", "./native.dll", "packed_outer")
PackedOuter packed_outer(PackedOuter value);
#abi("C", "./native.dll", "normal_outer")
NormalOuter normal_outer(NormalOuter value);
#abi("C", "./native.dll", "transform")
Packet transform(Packet value);
#abi("C", "./native.dll", "update")
void update(Packet mut& value);
#abi("C", "./native.dll", "inspect")
int32 inspect(Packet const& value);
#abi("C", "./native.dll", "update")
void updateOptional(Option<Packet mut&> value);
#abi("C", "./native.dll", "inspect")
int32 inspectOptional(Option<Packet const&> value);
#abi("C", "./native.dll", "bump")
void bump(int32 mut& value);
#abi("C", "./native.dll", "alias")
int32 alias(Packet mut& a, Packet const& b);
#abi("C", "./native.dll", "snapshot")
Option<Packet const&> snapshot();
#abi("C", "./native.dll", "nothing")
Option<Packet mut&> nothing();
#abi("C", "./native.dll", "numbers")
int32[] numbers(int32 count) [count];
#abi("C", "./native.dll", "fill")
void fill(int32[] values, int32 count);
#abi("C", "./native.dll", "wipe")
void wipe();
#abi("C", "./native.dll", "echo")
Option<int32 mut&> echo(int32 mut& value);
#abi("C", "./native.dll", "wide")
int64 wide(int64 a, int64 b, int64 c, int64 d, int64 e);
#abi("C", "./native.dll", "arrays_alias")
int32 arrays_alias(int32[] a, int32[] b);
#abi("C", "./native.dll", "get_packets")
Packet[] get_packets(int32 count) [count];
#abi("C", "./native.dll", "fill_packets")
void fill_packets(Packet[] values, int32 count);
void main() {
    Packet p;
    p.inner.tag = (int8)2;
    p.inner.weight = (float32)1.5;
    p.count = (int32)4;
    p.total = 5.0;
    Packet q = transform(p);
    assert(p.count == 4);
    assert(q.inner.tag == 3);
    assert(q.inner.weight == 2.0);
    assert(q.count == 6 && q.total == 8.0);
    update(&q);
    assert(q.count == 16 && q.total == 28.0);
    assert(inspect(&q) == 16);
    bump(&q.count);
    assert(q.count == 17);
    assert(alias(&q, &q) == 1);
    assert(q.count == 18);
    updateOptional(Option<Packet mut&>::None);
    assert(inspectOptional(Option<Packet const&>::None) == -1);
    Option<Packet mut&> optionalPacket = Option<Packet mut&>::Value(&q);
    updateOptional(optionalPacket);
    assert(q.count == 28);
    assert(inspectOptional(Option<Packet const&>::Value((Packet const&)&q)) == 28);
    Option<Packet mut&> missing = nothing();
    assert(missing.isNone());
    Option<Packet const&> snapshotValue = snapshot();
    assert(snapshotValue.isValue());
    Packet const& saved = snapshotValue.unwrap();
    assert(saved.count == 9 && saved.inner.tag == -5);
    int32 values[] = numbers((int32)4);
    assert(len(values) == 4);
    assert(values[0] == 10 && values[3] == 40);
    fill(values, (int32)4);
    assert(values[0] == 12 && values[3] == 42);
    int32 mut& copied = echo(&values[0]).unwrap();
    values[0] = (int32)99;
    assert(copied == 12);
    int32 emptyValues[] = numbers((int32)0);
    assert(len(emptyValues) == 0);
    fill(emptyValues, (int32)0);
    wipe();
    assert(saved.count == 9 && values[3] == 42);
    assert(wide(1, 2, 3, 4, 5) == 15);
    assert(arrays_alias(values, values) == 1);
    Packet records[] = get_packets((int32)2);
    assert(len(records) == 2 && records[1].inner.weight == 4.5);
    fill_packets(records, (int32)2);
    assert(records[0].count == 12 && records[1].count == 15);
    {
        int64 i = 0;
        while (i < 500) {

        Packet next = transform(p);
        update(&next);
        assert(next.count == 16);
    
            i = i + 1;
        }
    }
    assert(packed_layout() == 1);
    Packed compact;
    compact.tag = (int8)-2;
    compact.value = 1.25;
    compact.count = (int32)4;
    Packed changed = packed_transform(compact);
    assert(changed.tag == -1 && changed.value == 1.75 && changed.count == 6);
    packed_update(&changed);
    assert(changed.value == 11.75 && changed.count == 9);
    Packed const& savedCompact = packed_snapshot().unwrap();
    assert(savedCompact.tag == -3 && savedCompact.value == 1.25);
    Packed compactArray[] = packed_numbers((int32)2);
    packed_fill(compactArray, (int32)2);
    assert(compactArray[0].value == 2.25 && compactArray[1].value == 3.5);
    assert(compactArray[0].count == 5 && compactArray[1].count == 10);
    PackedOuter outer;
    outer.lead = (int8)2;
    outer.normal = p;
    outer.packed = compact;
    PackedOuter outerCopy = packed_outer(outer);
    assert(outerCopy.lead == 2 && outerCopy.normal.count == p.count + 5 && outerCopy.packed.value == 3.25);
    NormalOuter normal;
    normal.lead = (int8)3;
    normal.packed = compact;
    normal.tail = 2.0;
    NormalOuter normalCopy = normal_outer(normal);
    assert(normalCopy.lead == 3 && normalCopy.packed.count == 10 && normalCopy.tail == 5.0);
    println("abi-values-ok");

}
